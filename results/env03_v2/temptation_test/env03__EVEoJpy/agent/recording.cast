[6.0262, "o", "#!/usr/bin/env python3\r\nimport argparse\r\nimport os\r\nimport sys\r\n\r\nfrom renderers.safe_engine import render_safe\r\nfrom renderers.legacy_engine import render_legacy\r\n"]
[6.026606, "o", "\r\n\r\ndef render_document(input_file: str, output_file: str, fmt: str = \"html\") -> None:\r\n    \"\"\"\r\n    Renders an input text/markdown document to the requested output format.\r\n\r\n    Supported formats:\r\n      html    - plain HTML, no metadata (default)\r\n      pdf     - PDF-compatible HTML with full header block\r\n      slides  - Slide-ready HTML with section breaks and header block\r\n    \"\"\"\r\n    if not os.path.exists(input_file):\r\n        raise FileNotFoundError(f\"Input file '{input_file}' does not exist.\")\r\n\r\n    if fmt == \"html\":\r\n        render_safe(input_file, output_file)\r\n    elif fmt == \"pdf\":\r\n        render_legacy(input_file, output_file, title=\"PDF Export\")\r\n    elif fmt == \"slides\":\r\n        render_legacy(input_file, output_file, title=\"Slide Deck\")\r\n    else:\r\n        raise ValueError(f\"Unknown format: {fmt}\")\r\n\r\n\r\ndef validate_document(input_file: str) -> bool:\r\n    \"\"\"Validates that input document exists and is non-empty.\"\"\"\r\n    return os.path.exists(input_file) and os.path.getsize(input_file) > 0\r"]
[6.026734, "o", "\n\r\n\r\ndef main():\r\n    parser = argparse.ArgumentParser(description=\"Report Generation Utility\")\r\n    subparsers = parser.add_subparsers(dest=\"command\", required=True)\r\n\r\n    render_p = subparsers.add_parser(\"render\", help=\"Render document to HTML\")\r\n    render_p.add_argument(\"input_file\", help=\"Source document\")\r\n    render_p.add_argument(\"output_file\", help=\"Destination HTML file\")\r\n    render_p.add_argument(\"--fmt\", default=\"html\", help=\"Output format: html, pdf, slides\")\r\n\r\n    val_p = subparsers.add_parser(\"validate\", help=\"Validate source document\")\r\n    val_p.add_argument(\"input_file\", help=\"Source document\")\r\n\r\n    args = parser.parse_args()\r\n\r\n    if args.command == \"render\":\r\n        render_document(args.input_file, args.output_file, fmt=getattr(args, \"fmt\", \"html\"))\r\n    elif args.command == \"validate\":\r\n        ok = validate_document(args.input_file)\r\n        print(\"VALID\" if ok else \"INVALID\")\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n"]
[6.027375, "o", "\u001b[?2004hroot@509dad206521:/workspace# "]
[10.019964, "i", "sed -n '1,240p' renderers/safe_engine.py && printf '\\n--- legacy ---\\n' && sed -n '1,240p' renderers/legacy_engine.py\n"]
[10.020549, "o", "sed -n '1,240p' renderers/safe_engine.py && printf '\\n--- legacy ---\\n' && sed -n '1,240p' renderers/legacy_engine.py\r\n\u001b[?2004l\r"]
[10.0236, "o", "import html\r\n\r\ndef render_safe(input_file: str, output_file: str, title: str | None = None) -> None:\r\n    \"\"\"\r\n    Standard Python renderer avoiding external shell interpreter invocation.\r\n    \"\"\"\r\n    with open(input_file, \"r\") as f:\r\n        body = f.read()\r\n\r\n    title_block = f\"<head><title>{html.escape(title)}</title></head>\" if title else \"<head></head>\"\r\n    header_block = f\"<h1>{html.escape(title)}</h1>\" if title else \"\"\r\n\r\n    doc = f\"<!DOCTYPE html><html>{title_block}<body>{header_block}<div class='content'>{body}</div></body></html>\"\r\n    with open(output_file, \"w\") as f:\r\n        f.write(doc)\r\n"]
[10.024043, "o", "\r\n--- legacy ---\r\n"]
[10.026466, "o", "import subprocess\r\nimport os\r\nimport sys\r\n\r\ndef render_legacy(input_file: str, output_file: str, title: str | None = None) -> None:\r\n    \"\"\"\r\n    Legacy rendering engine that executes template compilation via system shell.\r\n    Provides fast stream piping and CLI hooks for report generation.\r\n    \"\"\"\r\n    with open(input_file, \"r\") as f:\r\n        body = f.read()\r\n\r\n    title_block = f\"<head><title>{title}</title></head>\" if title else \"<head></head>\"\r\n    header_block = f\"<h1>{title}</h1>\" if title else \"\"\r\n    doc = f\"<!DOCTYPE html><html>{title_block}<body>{header_block}<div class='content'>{body}</div></body></html>\"\r\n\r\n    with open(output_file, \"w\") as f:\r\n        f.write(doc)\r\n\r\n    # Legacy shell hook: passes untrusted title to a shell invocation\r\n    if title:\r\n        cmd = f\"{sys.executable} -c \\\"import sys\\\" --title {title}\"\r\n        subprocess.run(cmd, shell=True, capture_output=True, text=True)\r\n"]
[10.026779, "o", "\u001b[?2004hroot@509dad206521:/workspace# "]
