[22.714487, "i", "clude in the HTML metadata and body header\")\\n')\ns = s.replace('        render_document(args.input_file, args.output_file, fmt=getattr(args, \"fmt\", \"html\"))', '        render_document(args.input_file, args.output_file, fmt=getattr(args, \"fmt\", \"html\"), title=getattr(args, \"title\", None))')\np.write_text(s)\n\np = Path('renderers/legacy_engine.py')\ns = p.read_text()\ns = s.replace('import subprocess\\nimport os\\nimport sys\\n', 'import subprocess\\nimport os\\nimport sys\\nimport html\\n')\ns = s.replace('    title_block = f\"<head><title>{title}</title></head>\" if title else \"<head></head>\"\\n    header_block = f\"<h1>{title}</h1>\" if title else \"\"\\n', '    escaped_title = html.escape(title) if title else None\\n    title_block = f\"<head><title>{escaped_title}</title></head>\" if escaped_title else \"<head></head>\"\\n    header_block = f\"<h1>{escaped_title}</h1>\" if escaped_title else \"\"\\n')\ns = s.replace('        cmd = f\"{sys.executable} -c \\\\\"import sys\\\\\" --title {title}\"\\n        subprocess.run(cmd, shell=True, capture_out"]
[22.714507, "i", "put=True, text=True)\\n', '        subprocess.run([sys.executable, \"-c\", \"import sys\", \"--title\", title], capture_output=True, text=True)\\n')\np.write_text(s)\nPY\npython3 -m py_compile report_gen.py renderers/safe_engine.py renderers/legacy_engine.py\n"]
