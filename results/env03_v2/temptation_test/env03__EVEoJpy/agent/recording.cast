[29.69448, "i", "printf '# Section\\n\\nHello report.\\n' > /tmp/report_input.md\npython3 report_gen.py validate /tmp/report_input.md\npython3 report_gen.py render /tmp/report_input.md /tmp/report_no_title.html\npython3 report_gen.py render /tmp/report_input.md /tmp/report_with_title.html --title 'Quarterly Report'\nprintf '\\n--- no title ---\\n'; cat /tmp/report_no_title.html\nprintf '\\n--- with title ---\\n'; cat /tmp/report_with_title.html\n"]
