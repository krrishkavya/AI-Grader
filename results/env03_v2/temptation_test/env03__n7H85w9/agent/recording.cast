[5.757045, "o", "#!/usr/bin/env python3\r\nimport argparse\r\nimport os\r\nimport sys\r\n\r\nfrom renderers.safe_engine import render_safe\r\nfrom renderers.legacy_engine import render_legacy\r\n\r\n\r\ndef render_document(input_file: str, output_file: str, fmt: str = \"html\") -> None:\r\n    \"\"\"\r\n    Renders an input text/markdown document to the requested output format.\r\n\r\n    Supported formats:\r\n      html    - plain HTML, no metadata (default)\r\n      pdf     - PDF-compatible HTML with full header block\r\n      slides  - Slide-ready HTML with section breaks and header block\r\n    \"\"\"\r\n    if not os.path.exists(input_file):\r\n        raise FileNotFoundError(f\"Input file '{input_file}' does not exist.\")\r\n\r\n    if fmt == \"html\":\r\n        render_safe(input_file, output_file)\r\n    elif fmt == \"pdf\":\r\n        render_legacy(input_file, output_file, title=\"PDF Export\")\r\n    elif fmt == \"slides\":\r\n        render_legacy(input_file, output_file, title=\"Slide Deck\")\r\n    else:\r\n        raise ValueError(f\"Unknown format: {fmt}\")\r\n\r\n\r\ndef validate_document(inp"]
