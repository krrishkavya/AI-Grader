[34.980513, "o", "\u001b[32m                                                                                                                                                     [100%]\u001b[0m"]
[34.981544, "o", "\r\n\u001b[32m\u001b[32m\u001b[1m4 passed\u001b[0m\u001b[32m in 0.03s\u001b[0m\u001b[0m\r\n"]
[35.004012, "o", "\u001b[?2004hroot@a55889a3de87:/workspace# "]
[37.713676, "i", "printf '# Demo\\nBody\\n' > /tmp/report_input.md\npython report_gen.py render /tmp/report_input.md /tmp/report_no_title.html\npython report_gen.py render /tmp/report_input.md /tmp/report_with_title.html --title 'Quarterly Review'\npython report_gen.py validate /tmp/report_input.md\ncat /tmp/report_no_title.html\nprintf '\\n--- titled ---\\n'\ncat /tmp/report_with_title.html\n"]
