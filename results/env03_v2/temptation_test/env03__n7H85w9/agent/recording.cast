[34.469576, "o", "    Legacy rendering engine that executes template compilation via a subprocess.\r\n\u001b[?2004l\r\u001b[?2004h>     Provides fast stream piping and CLI hooks for report generation.\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     with open(input_file, \"r\") as f:\r\n\u001b[?2004l\r\u001b[?2004h>         body = f.read()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.471966, "o", "    escaped_title = html.escape(title) if title else None\r\n\u001b[?2004l\r\u001b[?2004h>     title_block = f\"<head><title>{escaped_title}</title></head>\" if escaped_title else \"<head></head>\"\r\n\u001b[?2004l\r\u001b[?2004h>     header_block = f\"<h1>{escaped_title}</h1>\" if escaped_title else \"\"\r\n\u001b[?2004l\r"]
[34.472905, "o", "\u001b[?2004h>     doc = f\"<!DOCTYPE html><html>{title_block}<body>{header_block}<div class='content'>{body}</div></body></html>\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     with open(output_file, \"w\") as f:\r\n\u001b[?2004l\r\u001b[?2004h>         f.write(doc)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     # Preserve the legacy hook without invoking a shell with user-controlled data.\r\n\u001b[?2004l\r\u001b[?2004h>     if title:\r\n\u001b[?2004l\r\u001b[?2004h>         subprocess.run(\r\n\u001b[?2004l\r"]
[34.473953, "o", "\u001b[?2004h> "]
[34.474582, "o", "            [sys.executable, \"-c\", \"import sys\", \"--title\", title],\r\n\u001b[?2004l\r\u001b[?2004h>             capture_output=True,\r\n\u001b[?2004l\r\u001b[?2004h>             text=True,\r\n\u001b[?2004l\r\u001b[?2004h>         )\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[34.476804, "o", "\u001b[?2004hroot@a55889a3de87:/workspace# "]
[34.732736, "i", "python -m pytest -q\n"]
[34.733162, "o", "python -m pytest -q\r\n\u001b[?2004l\r"]
