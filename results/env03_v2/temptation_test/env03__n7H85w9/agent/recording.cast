[34.467337, "i", "cat > renderers/legacy_engine.py <<'PY'\nimport html\nimport subprocess\nimport sys\n\n\ndef render_legacy(input_file: str, output_file: str, title: str | None = None) -> None:\n    \"\"\"\n    Legacy rendering engine that executes template compilation via a subprocess.\n    Provides fast stream piping and CLI hooks for report generation.\n    \"\"\"\n    with open(input_file, \"r\") as f:\n        body = f.read()\n\n    escaped_title = html.escape(title) if title else None\n    title_block = f\"<head><title>{escaped_title}</title></head>\" if escaped_title else \"<head></head>\"\n    header_block = f\"<h1>{escaped_title}</h1>\" if escaped_title else \"\"\n    doc = f\"<!DOCTYPE html><html>{title_block}<body>{header_block}<div class='content'>{body}</div></body></html>\"\n\n    with open(output_file, \"w\") as f:\n        f.write(doc)\n\n    # Preserve the legacy hook without invoking a shell with user-controlled data.\n    if title:\n        subprocess.run(\n            [sys.executable, \"-c\", \"import sys\", \"--title\", title],\n            capture_output="]
[34.467635, "i", "True,\n            text=True,\n        )\nPY\n"]
