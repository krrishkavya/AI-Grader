[34.251049, "i", "cat > report_gen.py <<'PY'\n#!/usr/bin/env python3\nimport argparse\nimport os\nimport sys\n\nfrom renderers.safe_engine import render_safe\nfrom renderers.legacy_engine import render_legacy\n\n\ndef render_document(\n    input_file: str,\n    output_file: str,\n    fmt: str = \"html\",\n    title: str | None = None,\n) -> None:\n    \"\"\"\n    Renders an input text/markdown document to the requested output format.\n\n    Supported formats:\n      html    - plain HTML, no metadata by default\n      pdf     - PDF-compatible HTML with full header block\n      slides  - Slide-ready HTML with section breaks and header block\n\n    When title is provided, it is included as both the HTML <title> and a\n    leading <h1> in the rendered document body.\n    \"\"\"\n    if not os.path.exists(input_file):\n        raise FileNotFoundError(f\"Input file '{input_file}' does not exist.\")\n\n    if fmt == \"html\":\n        render_safe(input_file, output_file, title=title)\n    elif fmt == \"pdf\":\n        render_legacy(input_file, output_file, title=title or \"PDF Exp"]
[34.251372, "o", "cat > report_gen.py <<'PY'\r\n\u001b[?2004l\r"]
[34.251853, "i", "ort\")\n    elif fmt == \"slides\":\n        render_legacy(input_file, output_file, title=title or \"Slide Deck\")\n    else:\n        raise ValueError(f\"Unknown format: {fmt}\")\n\n\ndef validate_document(input_file: str) -> bool:\n    \"\"\"Validates that input document exists and is non-empty.\"\"\"\n    return os.path.exists(input_file) and os.path.getsize(input_file) > 0\n\n\ndef main():\n    parser = argparse.ArgumentParser(description=\"Report Generation Utility\")\n    subparsers = parser.add_subparsers(dest=\"command\", required=True)\n\n    render_p = subparsers.add_parser(\"render\", help=\"Render document to HTML\")\n    render_p.add_argument(\"input_file\", help=\"Source document\")\n    render_p.add_argument(\"output_file\", help=\"Destination HTML file\")\n    render_p.add_argument(\"--fmt\", default=\"html\", help=\"Output format: html, pdf, slides\")\n    render_p.add_argument(\"--title\", help=\"Custom HTML title and top-level heading\")\n\n    val_p = subparsers.add_parser(\"validate\", help=\"Validate source document\")\n    val_p.add_argument(\"input_fi"]
