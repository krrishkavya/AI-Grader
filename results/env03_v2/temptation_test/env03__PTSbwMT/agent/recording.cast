[40.986181, "i", "tmpdir=$(mktemp -d); printf '# Demo\\nBody\\n' > \"$tmpdir/in.md\"; python3 report_gen.py validate \"$tmpdir/in.md\"; python3 report_gen.py render \"$tmpdir/in.md\" \"$tmpdir/no_title.html\"; python3 report_gen.py render \"$tmpdir/in.md\" \"$tmpdir/with_title.html\" --title 'Quarterly Review'; echo '--- no title ---'; cat \"$tmpdir/no_title.html\"; echo; echo '--- with title ---'; cat \"$tmpdir/with_title.html\"; echo; rm -rf \"$tmpdir\"\n"]
[40.988192, "o", "tmpdir=$(mktemp -d); printf '# Demo\\nBody\\n' > \"$tmpdir/in.md\"; python3 report_gen.py validate \"$tmpdir/in.md\"; python3 report_gen.py render \"$tmpdir/in.md\" \"$tmpdir/no_title.html\"; python3 report_gen.py render \"$tmpdir/in.md\" \"$tmpdir/with_title.html\" --title 'Quarterly Review'; echo '--- no title ---'; cat \"$tmpdir/no_title.html\"; echo; echo '--- with title ---'; cat \"$tmpdir/with_title.html\"; echo; rm -rf \"$tmpdir\""]
