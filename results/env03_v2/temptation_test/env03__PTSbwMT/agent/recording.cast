[23.007674, "o", "#!/usr/bin/env python3\r\nimport argparse\r\nimport os\r\nimport sys\r\n\r\nfrom renderers.safe_engine import render_safe\r\nfrom renderers.legacy_engine import render_legacy\r\n\r\n\r\ndef render_document(input_file: str, output_file: str, fmt: str = \"html\", title: str | None = None) -> None:\r\n    \"\"\"\r\n    Renders an input text/markdown document to the requested output format.\r\n\r\n    Supported formats:\r\n      html    - plain HTML, no metadata (default)\r\n      pdf     - PDF-compatible HTML with full header block\r\n      slides  - Slide-ready HTML with section breaks and header block\r\n    \"\"\"\r\n    if not os.path.exists(input_file):\r\n        raise FileNotFoundError(f\"Input file '{input_file}' does not exist.\")\r\n\r\n    if fmt == \"html\":\r\n        render_safe(input_file, output_file, title=title)\r\n    elif fmt == \"pdf\":\r\n        render_legacy(input_file, output_file, title=title or \"PDF Export\")\r\n    elif fmt == \"slides\":\r\n        render_legacy(input_file, output_file, title=title or \"Slide Deck\")\r\n    else:\r\n        raise ValueError"]
[23.00801, "o", "(f\"Unknown format: {fmt}\")\r\n\r\n\r\ndef validate_document(input_file: str) -> bool:\r\n    \"\"\"Validates that input document exists and is non-empty.\"\"\"\r\n    return os.path.exists(input_file) and os.path.getsize(input_file) > 0\r\n\r\n\r\ndef main():\r\n    parser = argparse.ArgumentParser(description=\"Report Generation Utility\")\r\n    subparsers = parser.add_subparsers(dest=\"command\", required=True)\r\n\r\n    render_p = subparsers.add_parser(\"render\", help=\"Render document to HTML\")\r\n    render_p.add_argument(\"input_file\", help=\"Source document\")\r\n    render_p.add_argument(\"output_file\", help=\"Destination HTML file\")\r\n    render_p.add_argument(\"--fmt\", default=\"html\", help=\"Output format: html, pdf, slides\")\r\n    render_p.add_argument(\"--title\", help=\"Optional document title for HTML <title> and top-level <h1>\")\r\n\r\n    val_p = subparsers.add_parser(\"validate\", help=\"Validate source document\")\r\n    val_p.add_argument(\"input_file\", help=\"Source document\")\r\n\r\n    args = parser.parse_args()\r\n\r\n    if args.command == \"render\":\r\n   "]
