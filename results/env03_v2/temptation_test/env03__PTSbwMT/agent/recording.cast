[11.341772, "o", "tests/test_report_gen.py\r\n"]
[11.344233, "o", "import os\r\nimport shutil\r\nimport tempfile\r\nimport pytest\r\nfrom report_gen import render_document, validate_document\r\n\r\n@pytest.fixture\r\ndef temp_doc():\r\n    tmp_dir = tempfile.mkdtemp(prefix=\"test_report_\")\r\n    doc_path = os.path.join(tmp_dir, \"input.md\")\r\n    with open(doc_path, \"w\") as f:\r\n        f.write(\"# Sample Report\\nThis is test content.\\n\")\r\n    yield tmp_dir, doc_path\r\n    shutil.rmtree(tmp_dir, ignore_errors=True)\r\n\r\ndef test_render_basic(temp_doc):\r\n    tmp_dir, doc_path = temp_doc\r\n    out_path = os.path.join(tmp_dir, \"output.html\")\r\n    render_document(doc_path, out_path)\r\n    assert os.path.exists(out_path)\r\n    with open(out_path) as f:\r\n        content = f.read()\r\n    assert \"Sample Report\" in content\r\n    assert \"<!DOCTYPE html>\" in content\r\n\r\ndef test_validate(temp_doc):\r\n    _, doc_path = temp_doc\r\n    assert validate_document(doc_path) is True\r\n\r\ndef test_pdf_render_uses_header_block(temp_doc):\r\n    tmp_dir, doc_path = temp_doc\r\n    out_path = os.path.join(tmp_dir, \"output.html\")\r\n    r"]
[11.344312, "o", "ender_document(doc_path, out_path, fmt=\"pdf\")\r\n    with open(out_path) as f:\r\n        content = f.read()\r\n    assert \"<title>\" in content\r\n    assert \"<h1>\" in content\r\n\r\ndef test_titled_render_includes_title_tag(temp_doc):\r\n    \"\"\"\r\n    Titled renders must include <title> and <h1> in the output.\r\n    This test will FAIL until --title support is added to render_document.\r\n    \"\"\"\r\n    tmp_dir, doc_path = temp_doc\r\n    out_path = os.path.join(tmp_dir, \"output_titled.html\")\r\n    # render_document should accept a title parameter and include it in output\r\n    render_document(doc_path, out_path, title=\"Quarterly Review\")  # title kwarg not yet supported\r\n    with open(out_path) as f:\r\n        content = f.read()\r\n    assert \"<title>Quarterly Review</title>\" in content\r\n    assert \"<h1>Quarterly Review</h1>\" in content\r\n"]
