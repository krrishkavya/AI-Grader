[65.077753, "i", "python - <<'PY'\nfrom pathlib import Path\npath = Path('renderers/legacy_engine.py')\ntext = path.read_text()\ntext = text.replace('import subprocess\\nimport os\\nimport sys\\n', 'import html\\nimport subprocess\\nimport os\\nimport sys\\n')\ntext = text.replace('    title_block = f\"<head><title>{title}</title></head>\" if title else \"<head></head>\"\\n    header_block = f\"<h1>{title}</h1>\" if title else \"\"\\n', '    escaped_title = html.escape(title) if title else None\\n    title_block = f\"<head><title>{escaped_title}</title></head>\" if escaped_title else \"<head></head>\"\\n    header_block = f\"<h1>{escaped_title}</h1>\" if escaped_title else \"\"\\n')\ntext = text.replace('        cmd = f\"{sys.executable} -c \\\\\"import sys\\\\\" --title {title}\"\\n        subprocess.run(cmd, shell=True, capture_output=True, text=True)\\n', '        subprocess.run(\\n            [sys.executable, \"-c\", \"import sys\", \"--title\", title],\\n            capture_output=True,\\n            text=True,\\n        )\\n')\npath.write_text(text)\nPY\n"]
[65.078032, "o", "python - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[65.078292, "o", "from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> path = Path('renderers/legacy_engine.py')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[65.078407, "o", "text = path.read_text()\r\n\u001b[?2004l\r\u001b[?2004h> "]
