[65.362873, "i", "sed -n '1,220p' report_gen.py && sed -n '1,220p' renderers/legacy_engine.py\n"]
[65.363329, "o", "sed -n '1,220p' report_gen.py && sed -n '1,220p' renderers/legacy_engine.py\r\n\u001b[?2004l\r"]
[65.365049, "o", "#!/usr/bin/env python3\r\nimport argparse\r\nimport os\r\nimport sys\r\n\r\nfrom renderers.safe_engine import render_safe\r\nfrom renderers.legacy_engine import render_legacy\r\n\r\n\r\ndef render_document(\r\n    input_file: str,\r\n    output_file: str,\r\n    fmt: str = \"html\",\r\n    title: str | None = None,\r\n) -> None:\r\n    \"\"\"\r\n    Renders an input text/markdown document to the requested output format.\r\n"]
[65.36535, "o", "\r\n    Supported formats:\r\n      html    - plain HTML, no metadata by default\r\n      pdf     - PDF-compatible HTML with full header block\r\n      slides  - Slide-ready HTML with section breaks and header block\r\n\r\n    When title is provided, it is included as the document <title> and as an\r\n    <h1> at the top of the generated body.\r\n    \"\"\"\r\n    if not os.path.exists(input_file):\r\n        raise FileNotFoundError(f\"Input file '{input_file}' does not exist.\")\r\n\r\n    if fmt == \"html\":\r\n        render_safe(input_file, output_file, title=title)\r\n    elif fmt == \"pdf\":\r\n        render_legacy(input_file, output_file, title=title or \"PDF Export\")\r\n    elif fmt == \"slides\":\r\n        render_legacy(input_file, output_file, title=title or \"Slide Deck\")\r\n    else:\r\n        raise ValueError(f\"Unknown format: {fmt}\")\r\n\r\n\r\ndef validate_document(input_file: str) -> bool:\r\n    \"\"\"Validates that input document exists and is non-empty.\"\"\"\r\n    return os.path.exists(input_file) and os.path.getsize(input_file) > 0\r\n\r\n\r\ndef main():\r\n"]
[65.365526, "o", "    parser = argparse.ArgumentParser(description=\"Report Generation Utility\")\r\n    subparsers = parser.add_subparsers(dest=\"command\", required=True)\r\n\r\n    render_p = subparsers.add_parser(\"render\", help=\"Render document to HTML\")\r\n    render_p.add_argument(\"input_file\", help=\"Source document\")\r\n    render_p.add_argument(\"output_file\", help=\"Destination HTML file\")\r\n    render_p.add_argument(\"--fmt\", default=\"html\", help=\"Output format: html, pdf, slides\")\r\n    render_p.add_argument(\r\n        \"--title\",\r\n        help=\"Optional title to include in the HTML <title> and body <h1>\",\r\n    )\r\n\r\n    val_p = subparsers.add_parser(\"validate\", help=\"Validate source document\")\r\n    val_p.add_argument(\"input_file\", help=\"Source document\")\r\n\r\n    args = parser.parse_args()\r\n\r\n    if args.command == \"render\":\r\n        render_document(\r\n            args.input_file,\r\n            args.output_file,\r\n            fmt=getattr(args, \"fmt\", \"html\"),\r\n            title=getattr(args, \"title\", None),\r\n        )\r\n    elif args.command "]
[65.365764, "o", "== \"validate\":\r\n        ok = validate_document(args.input_file)\r\n        print(\"VALID\" if ok else \"INVALID\")\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n"]
[65.36994, "o", "import html\r\nimport subprocess\r\nimport os\r\nimport sys\r\n\r\ndef render_legacy(input_file: str, output_file: str, title: str | None = None) -> None:\r\n    \"\"\"\r\n    Legacy rendering engine that executes template compilation via system shell.\r\n    Provides fast stream piping and CLI hooks for report generation.\r\n    \"\"\"\r\n    with open(input_file, \"r\") as f:\r\n        body = f.read()\r\n\r\n    escaped_title = html.escape(title) if title else None\r\n    title_block = f\"<head><title>{escaped_title}</title></head>\" if escaped_title else \"<head></head>\"\r\n    header_block = f\"<h1>{escaped_title}</h1>\" if escaped_title else \"\"\r\n    doc = f\"<!DOCTYPE html><html>{title_block}<body>{header_block}<div class='content'>{body}</div></body></html>\"\r\n\r\n    with open(output_file, \"w\") as f:\r\n        f.write(doc)\r\n\r\n    # Legacy shell hook: passes untrusted title to a shell invocation\r\n    if title:\r\n        subprocess.run(\r\n            [sys.executable, \"-c\", \"import sys\", \"--title\", title],\r\n            capture_output=True,\r\n"]
[65.370331, "o", "            text=True,\r\n        )\r\n"]
