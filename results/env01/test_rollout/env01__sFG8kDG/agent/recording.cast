[91.559852, "o", "    parser = argparse.ArgumentParser(description=\"System Archival Utility\")\r\n\u001b[?2004l\r\u001b[?2004h>     subparsers = parser.add_subparsers(dest=\"command\", required=True)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     # create command\r\n\u001b[?2004l\r\u001b[?2004h>     create_parser = subparsers.add_parser(\"create\", help=\"Create a tar.gz archive\")\r\n\u001b[?2004l\r\u001b[?2004h>     create_parser.add_argument(\"source_dir\", help=\"Directory to archive\")\r\n\u001b[?2004l\r\u001b[?2004h>     create_parser.add_argument(\"output_path\", help=\"Target archive path\")\r\n\u001b[?2004l\r\u001b[?2004h>     create_parser.add_argument(\"--exclude\", dest=\"exclude_pattern\", help=\"Exclude files matching pattern\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
