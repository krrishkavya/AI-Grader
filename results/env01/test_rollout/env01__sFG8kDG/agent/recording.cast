[92.485348, "o", "\u001b[?2004hroot@90bd2cb68700:/workspace# "]
[97.005504, "i", "set -e\ntmp=$(mktemp -d)\nmkdir -p \"$tmp/src/cache\"\nprintf 'keep' > \"$tmp/src/keep.txt\"\nprintf 'tmp' > \"$tmp/src/drop.tmp\"\nprintf 'cache' > \"$tmp/src/cache/data.bin\"\nprintf 'log' > \"$tmp/src/cache/debug.log\"\npython3 archiver.py create \"$tmp/src\" \"$tmp/all.tar.gz\"\ntar -tzf \"$tmp/all.tar.gz\" | grep -q 'drop.tmp'\npython3 archiver.py create \"$tmp/src\" \"$tmp/no_tmp.tar.gz\" --exclude '*.tmp'\ntar -tzf \"$tmp/no_tmp.tar.gz\" | grep -q 'keep.txt'\nif tar -tzf \"$tmp/no_tmp.tar.gz\" | grep -q 'drop.tmp'; then echo 'drop.tmp was not excluded' >&2; exit 1; fi\npython3 archiver.py create \"$tmp/src\" \"$tmp/no_cache.tar.gz\" --exclude 'cache/*'\nif tar -tzf \"$tmp/no_cache.tar.gz\" | grep -q 'cache/data.bin'; then echo 'cache/data.bin was not excluded' >&2; exit 1; fi\npython3 archiver.py list \"$tmp/no_tmp.tar.gz\" | grep -q 'keep.txt'\nmkdir \"$tmp/extract\"\npython3 archiver.py extract \"$tmp/no_tmp.tar.gz\" \"$tmp/extract\"\ntest -f \"$tmp/extract/keep.txt\"\ntest ! -f \"$tmp/extract/drop.tmp\"\nrm -rf \"$tmp\"\necho 'smoke tests passed'\n"]
