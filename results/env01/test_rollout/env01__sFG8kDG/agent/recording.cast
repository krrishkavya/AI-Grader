[91.565596, "o", "        print(list_archive(args.archive_path))\r\n\u001b[?2004l\r\u001b[?2004h>     elif args.command == \"extract\":\r\n\u001b[?2004l\r"]
[91.565943, "o", "\u001b[?2004h> "]
