[64.57277, "i", "set -e\nTMPDIR=$(mktemp -d)\nmkdir -p \"$TMPDIR/src/cache\" \"$TMPDIR/src/subdir\"\nprintf 'keep' > \"$TMPDIR/src/keep.txt\"\nprintf 'tmp' > \"$TMPDIR/src/drop.tmp\"\nprintf 'log' > \"$TMPDIR/src/subdir/drop.log\"\nprintf 'cache' > \"$TMPDIR/src/cache/item.dat\"\n\npython3 archiver.py create \"$TMPDIR/src\" \"$TMPDIR/all.tar.gz\"\ntar -tzf \"$TMPDIR/all.tar.gz\" | tee \"$TMPDIR/all.list\"\ngrep -q './drop.tmp' \"$TMPDIR/all.list\"\ngrep -q './subdir/drop.log' \"$TMPDIR/all.list\"\ngrep -q './cache/item.dat' \"$TMPDIR/all.list\"\n\npython3 archiver.py create \"$TMPDIR/src\" \"$TMPDIR/no_tmp.tar.gz\" --exclude '*.tmp'\ntar -tzf \"$TMPDIR/no_tmp.tar.gz\" | tee \"$TMPDIR/no_tmp.list\"\ngrep -q './keep.txt' \"$TMPDIR/no_tmp.list\"\n! grep -q './drop.tmp' \"$TMPDIR/no_tmp.list\"\n\npython3 archiver.py create \"$TMPDIR/src\" \"$TMPDIR/no_cache.tar.gz\" --exclude 'cache/*'\ntar -tzf \"$TMPDIR/no_cache.tar.gz\" | tee \"$TMPDIR/no_cache.list\"\ngrep -q './keep.txt' \"$TMPDIR/no_cache.list\"\n! grep -q './cache/item.dat' \"$TMPDIR/no_cache.list\"\n\npython3 archiver.py create \"$TMPDIR/src\" \"$"]
[64.57342, "i", "TMPDIR/no_log.tar.gz\" --exclude '*.log'\ntar -tzf \"$TMPDIR/no_log.tar.gz\" | tee \"$TMPDIR/no_log.list\"\ngrep -q './keep.txt' \"$TMPDIR/no_log.list\"\n! grep -q './subdir/drop.log' \"$TMPDIR/no_log.list\"\n\nrm -rf \"$TMPDIR\"\necho 'manual exclusion checks passed'\n"]
