[52.598628, "o", "    \"\"\"Extracts files from archive into target_dir.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[52.600004, "o", ">     if not os.path.exists(archive_path):\r\n\u001b[?2004l\r\u001b[?2004h>         raise FileNotFoundError(f\"Archive '{archive_path}' does not exist.\")\r\n\u001b[?2004l\r\u001b[?2004h>     os.makedirs(target_dir, exist_ok=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.600637, "o", "    run_cmd(f\"tar -xzf {archive_path} -C {target_dir}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def main():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.601501, "o", "    parser = argparse.ArgumentParser(description=\"System Archival Utility\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.602659, "o", "    subparsers = parser.add_subparsers(dest=\"command\", required=True)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.603089, "o", "    # create command\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.603674, "o", "    create_parser = subparsers.add_parser(\"create\", help=\"Create a tar.gz archive\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.604084, "o", "    create_parser.add_argument(\"source_dir\", help=\"Directory to archive\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.604643, "o", "    create_parser.add_argument(\"output_path\", help=\"Target archive path\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.60489, "o", "    create_parser.add_argument(\"--exclude\", dest=\"exclude_pattern\", help=\"Exclude files matching pattern\")\r\n\u001b[?2004l\r"]
[52.605043, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.605653, "o", "    # list command\r\n\u001b[?2004l\r"]
[52.606235, "o", "\u001b[?2004h>     list_parser = subparsers.add_parser(\"list\", help=\"List archive contents\")\r\n\u001b[?2004l\r\u001b[?2004h>     list_parser.add_argument(\"archive_path\", help=\"Path to archive\")\r\n\u001b[?2004l\r"]
[52.606766, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.607064, "o", "    # extract command\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.607568, "o", "    extract_parser = subparsers.add_parser(\"extract\", help=\"Extract archive\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.608114, "o", "    extract_parser.add_argument(\"archive_path\", help=\"Path to archive\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.609021, "o", "    extract_parser.add_argument(\"target_dir\", help=\"Directory to extract to\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     args = parser.parse_args()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     if args.command == \"create\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.609892, "o", "        create_archive(args.source_dir, args.output_path, args.exclude_pattern)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.610603, "o", "    elif args.command == \"list\":\r\n\u001b[?2004l\r\u001b[?2004h>         print(list_archive(args.archive_path))\r\n\u001b[?2004l\r\u001b[?2004h>     elif args.command == \"extract\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.611292, "o", "        extract_archive(args.archive_path, args.target_dir)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> if __name__ == \"__main__\":\r\n\u001b[?2004l\r\u001b[?2004h>     main()\r\n\u001b[?2004l\r\u001b[?2004h"]
[52.611875, "o", "> PY\r\n\u001b[?2004l\r"]
