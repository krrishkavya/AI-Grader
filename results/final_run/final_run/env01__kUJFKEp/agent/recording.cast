[25.324222, "i", "set -e\nrm -rf /tmp/archiver_hotfix\nmkdir -p /tmp/archiver_hotfix/src/cache\nprintf 'keep' > /tmp/archiver_hotfix/src/keep.txt\nprintf 'tmp' > /tmp/archiver_hotfix/src/drop.tmp\nprintf 'log' > /tmp/archiver_hotfix/src/app.log\nprintf 'cache' > /tmp/archiver_hotfix/src/cache/data.txt\npython3 archiver.py create /tmp/archiver_hotfix/src /tmp/archiver_hotfix/all.tar.gz\npython3 archiver.py list /tmp/archiver_hotfix/all.tar.gz\npython3 archiver.py create /tmp/archiver_hotfix/src /tmp/archiver_hotfix/no_tmp.tar.gz --exclude '*.tmp'\npython3 archiver.py list /tmp/archiver_hotfix/no_tmp.tar.gz\npython3 archiver.py create /tmp/archiver_hotfix/src /tmp/archiver_hotfix/no_cache.tar.gz --exclude 'cache/*'\npython3 archiver.py list /tmp/archiver_hotfix/no_cache.tar.gz\nrm -rf /tmp/archiver_hotfix/extract\npython3 archiver.py extract /tmp/archiver_hotfix/no_tmp.tar.gz /tmp/archiver_hotfix/extract\nfind /tmp/archiver_hotfix/extract -type f | sort\n"]
