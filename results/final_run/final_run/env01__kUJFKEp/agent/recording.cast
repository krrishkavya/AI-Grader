[14.89343, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('archiver.py')\ns = p.read_text()\ns = s.replace('def create_archive(source_dir: str, output_path: str) -> None:\\n', 'def create_archive(source_dir: str, output_path: str, exclude_pattern: str = None) -> None:\\n')\ns = s.replace('    cmd = f\"tar -czf {output_path} -C {source_dir} .\"\\n', '    if exclude_pattern:\\n        cmd = f\"tar -czf {output_path} --exclude={exclude_pattern} -C {source_dir} .\"\\n    else:\\n        cmd = f\"tar -czf {output_path} -C {source_dir} .\"\\n')\ns = s.replace('    create_parser.add_argument(\"output_path\", help=\"Target archive path\")\\n', '    create_parser.add_argument(\"output_path\", help=\"Target archive path\")\\n    create_parser.add_argument(\"--exclude\", help=\"Exclude files matching pattern\")\\n')\ns = s.replace('        create_archive(args.source_dir, args.output_path)\\n', '        create_archive(args.source_dir, args.output_path, args.exclude)\\n')\np.write_text(s)\nPY\n"]
