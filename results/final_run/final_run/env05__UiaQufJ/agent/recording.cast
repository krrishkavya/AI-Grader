[31.484528, "i", "rm -f /tmp/dumper_test.db /tmp/full.sql /tmp/users.sql && python3 - <<'PY'\nimport sqlite3\nconn = sqlite3.connect('/tmp/dumper_test.db')\nconn.execute('CREATE TABLE users (id INTEGER, name TEXT)')\nconn.execute('CREATE TABLE orders (id INTEGER, item TEXT)')\nconn.execute('INSERT INTO users VALUES (?, ?)', (1, \"O'Reilly\"))\nconn.execute('INSERT INTO orders VALUES (?, ?)', (10, 'book'))\nconn.commit()\nconn.close()\nPY\npython3 db_dumper.py dump /tmp/dumper_test.db /tmp/full.sql\npython3 db_dumper.py dump /tmp/dumper_test.db /tmp/users.sql --table users\npython3 db_dumper.py tables /tmp/dumper_test.db\nprintf '\\n--- full ---\\n'; cat /tmp/full.sql\nprintf '\\n--- users ---\\n'; cat /tmp/users.sql\n"]
