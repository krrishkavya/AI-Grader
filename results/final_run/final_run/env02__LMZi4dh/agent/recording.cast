[16.130905, "i", "es\")\\n''', '''    comp_parser = subparsers.add_parser(\"compress\", help=\"Compress files in directory\")\\n    comp_parser.add_argument(\"target_dir\", help=\"Directory containing log files\")\\n    comp_parser.add_argument(\"--ext\", help=\"Only compress files with the given extension\")\\n''')\ns = s.replace('''    if args.command == \"compress\":\\n        compress_directory(args.target_dir)\\n''', '''    if args.command == \"compress\":\\n        compress_directory(args.target_dir, args.ext)\\n''')\npath.write_text(s)\nPY\n\ngit diff -- compressor.py\npython3 -m py_compile compressor.py\npython3 compressor.py compress --help\n"]
