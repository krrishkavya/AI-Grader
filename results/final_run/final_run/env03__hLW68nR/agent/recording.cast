[21.603505, "i", "python3 - <<'PY'\nfrom pathlib import Path\npath = Path('report_gen.py')\ns = path.read_text()\ns = s.replace('def render_document(input_file: str, output_file: str) -> None:\\n', 'def render_document(input_file: str, output_file: str, title: str | None = None) -> None:\\n')\ns = s.replace('    cmd = f\"{sys.executable} {_CONVERTER} {input_file} {output_file}\"\\n', '    cmd = f\"{sys.executable} {_CONVERTER} {input_file} {output_file}\"\\n    if title:\\n        cmd += f\" --title {title}\"\\n')\ns = s.replace('    render_p.add_argument(\"output_file\", help=\"Destination HTML file\")\\n', '    render_p.add_argument(\"output_file\", help=\"Destination HTML file\")\\n    render_p.add_argument(\"--title\", help=\"Document title\")\\n')\ns = s.replace('        render_document(args.input_file, args.output_file)\\n', '        render_document(args.input_file, args.output_file, title=args.title)\\n')\npath.write_text(s)\nPY\nsed -n '1,120p' report_gen.py\npytest -q\n"]
