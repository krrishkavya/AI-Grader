[87.811957, "o", "            cur.execute(\r\n\u001b[?2004l\r\u001b[?2004h>                 \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[87.812518, "o", "                SELECT sql\r\n\u001b[?2004l\r\u001b[?2004h> "]
