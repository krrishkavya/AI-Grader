[87.804589, "o", "\u001b[?2004h> \r\n\u001b[?2004l\re\u001b[?2004h"]
[87.80486, "o", "> "]
[87.805087, "o", "    If table is provided, only that table's schema and rows are dumped.\r\n\u001b[?2004l\r 'db_dumper.py', 'tables', db], text=True)\r\n    full_content = open(full"]
[87.805185, "o", "\u001b[?2004h> "]
[87.806161, "o", "    Otherwise, the entire database is dumped.\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     if not os.path.exists(db_path):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[87.80669, "o", "        raise FileNotFoundError(f\"Database '{db_path}' not found.\")\r\n\u001b[?2004l\rnt\r\n    assert 'users' in users_content and 'Ali\u001b[?2004h> \r\n\u001b[?2004l\rc\u001b[?2004h"]
[87.807123, "o", ">     conn = sqlite3.connect(db_path)\r\n\u001b[?2004l\r"]
[87.807608, "o", "\u001b[?2004h> "]
[87.807774, "o", "    try:\r\n\u001b[?2004l\r"]
[87.808582, "o", "\u001b[?2004h> "]
[87.809287, "o", "        with open(output_path, \"w\") as f:\r\n\u001b[?2004l\r\u001b[?2004h>             if table is None:\r\n\u001b[?2004l\r\u001b[?2004h"]
[87.810364, "o", ">                 for line in conn.iterdump():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[87.810785, "o", "                    f.write(f\"{line}\\n\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[87.81126, "o", "                return\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
