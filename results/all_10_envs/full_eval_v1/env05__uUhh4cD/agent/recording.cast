[87.813462, "o", "\u001b[?2004h> "]
[87.814, "o", "                WHERE type='table' AND name=? AND name NOT LIKE 'sqlite_%'\r\n\u001b[?2004l\r\u001b[?2004h"]
[87.81527, "o", ">                 \"\"\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[87.815413, "o", "                (table,),\r\n\u001b[?2004l\r\u001b[?2004h>             )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[87.815489, "o", "            row = cur.fetchone()\r\n\u001b[?2004l\r\u001b[?2004h"]
[87.816382, "o", ">             if row is None:\r\n\u001b[?2004l\r"]
[87.816514, "o", "\u001b[?2004h>                 raise ValueError(f\"Table '{table}' not found in database '{db_path}'.\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[87.817757, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h>             create_sql = row[0]\r\n\u001b[?2004l\r\u001b[?2004h>             if create_sql is None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[87.8187, "o", "                raise ValueError(f\"Table '{table}' does not have a dumpable schema.\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[87.819292, "o", "            quoted_table = _quote_identifier(table)\r\n\u001b[?2004l\r\u001b[?2004h>             f.write(\"BEGIN TRANSACTION;\\n\")\r\n\u001b[?2004l\r\u001b[?2004h>             f.write(f\"{create_sql};\\n\")\r\n\u001b[?2004l\r"]
[87.819876, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>             cur.execute(f\"SELECT * FROM {quoted_table}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[87.820299, "o", "            for data_row in cur:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[87.820991, "o", "                values = \",\".join(_quote_value(conn, value) for value in data_row)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[87.821627, "o", "                f.write(f\"INSERT INTO {quoted_table} VALUES({values});\\n\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>             cur.execute(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[87.822007, "o", "                \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[87.822257, "o", "                SELECT sql\r\n\u001b[?2004l\r\u001b[?2004h>                 FROM sqlite_master\r\n\u001b[?2004l\r\u001b[?2004h"]
[87.822949, "o", "> "]
