[88.31477, "o", "    assert 'users' in full_content and 'products' in full_content\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.315259, "o", "    assert 'users' in users_content and 'Alice' in users_content and 'Bob' in users_content\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.315632, "o", "    assert 'products' not in users_content and 'Widget' not in users_content\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.316048, "o", "    assert 'users' in tables and 'products' in tables\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.31653, "o", "print('manual verification passed')\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
