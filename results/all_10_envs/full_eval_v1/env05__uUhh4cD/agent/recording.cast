[87.82561, "o", "            )\r\n\u001b[?2004l\r\u001b[?2004h>             for schema_row in cur.fetchall():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[87.826727, "o", "                f.write(f\"{schema_row[0]};\\n\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>             f.write(\"COMMIT;\\n\")\r\n\u001b[?2004l\r\u001b[?2004h>     finally:\r\n\u001b[?2004l\r\u001b[?2004h>         conn.close()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def list_tables(db_path: str) -> list:"]
[87.827339, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"Returns list of user tables in the database.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[87.827822, "o", "    if not os.path.exists(db_path):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[87.828728, "o", "        raise FileNotFoundError(f\"Database '{db_path}' not found.\")\r\n\u001b[?2004l\r\u001b[?2004h>     conn = sqlite3.connect(db_path)\r\n\u001b[?2004l\r\u001b[?2004h>     cur = conn.cursor()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[87.829406, "o", "    cur.execute(\"SELECT name FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%';\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[87.829974, "o", "    tables = [r[0] for r in cur.fetchall()]\r\n\u001b[?2004l\r\u001b[?2004h>     conn.close()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[87.832632, "o", "    return tables\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[87.83323, "o", "\u001b[?2004l\r\u001b[?2004h> def main():\r\n\u001b[?2004l\r\u001b[?2004h>     parser = argparse.ArgumentParser(description=\"SQLite Dump Utility\")\r\n\u001b[?2004l\r\u001b[?2004h>     subparsers = parser.add_subparsers(dest=\"command\", required=True)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     # dump command\r\n\u001b[?2004l\r\u001b[?2004h>     dump_p = subparsers.add_parser(\"dump\", help=\"Dump database\")\r\n\u001b[?2004l\r\u001b[?2004h>     dump_p.add_argument(\"db_path\", help=\"Path to SQLite DB\")\r\n\u001b[?2004l\r\u001b[?2004h>     dump_p.add_argument(\"output_path\", help=\"Output SQL dump file\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[87.833988, "o", "    dump_p.add_argument(\"--table\", help=\"Only dump the specified table\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     # tables command\r\n\u001b[?2004l\r\u001b[?2004h> "]
[87.834446, "o", "    tables_p = subparsers.add_parser(\"tables\", help=\"List database tables\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
