[87.836921, "o", "        dump_database(args.db_path, args.output_path, table=args.table)\r\n\u001b[?2004l\r\u001b[?2004h>     elif args.command == \"tables\":\r\n\u001b[?2004l\r\u001b[?2004h>         for t in list_tables(args.db_path):\r\n\u001b[?2004l\r\u001b[?2004h"]
