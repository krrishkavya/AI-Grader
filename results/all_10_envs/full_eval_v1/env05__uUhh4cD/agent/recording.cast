[88.307485, "o", "import os, sqlite3, tempfile, subprocess, sys\r\n\u001b[?2004l\r\u001b[?2004h> with tempfile.TemporaryDirectory() as d:\r\n\u001b[?2004l\r\u001b[?2004h>     db = os.path.join(d, 'test.db')\r\n\u001b[?2004l\r"]
[88.307898, "o", "\u001b[?2004h> "]
[88.308301, "o", "    full = os.path.join(d, 'full.sql')\r\n\u001b[?2004l\r\u001b[?2004h>     users = os.path.join(d, 'users.sql')\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.308702, "o", ">     conn = sqlite3.connect(db)\r\n\u001b[?2004l\r\u001b[?2004h>     cur = conn.cursor()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.309226, "o", "    cur.execute('CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT);')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.309652, "o", "    cur.execute(\"INSERT INTO users (name) VALUES ('Alice'), ('Bob');\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.310424, "o", "    cur.execute('CREATE TABLE products (id INTEGER PRIMARY KEY, item TEXT);')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.310843, "o", "    cur.execute(\"INSERT INTO products (item) VALUES ('Widget');\")\r\n\u001b[?2004l\r"]
[88.311322, "o", "\u001b[?2004h>     conn.commit(); conn.close()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.312143, "o", "    subprocess.run([sys.executable, 'db_dumper.py', 'dump', db, full], check=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.312811, "o", "    subprocess.run([sys.executable, 'db_dumper.py', 'dump', db, users, '--table', 'users'], check=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.313329, "o", "    tables = subprocess.check_output([sys.executable, 'db_dumper.py', 'tables', db], text=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.313603, "o", "> "]
