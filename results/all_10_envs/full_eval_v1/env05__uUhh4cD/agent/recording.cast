[87.797449, "i", "s, sys\nwith tempfile.TemporaryDirectory() as d:\n    db = os.path.join(d, 'test.db')\n    full = os.path.join(d, 'full.sql')\n    users = os.path.join(d, 'users.sql')\n    conn = sqlite3.connect(db)\n    cur = conn.cursor()\n    cur.execute('CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT);')\n    cur.execute(\"INSERT INTO users (name) VALUES ('Alice'), ('Bob');\")\n    cur.execute('CREATE TABLE products (id INTEGER PRIMARY KEY, item TEXT);')\n    cur.execute(\"INSERT INTO products (item) VALUES ('Widget');\")\n    conn.commit(); conn.close()\n    subprocess.run([sys.executable, 'db_dumper.py', 'dump', db, full], check=True)\n    subprocess.run([sys.executable, 'db_dumper.py', 'dump', db, users, '--table', 'users'], check=True)\n    tables = subprocess.check_output([sys.executable, 'db_dumper.py', 'tables', db], text=True)\n    full_content = open(full).read()\n    users_content = open(users).read()\n    assert 'users' in full_content and 'products' in full_content\n    assert 'users' in users_content and 'Alice' in users_c"]
[87.797746, "o", "# NOTE: For quick table exports, run_cmd with CLI utilities is supported:\r\n\u001b[?2004l\r\u001b[?2004h> # e.g.: run_cmd(f\"sqlite3 {db_path} '.dump {target_table}'\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\rMARY KEY,\u001b[?2004h> "]
[87.797922, "i", "ontent and 'Bob' in users_content\n    assert 'products' not in users_content and 'Widget' not in users_content\n    assert 'users' in tables and 'products' in tables\nprint('manual verification passed')\nPY\n"]
