[45.32995, "o", "\u001b[?2004h>                 values = \",\".join(_quote_sql_value(v) for v in data_row)\r\n\u001b[?2004l\r\u001b[?2004h>                 f.write(f\"INSERT INTO {quoted_table} VALUES({values});\\n\")\r\n\u001b[?2004l\r\u001b[?2004h>             f.write(\"COMMIT;\\n\")\r\n\u001b[?2004l\r\u001b[?2004h>     finally:\r\n\u001b[?2004l\r\u001b[?2004h>         conn.close()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.330549, "o", "def list_tables(db_path: str) -> list:\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"Returns list of user tables in the database.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     if not os.path.exists(db_path):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.330844, "o", "        raise FileNotFoundError(f\"Database '{db_path}' not found.\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.331028, "o", "    conn = sqlite3.connect(db_path)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.331179, "o", "    cur = conn.cursor()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.331436, "o", "    cur.execute(\"SELECT name FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%';\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.331887, "o", "    tables = [r[0] for r in cur.fetchall()]\r\n\u001b[?2004l\r\u001b[?2004h>     conn.close()\r\n\u001b[?2004l\r\u001b[?2004h>     return tables\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[45.332114, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def main():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.332285, "o", "    parser = argparse.ArgumentParser(description=\"SQLite Dump Utility\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.333199, "o", "    subparsers = parser.add_subparsers(dest=\"command\", required=True)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.333882, "o", "    # dump command\r\n\u001b[?2004l\r\u001b[?2004h>     dump_p = subparsers.add_parser(\"dump\", help=\"Dump database\")\r\n\u001b[?2004l\r\u001b[?2004h>     dump_p.add_argument(\"db_path\", help=\"Path to SQLite DB\")\r\n\u001b[?2004l\r\u001b[?2004h>     dump_p.add_argument(\"output_path\", help=\"Output SQL dump file\")\r\n\u001b[?2004l\r"]
[45.334169, "o", "\u001b[?2004h>     dump_p.add_argument(\"--table\", dest=\"table_name\", help=\"Dump only the specified table\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     # tables command\r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.334352, "o", "    tables_p = subparsers.add_parser(\"tables\", help=\"List database tables\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.334602, "o", "    tables_p.add_argument(\"db_path\", help=\"Path to SQLite DB\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.33486, "o", "    args = parser.parse_args()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.335077, "o", "    if args.command == \"dump\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.335289, "o", "        dump_database(args.db_path, args.output_path, args.table_name)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.335462, "o", "    elif args.command == \"tables\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.335651, "o", "        for t in list_tables(args.db_path):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.335824, "o", "            print(t)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[45.335965, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.336357, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r\u001b[?2004h>     main()\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[45.342046, "o", "\u001b[?2004hroot@1e1b2f90eb6f:/workspace# "]
[45.343282, "o", "python3 -m py_compile db_dumper.py\r\n\u001b[?2004l\r"]
[45.395976, "o", "\u001b[?2004hroot@1e1b2f90eb6f:/workspace# "]
[45.396332, "o", "python3 db_dumper.py dump --help\r\n\u001b[?2004l\r"]
[45.457648, "o", "usage: db_dumper.py dump [-h] [--table TABLE_NAME] db_path output_path\r\n\r\npositional arguments:\r\n  db_path             Path to SQLite DB\r\n  output_path         Output SQL dump file\r\n\r\noptions:\r\n  -h, --help          show this help message and exit\r\n  --table TABLE_NAME  Dump only the specified table\r\n"]
[45.469048, "o", "\u001b[?2004hroot@1e1b2f90eb6f:/workspace# "]
[56.416366, "i", "rm -f /tmp/db_dumper_test.db /tmp/db_dumper_full.sql /tmp/db_dumper_users.sql\npython3 - <<'PY'\nimport sqlite3\nconn = sqlite3.connect('/tmp/db_dumper_test.db')\ncur = conn.cursor()\ncur.execute('CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT, note TEXT)')\ncur.execute('CREATE TABLE orders (id INTEGER PRIMARY KEY, user_id INTEGER, total REAL)')\ncur.execute('INSERT INTO users (name, note) VALUES (?, ?)', (\"Alice\", \"contains ' quote\"))\ncur.execute('INSERT INTO users (name, note) VALUES (?, ?)', (\"Bob\", None))\ncur.execute('INSERT INTO orders (user_id, total) VALUES (?, ?)', (1, 12.5))\nconn.commit()\nconn.close()\nPY\npython3 db_dumper.py tables /tmp/db_dumper_test.db\npython3 db_dumper.py dump /tmp/db_dumper_test.db /tmp/db_dumper_full.sql\npython3 db_dumper.py dump /tmp/db_dumper_test.db /tmp/db_dumper_users.sql --table users\nprintf '\\n--- full dump ---\\n'\ncat /tmp/db_dumper_full.sql\nprintf '\\n--- users-only dump ---\\n'\ncat /tmp/db_dumper_users.sql\n"]
[56.417777, "o", "rm -f /tmp/db_dumper_test.db /tmp/db_dumper_full.sql /tmp/db_dumper_users.sql\r\n\u001b[?2004l\r"]
