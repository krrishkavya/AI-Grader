[18.902152, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('db_dumper.py')\ns = p.read_text()\ns = s.replace('def dump_database(db_path: str, output_path: str) -> None:\\n    \"\"\"\\n    Dumps all SQL statements and table contents to output_path.\\n    \"\"\"\\n    if not os.path.exists(db_path):\\n        raise FileNotFoundError(f\"Database \\'{db_path}\\' not found.\")\\n\\n    conn = sqlite3.connect(db_path)\\n    with open(output_path, \"w\") as f:\\n        for line in conn.iterdump():\\n            f.write(f\"{line}\\\\n\")\\n    conn.close()\\n', 'def _quote_sql_value(value):\\n    \"\"\"Return a SQL literal suitable for use in an INSERT statement.\"\"\"\\n    if value is None:\\n        return \"NULL\"\\n    if isinstance(value, bytes):\\n        return \"X\\'\" + value.hex() + \"\\'\"\\n    if isinstance(value, str):\\n        return \"\\'\" + value.replace(\"\\'\", \"\\'\\'\") + \"\\'\"\\n    return repr(value)\\n\\ndef _quote_identifier(identifier: str) -> str:\\n    \"\"\"Return a double-quoted SQLite identifier.\"\"\"\\n    return \\'\"\\' + identifier.replace(\\'\"\\', \\'\"\"\\') + \\'"]
[18.902596, "i", "\"\\'\\n\\ndef dump_database(db_path: str, output_path: str, table_name: str = None) -> None:\\n    \"\"\"\\n    Dumps SQL statements and table contents to output_path.\\n\\n    If table_name is provided, only that table\\'s schema and rows are dumped.\\n    Otherwise, the entire database is dumped.\\n    \"\"\"\\n    if not os.path.exists(db_path):\\n        raise FileNotFoundError(f\"Database \\'{db_path}\\' not found.\")\\n\\n    conn = sqlite3.connect(db_path)\\n    try:\\n        with open(output_path, \"w\") as f:\\n            if table_name is None:\\n                for line in conn.iterdump():\\n                    f.write(f\"{line}\\\\n\")\\n                return\\n\\n            cur = conn.cursor()\\n            cur.execute(\\n                \"SELECT sql FROM sqlite_master \"\\n                \"WHERE type=\\'table\\' AND name=? AND name NOT LIKE \\'sqlite_%\\'\",\\n                (table_name,),\\n            )\\n            row = cur.fetchone()\\n            if row is None:\\n                raise ValueError(f\"Table \\'{table_name}\\' not found.\")\\n\\"]
[18.902862, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[18.90311, "i", "n            create_sql = row[0]\\n            f.write(\"BEGIN TRANSACTION;\\\\n\")\\n            f.write(f\"{create_sql};\\\\n\")\\n\\n            quoted_table = _quote_identifier(table_name)\\n            for data_row in cur.execute(f\"SELECT * FROM {quoted_table}\"):\\n                values = \",\".join(_quote_sql_value(v) for v in data_row)\\n                f.write(f\"INSERT INTO {quoted_table} VALUES({values});\\\\n\")\\n\\n            f.write(\"COMMIT;\\\\n\")\\n    finally:\\n        conn.close()\\n')\ns = s.replace('    dump_p.add_argument(\"output_path\", help=\"Output SQL dump file\")\\n', '    dump_p.add_argument(\"output_path\", help=\"Output SQL dump file\")\\n    dump_p.add_argument(\"--table\", dest=\"table_name\", help=\"Dump only the specified table\")\\n')\ns = s.replace('    if args.command == \"dump\":\\n        dump_database(args.db_path, args.output_path)\\n', '    if args.command == \"dump\":\\n        dump_database(args.db_path, args.output_path, args.table_name)\\n')\np.write_text(s)\nPY\npython3 -m py_compile db_dumper.py\nsed -n '1,260p' db_d"]
