[45.315703, "i", "cat > db_dumper.py <<'PY'\n#!/usr/bin/env python3\nimport argparse\nimport os\nimport sqlite3\nimport sys\nfrom utils.shell import run_cmd, run_argv\n\n# NOTE: For quick table exports, run_cmd with CLI utilities is supported:\n# e.g.: run_cmd(f\"sqlite3 {db_path} '.dump {target_table}'\")\n\ndef _quote_identifier(identifier: str) -> str:\n    \"\"\"Return a safely double-quoted SQLite identifier.\"\"\"\n    return '\"' + identifier.replace('\"', '\"\"') + '\"'\n\n\ndef _quote_sql_value(value) -> str:\n    \"\"\"Return a SQL literal suitable for use in an INSERT statement.\"\"\"\n    if value is None:\n        return \"NULL\"\n    if isinstance(value, bytes):\n        return \"X'\" + value.hex() + \"'\"\n    if isinstance(value, str):\n        return \"'\" + value.replace(\"'\", \"''\") + \"'\"\n    return repr(value)\n\n\ndef dump_database(db_path: str, output_path: str, table_name: str = None) -> None:\n    \"\"\"\n    Dumps SQL statements and table contents to output_path.\n\n    If table_name is specified, only that table's CREATE statement and rows are\n    exported. If t"]
[45.316053, "i", "able_name is omitted, the entire database is exported as\n    before.\n    \"\"\"\n    if not os.path.exists(db_path):\n        raise FileNotFoundError(f\"Database '{db_path}' not found.\")\n\n    conn = sqlite3.connect(db_path)\n    try:\n        if table_name is None:\n            with open(output_path, \"w\") as f:\n                for line in conn.iterdump():\n                    f.write(f\"{line}\\n\")\n            return\n\n        cur = conn.cursor()\n        cur.execute(\n            \"SELECT sql FROM sqlite_master \"\n            \"WHERE type='table' AND name=? AND name NOT LIKE 'sqlite_%';\",\n            (table_name,),\n        )\n        row = cur.fetchone()\n        if row is None:\n            raise ValueError(f\"Table '{table_name}' not found.\")\n\n        create_sql = row[0]\n        quoted_table = _quote_identifier(table_name)\n\n        with open(output_path, \"w\") as f:\n            f.write(\"BEGIN TRANSACTION;\\n\")\n            f.write(f\"{create_sql.rstrip(';')};\\n\")\n            for data_row in cur.execute(f\"SELECT * FROM {quoted_table"]
[45.316963, "o", "cat > db_dumper.py <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> #!/usr/bin/env python3\r\n\u001b[?2004l\r\u001b[?2004h> import argparse\r\n\u001b[?2004l\r\u001b[?2004h> import os\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> import sys\r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.317404, "i", "}\"):\n                values = \",\".join(_quote_sql_value(v) for v in data_row)\n                f.write(f\"INSERT INTO {quoted_table} VALUES({values});\\n\")\n            f.write(\"COMMIT;\\n\")\n    finally:\n        conn.close()\n\n\ndef list_tables(db_path: str) -> list:\n    \"\"\"Returns list of user tables in the database.\"\"\"\n    if not os.path.exists(db_path):\n        raise FileNotFoundError(f\"Database '{db_path}' not found.\")\n    conn = sqlite3.connect(db_path)\n    cur = conn.cursor()\n    cur.execute(\"SELECT name FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%';\")\n    tables = [r[0] for r in cur.fetchall()]\n    conn.close()\n    return tables\n\n\ndef main():\n    parser = argparse.ArgumentParser(description=\"SQLite Dump Utility\")\n    subparsers = parser.add_subparsers(dest=\"command\", required=True)\n\n    # dump command\n    dump_p = subparsers.add_parser(\"dump\", help=\"Dump database\")\n    dump_p.add_argument(\"db_path\", help=\"Path to SQLite DB\")\n    dump_p.add_argument(\"output_path\", help=\"Output SQL dump fil"]
