e_sql = row[0]\n            f.write("BEGIN TRANSACTION;\\n")\n            f.write(f"{create_sql};\\n")\n\n            quoted_table = _quote_identifier(table_name)\n            for data_row in cur.execute(f"SELECT * FROM {quoted_table}"):\n                values = ",".join(_quote_sql_value(v) for v in data_row)\n                f.write(f"INSERT INTO {quoted_table} VALUES({values});\\n")\n\n            f.write("COMMIT;\\n")\n    finally:\n        conn.close()\n')
