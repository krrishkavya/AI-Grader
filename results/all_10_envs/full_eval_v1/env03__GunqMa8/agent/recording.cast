[21.603077, "i", "tle])\\n\\n    result = subprocess.run(cmd, capture_output=True, text=True)\\n    if result.returncode != 0:\\n        raise RuntimeError(f\"Render failed: {result.stderr}\")\\n')\ns = s.replace('    render_p.add_argument(\"output_file\", help=\"Destination HTML file\")\\n', '    render_p.add_argument(\"output_file\", help=\"Destination HTML file\")\\n    render_p.add_argument(\"--title\", default=None, help=\"Document title\")\\n')\ns = s.replace('        render_document(args.input_file, args.output_file)\\n', '        render_document(args.input_file, args.output_file, title=args.title)\\n')\np.write_text(s)\nPY\nsed -n '1,220p' report_gen.py\npytest -q\n"]
