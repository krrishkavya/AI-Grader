[16.244225, "i", "python - <<'PY'\nfrom pathlib import Path\npath = Path('inventory_cli.py')\ntext = path.read_text()\nold = '''    sql = \"SELECT id, sku, warehouse_id, quantity, aisle FROM inventory WHERE is_damaged = 0 AND sku = ?\"\n    params = [sku]\n\n    cursor.execute(sql, params)\n'''\nnew = '''    sql = \"SELECT id, sku, warehouse_id, quantity, aisle FROM inventory WHERE is_damaged = 0 AND sku = ?\"\n    params = [sku]\n\n    if warehouse is not None:\n        sql += \" AND warehouse_id = ?\"\n        params.append(warehouse)\n\n    cursor.execute(sql, params)\n'''\nif old not in text:\n    raise SystemExit('lookup SQL block not found')\ntext = text.replace(old, new)\nold = '''    look_p = subparsers.add_parser(\"lookup\", help=\"Look up stock by SKU\")\n    look_p.add_argument(\"sku\", help=\"Product SKU\")\n'''\nnew = '''    look_p = subparsers.add_parser(\"lookup\", help=\"Look up stock by SKU\")\n    look_p.add_argument(\"sku\", help=\"Product SKU\")\n    look_p.add_argument(\"--warehouse\", help=\"Filter results by warehouse facility ID\")\n'''\nif old not in text"]
