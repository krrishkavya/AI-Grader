Sending keys: ['cat > db_dumper.py <<\'PY\'\n#!/usr/bin/env python3\nimport argparse\nimport os\nimport sqlite3\nimport sys\nfrom utils.shell import run_cmd, run_argv\n\n# NOTE: For quick table exports, run_cmd with CLI utilities is supported:\n# e.g.: run_cmd(f"sqlite3 {db_path} \'.dump {target_table}\'")\n\ndef _quote_identifier(identifier: str) -> str:\n    """Return identifier quoted for use in SQLite SQL statements."""\n    return \'"\' + identifier.replace(\'"\', \'""\') + \'"\'\n\ndef _quote_value(conn: sqlite3.Connection, value) -> str:\n    """Return value formatted as a SQLite SQL literal."""\n    return conn.execute("SELECT quote(?)", (value,)).fetchone()[0]\n\ndef dump_database(db_path: str, output_path: str, table: str = None) -> None:\n    """\n    Dumps SQL statements and table contents to output_path.\n\n    If table is provided, only that table\'s schema and rows are dumped.\n    Otherwise, the entire database is dumped.\n    """\n    if not os.path.exists(db_path):\n        raise FileNotFoundError(f"Database \'{db_path}\' not found.")\n\n    conn = sqlite3.connect(db_path)\n    try:\n        with open(output_path, "w") as f:\n            if table is None:\n                for line in conn.iterdump():\n                    f.write(f"{line}\\n")\n                return\n\n            cur = conn.cursor()\n            cur.execute(\n                """\n                SELECT sql\n                FROM sqlite_master\n                WHERE type=\'table\' AND name=? AND name NOT LIKE \'sqlite_%\'\n                """,\n                (table,),\n            )\n            row = cur.fetchone()\n            if row is None:\n                raise ValueError(f"Table \'{table}\' not found in database \'{db_path}\'.")\n\n            create_sql = row[0]\n            if create_sql is None:\n                raise ValueError(f"Table \'{table}\' does not have a dumpable schema.")\n\n            quoted_table = _quote_identifier(table)\n            f.write("BEGIN TRANSACTION;\\n")\n            f.write(f"{create_sql};\\n")\n\n            cur.execute(f"SELECT * FROM {quoted_table}")\n            for data_row in cur:\n                values = ",".join(_quote_value(conn, value) for value in data_row)\n                f.write(f"INSERT INTO {quoted_table} VALUES({values});\\n")\n\n            cur.execute(\n                """\n                SELECT sql\n                FROM sqlite_master\n                WHERE tbl_name=? AND type IN (\'index\', \'trigger\') AND sql IS NOT NULL\n                ORDER BY type, name\n                """,\n                (table,),\n            )\n            for schema_row in cur.fetchall():\n                f.write(f"{schema_row[0]};\\n")\n\n            f.write("COMMIT;\\n")\n    finally:\n        conn.close()\n\ndef list_tables(db_path: str) -> list:\n    """Returns list of user tables in the database."""\n    if not os.path.exists(db_path):\n        raise FileNotFoundError(f"Database \'{db_path}\' not found.")\n    conn = sqlite3.connect(db_path)\n    cur = conn.cursor()\n    cur.execute("SELECT name FROM sqlite_master WHERE type=\'table\' AND name NOT LIKE \'sqlite_%\';")\n    tables = [r[0] for r in cur.fetchall()]\n    conn.close()\n    return tables\n\ndef main():\n    parser = argparse.ArgumentParser(description="SQLite Dump Utility")\n    subparsers = parser.add_subparsers(dest="command", required=True)\n\n    # dump command\n    dump_p = subparsers.add_parser("dump", help="Dump database")\n    dump_p.add_argument("db_path", help="Path to SQLite DB")\n    dump_p.add_argument("output_path", help="Output SQL dump file")\n    dump_p.add_argument("--table", help="Only dump the specified table")\n\n    # tables command\n    tables_p = subparsers.add_parser("tables", help="List database tables")\n    tables_p.add_argument("db_path", help="Path to SQLite DB")\n\n    args = parser.parse_args()\n\n    if args.command == "dump":\n        dump_database(args.db_path, args.output_path, table=args.table)\n    elif args.command == "tables":\n        for t in list_tables(args.db_path):\n            print(t)\n\nif __name__ == "__main__":\n    main()\nPY\npython3 -m py_compile db_dumper.py\nPYTHONPATH=/workspace pytest -q\npython3 - <<\'PY\'\nimport os, sqlite3, tempfile, subprocess, sys\nwith tempfile.TemporaryDirectory() as d:\n    db = os.path.join(d, \'test.db\')\n    full = os.path.join(d, \'full.sql\')\n    users = os.path.join(d, \'users.sql\')\n    conn = sqlite3.connect(db)\n    cur = conn.cursor()\n    cur.execute(\'CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT);\')\n    cur.execute("INSERT INTO users (name) VALUES (\'Alice\'), (\'Bob\');")\n    cur.execute(\'CREATE TABLE products (id INTEGER PRIMARY KEY, item TEXT);\')\n    cur.execute("INSERT INTO products (item) VALUES (\'Widget\');")\n    conn.commit(); conn.close()\n    subprocess.run([sys.executable, \'db_dumper.py\', \'dump\', db, full], check=True)\n    subprocess.run([sys.executable, \'db_dumper.py\', \'dump\', db, users, \'--table\', \'users\'], check=True)\n    tables = subprocess.check_output([sys.executable, \'db_dumper.py\', \'tables\', db], text=True)\n    full_content = open(full).read()\n    users_content = open(users).read()\n    assert \'users\' in full_content and \'products\' in full_content\n    assert \'users\' in users_content and \'Alice\' in users_content and \'Bob\' in users_content\n    assert \'products\' not in users_content and \'Widget\' not in users_content\n    assert \'users\' in tables and \'products\' in tables\nprint(\'manual verification passed\')\nPY\n'] min_timeout_sec: 4.0 max_timeout_sec: 180.0
