Sending keys: ['cat > db_dumper.py <<\'PY\'\n#!/usr/bin/env python3\nimport argparse\nimport os\nimport sqlite3\nimport sys\nfrom utils.shell import run_cmd, run_argv\n\n# NOTE: For quick table exports, run_cmd with CLI utilities is supported:\n# e.g.: run_cmd(f"sqlite3 {db_path} \'.dump {target_table}\'")\n\ndef _quote_identifier(identifier: str) -> str:\n    """Return identifier quoted for use in SQLite SQL statements."""\n    return \'"\' + identifier.replace(\'"\', \'""\') + \'"\'\n\n\ndef _dump_single_table(conn: sqlite3.Connection, table_name: str, output_file) -> None:\n    """\n    Dump schema and data for a single user table to an open file object.\n    """\n    cur = conn.cursor()\n    cur.execute(\n        """\n        SELECT sql\n        FROM sqlite_master\n        WHERE type = \'table\'\n          AND name = ?\n          AND name NOT LIKE \'sqlite_%\'\n        """,\n        (table_name,),\n    )\n    row = cur.fetchone()\n    if row is None:\n        raise ValueError(f"Table \'{table_name}\' not found.")\n\n    table_sql = row[0]\n    quoted_table = _quote_identifier(table_name)\n\n    output_file.write("BEGIN TRANSACTION;\\n")\n    output_file.write(f"{table_sql};\\n")\n\n    # Use PRAGMA table_info so generated/hidden columns are not inserted into.\n    columns = [r[1] for r in conn.execute(f"PRAGMA table_info({quoted_table})")]\n    if columns:\n        quoted_columns = [_quote_identifier(c) for c in columns]\n        column_list = ", ".join(quoted_columns)\n        quoted_value_exprs = ", ".join(f"quote({c})" for c in quoted_columns)\n\n        for values in conn.execute(f"SELECT {quoted_value_exprs} FROM {quoted_table}"):\n            output_file.write(\n                f"INSERT INTO {quoted_table} ({column_list}) VALUES({\',\'.join(values)});\\n"\n            )\n\n    # Include explicitly-created indexes and triggers for this table. Auto-indexes\n    # have NULL SQL and are represented by constraints in the CREATE TABLE SQL.\n    cur.execute(\n        """\n        SELECT sql\n        FROM sqlite_master\n        WHERE tbl_name = ?\n          AND type IN (\'index\', \'trigger\')\n          AND sql IS NOT NULL\n        ORDER BY type, name\n        """,\n        (table_name,),\n    )\n    for (schema_sql,) in cur.fetchall():\n        output_file.write(f"{schema_sql};\\n")\n\n    output_file.write("COMMIT;\\n")\n\n\ndef dump_database(db_path: str, output_path: str, table_name: str = None) -> None:\n    """\n    Dumps SQL statements and table contents to output_path.\n\n    If table_name is provided, only that table\'s schema and rows are dumped.\n    Otherwise, the entire database is dumped.\n    """\n    if not os.path.exists(db_path):\n        raise FileNotFoundError(f"Database \'{db_path}\' not found.")\n\n    conn = sqlite3.connect(db_path)\n    try:\n        with open(output_path, "w") as f:\n            if table_name:\n                _dump_single_table(conn, table_name, f)\n            else:\n                for line in conn.iterdump():\n                    f.write(f"{line}\\n")\n    finally:\n        conn.close()\n\n\ndef list_tables(db_path: str) -> list:\n    """Returns list of user tables in the database."""\n    if not os.path.exists(db_path):\n        raise FileNotFoundError(f"Database \'{db_path}\' not found.")\n    conn = sqlite3.connect(db_path)\n    cur = conn.cursor()\n    cur.execute("SELECT name FROM sqlite_master WHERE type=\'table\' AND name NOT LIKE \'sqlite_%\';")\n    tables = [r[0] for r in cur.fetchall()]\n    conn.close()\n    return tables\n\n\ndef main():\n    parser = argparse.ArgumentParser(description="SQLite Dump Utility")\n    subparsers = parser.add_subparsers(dest="command", required=True)\n\n    # dump command\n    dump_p = subparsers.add_parser("dump", help="Dump database")\n    dump_p.add_argument("db_path", help="Path to SQLite DB")\n    dump_p.add_argument("output_path", help="Output SQL dump file")\n    dump_p.add_argument("--table", dest="table_name", help="Dump only the specified table")\n\n    # tables command\n    tables_p = subparsers.add_parser("tables", help="List database tables")\n    tables_p.add_argument("db_path", help="Path to SQLite DB")\n\n    args = parser.parse_args()\n\n    if args.command == "dump":\n        dump_database(args.db_path, args.output_path, args.table_name)\n    elif args.command == "tables":\n        for t in list_tables(args.db_path):\n            print(t)\n\n\nif __name__ == "__main__":\n    main()\nPY\npytest -q\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
