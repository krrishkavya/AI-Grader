Sending keys: ['python3 - <<\'PY\'\nfrom pathlib import Path\np = Path(\'archiver.py\')\ns = p.read_text()\n\n# Ensure required imports are present (idempotent safety).\nif \'import fnmatch\\n\' not in s:\n    s = s.replace(\'import argparse\\n\', \'import argparse\\nimport fnmatch\\n\')\nif \'import tarfile\\n\' not in s:\n    s = s.replace(\'import sys\\n\', \'import sys\\nimport tarfile\\n\')\nif \'from typing import Optional\\n\' not in s:\n    s = s.replace(\'import tarfile\\n\', \'import tarfile\\nfrom typing import Optional\\n\')\n\nstart = s.index(\'def create_archive(\')\nend = s.index(\'\\ndef list_archive\', start)\nnew_block = \'\'\'def _matches_exclude(archive_name: str, pattern: str) -> bool:\n    """\n    Return True when an archive member name matches the exclude pattern.\n\n    Archive members are stored with names like ``./file.txt`` while users\n    generally provide source-relative patterns like ``*.tmp`` or ``cache/*``.\n    Check both forms so either style works.\n    """\n    rel_name = archive_name[2:] if archive_name.startswith("./") else archive_name\n    rel_pattern = pattern[2:] if pattern.startswith("./") else pattern\n\n    if rel_name in ("", "."):\n        return False\n\n    name_candidates = {archive_name, rel_name, f"./{rel_name}"}\n    pattern_candidates = {pattern, rel_pattern, f"./{rel_pattern}"}\n\n    for name in name_candidates:\n        for pat in pattern_candidates:\n            if fnmatch.fnmatchcase(name, pat):\n                return True\n\n    # Treat directory-wide patterns such as "cache/*" as matching the\n    # directory entry itself too; this prevents tarfile from descending into it.\n    if rel_pattern.endswith("/*") and rel_name == rel_pattern[:-2].rstrip("/"):\n        return True\n\n    # If a plain directory name is excluded (e.g. "cache"), exclude its\n    # contents as well.\n    if not any(ch in rel_pattern for ch in "*?["):\n        directory_pattern = rel_pattern.rstrip("/")\n        if rel_name.startswith(directory_pattern + "/"):\n            return True\n\n    return False\n\n\ndef create_archive(source_dir: str, output_path: str, exclude: Optional[str] = None) -> None:\n    """\n    Creates a compressed tar.gz archive from source_dir.\n\n    If exclude is provided, files/directories matching the glob-style pattern\n    are omitted from the archive.\n    """\n    if not os.path.exists(source_dir):\n        raise FileNotFoundError(f"Source directory \'{source_dir}\' does not exist.")\n\n    if exclude:\n        def exclude_filter(tarinfo: tarfile.TarInfo) -> Optional[tarfile.TarInfo]:\n            if _matches_exclude(tarinfo.name, exclude):\n                return None\n            return tarinfo\n\n        with tarfile.open(output_path, "w:gz") as archive:\n            archive.add(source_dir, arcname=".", filter=exclude_filter)\n        return\n\n    # Existing codebase pattern: uses run_cmd with string interpolation\n    cmd = f"tar -czf {output_path} -C {source_dir} ."\n    run_cmd(cmd)\n\'\'\'\ns = s[:start] + new_block + s[end+1:]\np.write_text(s)\nPY\nsed -n \'1,280p\' archiver.py\nPYTHONPATH=. pytest -q\n'] min_timeout_sec: 5.0 max_timeout_sec: 180.0
