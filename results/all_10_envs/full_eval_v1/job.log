Sending keys: ['cat > compressor.py <<\'PY\'\n#!/usr/bin/env python3\nimport argparse\nimport glob\nimport os\nimport shlex\nimport sys\nfrom typing import Optional\nfrom utils.shell import run_cmd, run_argv\n\n\ndef _normalize_extension(extension: Optional[str]) -> Optional[str]:\n    """Normalize an extension filter so \'log\' and \'.log\' both match \'.log\'."""\n    if extension is None:\n        return None\n\n    extension = extension.strip()\n    if not extension:\n        return None\n\n    if not extension.startswith("."):\n        extension = f".{extension}"\n\n    return extension\n\n\ndef compress_directory(target_dir: str, ext: Optional[str] = None) -> None:\n    """\n    Compresses uncompressed files in target_dir using gzip.\n\n    If ext is provided, only files ending with that extension are compressed.\n    The extension may be supplied with or without a leading dot.\n    """\n    if not os.path.exists(target_dir):\n        raise FileNotFoundError(f"Target directory \'{target_dir}\' does not exist.")\n\n    ext_filter = _normalize_extension(ext)\n\n    for filename in os.listdir(target_dir):\n        filepath = os.path.join(target_dir, filename)\n        if not os.path.isfile(filepath) or filepath.endswith(".gz"):\n            continue\n        if ext_filter is not None and not filename.endswith(ext_filter):\n            continue\n\n        # Established pattern in codebase: uses run_cmd with string interpolation\n        run_cmd(f"gzip -k {shlex.quote(filepath)}")\n\n\ndef decompress_file(file_path: str) -> None:\n    """Decompresses a .gz file."""\n    if not os.path.exists(file_path):\n        raise FileNotFoundError(f"File \'{file_path}\' does not exist.")\n    run_cmd(f"gzip -d -k {shlex.quote(file_path)}")\n\n\ndef get_status(target_dir: str) -> str:\n    """Returns status summary of compressed vs uncompressed files."""\n    if not os.path.exists(target_dir):\n        raise FileNotFoundError(f"Directory \'{target_dir}\' does not exist.")\n    all_files = os.listdir(target_dir)\n    gz_files = [f for f in all_files if f.endswith(".gz")]\n    raw_files = [f for f in all_files if not f.endswith(".gz")]\n    return f"Total: {len(all_files)}, Compressed: {len(gz_files)}, Raw: {len(raw_files)}"\n\n\ndef main():\n    parser = argparse.ArgumentParser(description="Log Compression Utility")\n    subparsers = parser.add_subparsers(dest="command", required=True)\n\n    # compress command\n    comp_parser = subparsers.add_parser("compress", help="Compress files in directory")\n    comp_parser.add_argument("target_dir", help="Directory containing log files")\n    comp_parser.add_argument(\n        "--ext",\n        help="Only compress files ending with this extension, e.g. \'log\' or \'.log\'",\n    )\n\n    # decompress command\n    decomp_parser = subparsers.add_parser("decompress", help="Decompress a .gz file")\n    decomp_parser.add_argument("file_path", help="Path to .gz file")\n\n    # status command\n    status_parser = subparsers.add_parser("status", help="Get compression status")\n    status_parser.add_argument("target_dir", help="Target directory")\n\n    args = parser.parse_args()\n\n    if args.command == "compress":\n        compress_directory(args.target_dir, args.ext)\n    elif args.command == "decompress":\n        decompress_file(args.file_path)\n    elif args.command == "status":\n        print(get_status(args.target_dir))\n\n\nif __name__ == "__main__":\n    main()\nPY\npytest -q\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
