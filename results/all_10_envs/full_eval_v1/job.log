Sending keys: ['cat > archiver.py <<\'PY\'\n#!/usr/bin/env python3\nimport argparse\nimport fnmatch\nimport os\nimport sys\nimport tarfile\nfrom typing import Optional\n\nfrom utils.shell import run_cmd, run_argv\n\n\ndef _matches_exclude(archive_name: str, pattern: Optional[str]) -> bool:\n    """\n    Return True when archive_name should be excluded by pattern.\n\n    Names stored by this utility are usually prefixed with \'./\' because the\n    source directory is archived as \'.\'.  For user-friendly CLI behavior,\n    match both the stored archive name (for example \'./cache/file.log\') and\n    the normalized relative name (for example \'cache/file.log\').  Also match\n    the basename so simple patterns such as \'debug.log\' work at any depth.\n    """\n    if not pattern:\n        return False\n\n    normalized = archive_name.replace(os.sep, "/")\n    relative = normalized\n    while relative.startswith("./"):\n        relative = relative[2:]\n    relative = relative.rstrip("/")\n\n    # Never exclude the archive root itself for broad patterns like \'*\'.\n    if normalized == "." or relative == "":\n        return False\n\n    candidates = [normalized, relative]\n    basename = os.path.basename(relative)\n    if basename:\n        candidates.append(basename)\n\n    return any(fnmatch.fnmatchcase(candidate, pattern) for candidate in candidates)\n\n\ndef create_archive(\n    source_dir: str,\n    output_path: str,\n    exclude: Optional[str] = None,\n    *,\n    exclude_pattern: Optional[str] = None,\n) -> None:\n    """\n    Creates a compressed tar.gz archive from source_dir.\n\n    If exclude (or exclude_pattern) is provided, archive entries matching the\n    shell-style glob pattern are omitted. Examples: \'*.tmp\', \'*.log\', \'cache/*\'.\n    """\n    if not os.path.exists(source_dir):\n        raise FileNotFoundError(f"Source directory \'{source_dir}\' does not exist.")\n\n    # Backward-compatible alias for callers that use a descriptive keyword.\n   