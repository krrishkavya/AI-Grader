[53.936395, "i", "cat > archiver.py <<'PY'\n#!/usr/bin/env python3\nimport argparse\nimport fnmatch\nimport os\nimport sys\nimport tarfile\nfrom utils.shell import run_cmd, run_argv\n\n\ndef create_archive(source_dir: str, output_path: str, exclude_pattern: str = None) -> None:\n    \"\"\"\n    Creates a compressed tar.gz archive from source_dir.\n\n    If exclude_pattern is provided, files matching that shell-style pattern are\n    omitted from the archive. Patterns are matched against archive-relative\n    paths (for example, \"cache/file.tmp\") and file basenames (for example,\n    \"file.tmp\"), so patterns such as \"*.tmp\", \"*.log\", and \"cache/*\" work as\n    expected.\n    \"\"\"\n    if not os.path.exists(source_dir):\n        raise FileNotFoundError(f\"Source directory '{source_dir}' does not exist.\")\n\n    def matches_exclude(tarinfo: tarfile.TarInfo) -> bool:\n        if not exclude_pattern or not tarinfo.isfile():\n            return False\n\n        # Entries are archived under '.', so normalize './cache/a.tmp' to\n        # 'cache/a.tmp' for matching a"]
