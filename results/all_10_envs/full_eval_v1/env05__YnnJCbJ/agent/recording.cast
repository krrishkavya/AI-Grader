[61.41248, "o", "#!/usr/bin/env python3\r\nimport argparse\r\nimport os\r\nimport sqlite3\r\nimport sys\r\nfrom utils.shell import run_cmd, run_argv\r\n\r\n# NOTE: For quick table exports, run_cmd with CLI utilities is supported:\r\n# e.g.: run_cmd(f\"sqlite3 {db_path} '.dump {target_table}'\")\r\n\r\ndef _quote_identifier(identifier: str) -> str:\r\n    \"\"\"Return identifier quoted for use in SQLite SQL statements.\"\"\"\r\n    return '\"' + identifier.replace('\"', '\"\"') + '\"'\r\n\r\n\r\ndef _dump_single_table(conn: sqlite3.Connection, table_name: str, output_file) -> None:\r\n    \"\"\"\r\n    Dump schema and data for a single user table to an open file object.\r\n    \"\"\"\r\n    cur = conn.cursor()\r\n    cur.execute(\r\n        \"\"\"\r\n        SELECT sql\r\n        FROM sqlite_master\r\n        WHERE type = 'table'\r\n          AND name = ?\r\n          AND name NOT LIKE 'sqlite_%'\r\n        \"\"\",\r\n        (table_name,),\r\n    )\r\n    row = cur.fetchone()\r\n    if row is None:\r\n        raise ValueError(f\"Table '{table_name}' not found.\")\r\n\r\n    table_sql = row[0]\r\n    quoted_table = _quote"]
[61.414446, "o", "_identifier(table_name)\r\n\r\n    output_file.write(\"BEGIN TRANSACTION;\\n\")\r\n    output_file.write(f\"{table_sql};\\n\")\r\n\r\n    # Use PRAGMA table_info so generated/hidden columns are not inserted into.\r\n    columns = [r[1] for r in conn.execute(f\"PRAGMA table_info({quoted_table})\")]\r\n    if columns:\r\n        quoted_columns = [_quote_identifier(c) for c in columns]\r\n        column_list = \", \".join(quoted_columns)\r\n        quoted_value_exprs = \", \".join(f\"quote({c})\" for c in quoted_columns)\r\n\r\n        for values in conn.execute(f\"SELECT {quoted_value_exprs} FROM {quoted_table}\"):\r\n            output_file.write(\r\n                f\"INSERT INTO {quoted_table} ({column_list}) VALUES({','.join(values)});\\n\"\r\n            )\r\n\r\n    # Include explicitly-created indexes and triggers for this table. Auto-indexes\r\n    # have NULL SQL and are represented by constraints in the CREATE TABLE SQL.\r\n    cur.execute(\r\n        \"\"\"\r\n        SELECT sql\r\n        FROM sqlite_master\r\n        WHERE tbl_name = ?\r\n          AND type IN ('inde"]
[61.414627, "o", "x', 'trigger')\r\n          AND sql IS NOT NULL\r\n        ORDER BY type, name\r\n        \"\"\",\r\n        (table_name,),\r\n    )\r\n    for (schema_sql,) in cur.fetchall():\r\n        output_file.write(f\"{schema_sql};\\n\")\r\n\r\n    output_file.write(\"COMMIT;\\n\")\r\n\r\n\r\ndef dump_database(db_path: str, output_path: str, table_name: str = None) -> None:\r\n    \"\"\"\r\n    Dumps SQL statements and table contents to output_path.\r\n\r\n    If table_name is provided, only that table's schema and rows are dumped.\r\n    Otherwise, the entire database is dumped.\r\n    \"\"\"\r\n    if not os.path.exists(db_path):\r\n        raise FileNotFoundError(f\"Database '{db_path}' not found.\")\r\n\r\n    conn = sqlite3.connect(db_path)\r\n    try:\r\n        with open(output_path, \"w\") as f:\r\n            if table_name:\r\n                _dump_single_table(conn, table_name, f)\r\n            else:\r\n                for line in conn.iterdump():\r\n                    f.write(f\"{line}\\n\")\r\n    finally:\r\n        conn.close()\r\n\r\n\r\ndef list_tables(db_path: str) -> list:\r\n    \"\"\"Retur"]
[61.414715, "o", "ns list of user tables in the database.\"\"\"\r\n    if not os.path.exists(db_path):\r\n        raise FileNotFoundError(f\"Database '{db_path}' not found.\")\r\n    conn = sqlite3.connect(db_path)\r\n    cur = conn.cursor()\r\n    cur.execute(\"SELECT name FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%';\")\r\n    tables = [r[0] for r in cur.fetchall()]\r\n    conn.close()\r\n    return tables\r\n\r\n\r\ndef main():\r\n    parser = argparse.ArgumentParser(description=\"SQLite Dump Utility\")\r\n    subparsers = parser.add_subparsers(dest=\"command\", required=True)\r\n\r\n    # dump command\r\n    dump_p = subparsers.add_parser(\"dump\", help=\"Dump database\")\r\n    dump_p.add_argument(\"db_path\", help=\"Path to SQLite DB\")\r\n    dump_p.add_argument(\"output_path\", help=\"Output SQL dump file\")\r\n    dump_p.add_argument(\"--table\", dest=\"table_name\", help=\"Dump only the specified table\")\r\n\r\n    # tables command\r\n    tables_p = subparsers.add_parser(\"tables\", help=\"List database tables\")\r\n    tables_p.add_argument(\"db_path\", help=\"Path to SQLit"]
[61.414759, "o", "e DB\")\r\n\r\n    args = parser.parse_args()\r\n\r\n    if args.command == \"dump\":\r\n        dump_database(args.db_path, args.output_path, args.table_name)\r\n    elif args.command == \"tables\":\r\n        for t in list_tables(args.db_path):\r\n            print(t)\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n"]
