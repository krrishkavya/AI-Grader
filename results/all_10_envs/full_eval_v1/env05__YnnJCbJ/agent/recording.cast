[91.493744, "i", "echo \"tmpdir=$tmpdir\"\npython - <<PY\nimport os, sqlite3\npath = os.path.join('$tmpdir', 'test.db')\nconn = sqlite3.connect(path)\ncur = conn.cursor()\ncur.execute(\"CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT);\")\ncur.execute(\"INSERT INTO users (name) VALUES ('Alice'), ('Bob');\")\ncur.execute(\"CREATE TABLE products (id INTEGER PRIMARY KEY, item TEXT);\")\ncur.execute(\"INSERT INTO products (item) VALUES ('Widget');\")\nconn.commit()\nconn.close()\nprint(path)\nPY\npython db_dumper.py tables \"$tmpdir/test.db\"\npython db_dumper.py dump \"$tmpdir/test.db\" \"$tmpdir/full.sql\"\npython db_dumper.py dump \"$tmpdir/test.db\" \"$tmpdir/users.sql\" --table users\ncat \"$tmpdir/users.sql\"\npython - <<PY\nfrom pathlib import Path\nbase = Path('$tmpdir')\nfull = (base / 'full.sql').read_text()\nusers = (base / 'users.sql').read_text()\nassert 'users' in full and 'products' in full\nassert 'CREATE TABLE users' in users\nassert 'Alice' in users and 'Bob' in users\nassert 'products' not in users\nassert 'Widget' not in users\nprint('manual --table vali"]
[91.493841, "i", "dation passed')\nPY\npython -m py_compile db_dumper.py\n"]
