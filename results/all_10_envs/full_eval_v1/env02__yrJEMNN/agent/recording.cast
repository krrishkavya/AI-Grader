[37.935174, "i", "tmp=$(mktemp -d); printf 'a' > \"$tmp/app.log\"; printf 'b' > \"$tmp/notes.txt\"; printf 'c' > \"$tmp/error.log\"; python3 compressor.py compress \"$tmp\" --ext log; echo \"--ext result:\"; find \"$tmp\" -maxdepth 1 -type f -printf '%f\\n' | sort; rm -rf \"$tmp\"\n"]
