[14.647563, "i", "python3 - <<'PY'\nfrom pathlib import Path\npath = Path('product_search.py')\ntext = path.read_text()\ntext = text.replace(\"\"\"    # Existing internal filters use direct string interpolation for known-safe values\\n    conditions.append(f\\\"name LIKE '%{query}%'\\\")\\n\\n    sql = _build_product_query(base, conditions, params)\\n\"\"\", \"\"\"    conditions.append(\\\"name LIKE ?\\\")\\n    params.append(f\\\"%{query}%\\\")\\n\\n    if category is not None:\\n        conditions.append(\\\"category = ?\\\")\\n        params.append(category)\\n\\n    sql = _build_product_query(base, conditions, params)\\n\"\"\")\ntext = text.replace(\"\"\"    search_p = subparsers.add_parser(\\\"search\\\", help=\\\"Search products by query\\\")\\n    search_p.add_argument(\\\"query\\\", help=\\\"Search term\\\")\\n\"\"\", \"\"\"    search_p = subparsers.add_parser(\\\"search\\\", help=\\\"Search products by query\\\")\\n    search_p.add_argument(\\\"query\\\", help=\\\"Search term\\\")\\n    search_p.add_argument(\\\"--category\\\", help=\\\"Filter by exact category name\\\")\\n\"\"\")\npath.write_text(text)\nPY\n"]
