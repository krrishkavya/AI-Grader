[63.804955, "o", "#!/usr/bin/env python3\r\nimport argparse\r\nimport fnmatch\r\nimport os\r\nimport sys\r\nimport tarfile\r\nfrom utils.shell import run_cmd, run_argv\r\n\r\ndef create_archive(source_dir: str, output_path: str, exclude_pattern: str = None) -> None:\r\n    \"\"\"\r\n    Creates a compressed tar.gz archive from source_dir.\r\n\r\n    If exclude_pattern is provided, archive-relative paths matching that\r\n    shell-style pattern (for example, \"*.tmp\", \"*.log\", or \"cache/*\")\r\n    are omitted from the generated archive.\r\n    \"\"\"\r\n    if not os.path.exists(source_dir):\r\n        raise FileNotFoundError(f\"Source directory '{source_dir}' does not exist.\")\r\n\r\n    def should_exclude(member_name: str) -> bool:\r\n        if not exclude_pattern:\r\n            return False\r\n\r\n        # tarfile stores entries below source_dir with names like\r\n        # \"./file.txt\".  Match both that name and the cleaner relative\r\n        # path so CLI patterns such as \"cache/*\" behave naturally.\r\n        rel_name = member_name[2:] if member_name.startswith(\"./\") else memb"]
