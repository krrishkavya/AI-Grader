[67.290631, "i", "tmp=$(mktemp -d)\nmkdir -p \"$tmp/src/cache\" \"$tmp/out\"\nprintf 'keep' > \"$tmp/src/keep.txt\"\nprintf 'tmp' > \"$tmp/src/remove.tmp\"\nprintf 'log' > \"$tmp/src/app.log\"\nprintf 'cache' > \"$tmp/src/cache/data.bin\"\npython3 archiver.py create \"$tmp/src\" \"$tmp/all.tar.gz\"\necho '--- all archive ---'\npython3 archiver.py list \"$tmp/all.tar.gz\"\npython3 archiver.py create \"$tmp/src\" \"$tmp/no-tmp.tar.gz\" --exclude '*.tmp'\necho '--- no tmp archive ---'\npython3 archiver.py list \"$tmp/no-tmp.tar.gz\"\npython3 archiver.py create \"$tmp/src\" \"$tmp/no-cache.tar.gz\" --exclude 'cache/*'\necho '--- no cache archive ---'\npython3 archiver.py list \"$tmp/no-cache.tar.gz\"\npython3 archiver.py extract \"$tmp/no-cache.tar.gz\" \"$tmp/out\"\necho '--- extracted no-cache files ---'\nfind \"$tmp/out\" -type f -printf '%P\\n' | sort\nrm -rf \"$tmp\"\n"]
