         )\n            result = cur.fetchone()\n            if result is None:\n                raise ValueError(f"Table '{table_name}' not found.")\n\n            table_sql = result[0].rstrip()\n            quoted_table = _quote_identifier(table_name)\n\n            f.write("BEGIN TRANSACTION;\\n")\n            f.write(f"{table_sql}{'' if table_sql.endswith(';') else ';'}\\n")\n\n            cur.execute(f"SELECT * FROM {quoted_table};")\n            for row in cur.fetchall():\n                values = ",".join(_quote_row_values(conn, row))\n                f.write(f"INSERT INTO {quoted_table} VALUES({values});\\n")\n\n            f.write("COMMIT;\\n")\n    finally:\n        conn.close()\n''')
