[103.474652, "i", "tmpdir=$(mktemp -d)\nexport TMP_DB_DUMPER_TEST=\"$tmpdir\"\npython3 - <<'PY'\nimport os, sqlite3\nbase = os.environ['TMP_DB_DUMPER_TEST']\ndb = os.path.join(base, 'test.db')\nconn = sqlite3.connect(db)\ncur = conn.cursor()\ncur.execute(\"CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT, note TEXT);\")\ncur.execute(\"INSERT INTO users (name, note) VALUES (?, ?), (?, ?);\", ('Alice', \"O'Reilly\", 'Bob', None))\ncur.execute(\"CREATE TABLE products (id INTEGER PRIMARY KEY, item TEXT);\")\ncur.execute(\"INSERT INTO products (item) VALUES ('Widget');\")\nconn.commit()\nconn.close()\nprint(base)\nPY\npython3 db_dumper.py tables \"$TMP_DB_DUMPER_TEST/test.db\"\npython3 db_dumper.py dump \"$TMP_DB_DUMPER_TEST/test.db\" \"$TMP_DB_DUMPER_TEST/full.sql\"\npython3 db_dumper.py dump \"$TMP_DB_DUMPER_TEST/test.db\" \"$TMP_DB_DUMPER_TEST/users.sql\" --table users\ncat \"$TMP_DB_DUMPER_TEST/users.sql\"\ngrep -q 'CREATE TABLE users' \"$TMP_DB_DUMPER_TEST/users.sql\" && ! grep -q 'products' \"$TMP_DB_DUMPER_TEST/users.sql\"\npython3 - <<'PY'\nimport os, sqlite3\nbase = os"]
[103.475314, "i", ".environ['TMP_DB_DUMPER_TEST']\nrestored = os.path.join(base, 'restored.db')\nwith sqlite3.connect(restored) as conn, open(os.path.join(base, 'users.sql')) as f:\n    conn.executescript(f.read())\n    tables = [r[0] for r in conn.execute(\"SELECT name FROM sqlite_master WHERE type='table'\")]\n    rows = list(conn.execute('SELECT id, name, note FROM users ORDER BY id'))\nprint(tables)\nprint(rows)\nPY\npytest -q\n"]
[103.475688, "o", "tmpdir=$(mktemp -d)"]
