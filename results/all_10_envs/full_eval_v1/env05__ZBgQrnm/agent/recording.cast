[84.02864, "i", "cat > db_dumper.py <<'PY'\n#!/usr/bin/env python3\nimport argparse\nimport os\nimport sqlite3\nimport sys\nfrom utils.shell import run_cmd, run_argv\n\n# NOTE: For quick table exports, run_cmd with CLI utilities is supported:\n# e.g.: run_cmd(f\"sqlite3 {db_path} '.dump {target_table}'\")\n\ndef _quote_identifier(identifier: str) -> str:\n    \"\"\"Return identifier quoted for use in SQLite SQL statements.\"\"\"\n    return '\"' + identifier.replace('\"', '\"\"') + '\"'\n\n\ndef _quote_row_values(conn: sqlite3.Connection, row: tuple) -> tuple:\n    \"\"\"Return SQLite SQL literals for every value in a row.\"\"\"\n    placeholders = \", \".join(\"quote(?)\" for _ in row)\n    return conn.execute(f\"SELECT {placeholders}\", row).fetchone()\n\n\ndef dump_database(db_path: str, output_path: str, table_name: str = None, *, table: str = None) -> None:\n    \"\"\"\n    Dumps SQL statements and table contents to output_path.\n\n    If table_name (or keyword-only table) is provided, only that table's schema\n    definition and rows are dumped. Otherwise, the entire databa"]
[84.030177, "i", "se is dumped.\n    \"\"\"\n    if table is not None:\n        if table_name is not None and table_name != table:\n            raise ValueError(\"Conflicting table names provided.\")\n        table_name = table\n\n    if not os.path.exists(db_path):\n        raise FileNotFoundError(f\"Database '{db_path}' not found.\")\n\n    conn = sqlite3.connect(db_path)\n    try:\n        if table_name is None:\n            with open(output_path, \"w\") as f:\n                for line in conn.iterdump():\n                    f.write(f\"{line}\\n\")\n            return\n\n        cur = conn.cursor()\n        cur.execute(\n            \"SELECT sql FROM sqlite_master \"\n            \"WHERE type='table' AND name=? AND name NOT LIKE 'sqlite_%';\",\n            (table_name,),\n        )\n        result = cur.fetchone()\n        if result is None:\n            raise ValueError(f\"Table '{table_name}' not found.\")\n\n        table_sql = result[0].rstrip()\n        quoted_table = _quote_identifier(table_name)\n\n        with open(output_path, \"w\") as f:\n            f.write(\"BEG"]
