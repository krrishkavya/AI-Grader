[84.031041, "o", "# NOTE: For quick table exports, run_cmd with CLI utilities is supported:\r\n\u001b[?2004l\r\u001b[?2004h> # e.g.: run_cmd(f\"sqlite3 {db_path} '.dump {target_table}'\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def _quote_identifier(identifier: str) -> str:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.031495, "o", "    \"\"\"Return identifier quoted for use in SQLite SQL statements.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     return '\"' + identifier.replace('\"', '\"\"') + '\"'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.034069, "o", "def _quote_row_values(conn: sqlite3.Connection, row: tuple) -> tuple:\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"Return SQLite SQL literals for every value in a row.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     placeholders = \", \".join(\"quote(?)\" for _ in row)\r\n\u001b[?2004l\r\u001b[?2004h>     return conn.execute(f\"SELECT {placeholders}\", row).fetchone()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def dump_database(db_path: str, output_path: str, table_name: str = None, *, table: str = None) -> None:\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     Dumps SQL statements and table contents to output_path.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     If table_name (or keyword-only table) is provided, only that table's schema\r\n\u001b[?2004l\r\u001b[?2004h>     definition and rows are dumped. Otherwise, the entire database is dumped.\r\n\u001b[?2004l\r\u001b[?2004h"]
[84.03432, "o", ">     \"\"\"\r\n\u001b[?2004l\r"]
[84.0346, "o", "\u001b[?2004h>     if table is not None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.034833, "o", "        if table_name is not None and table_name != table:\r\n"]
[84.035225, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[84.036356, "o", "            raise ValueError(\"Conflicting table names provided.\")\r\n\u001b[?2004l\r\u001b[?2004h>         table_name = table\r\n"]
[84.036667, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     if not os.path.exists(db_path):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.036746, "o", "        raise FileNotFoundError(f\"Database '{db_path}' not found.\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[84.037079, "o", "> \r\n\u001b[?2004l\r"]
[84.03734, "o", "\u001b[?2004h>     conn = sqlite3.connect(db_path)\r\n\u001b[?2004l\r\u001b[?2004h>     try:\r\n\u001b[?2004l\r\u001b[?2004h>         if table_name is None:\r\n\u001b[?2004l\r\u001b[?2004h>             with open(output_path, \"w\") as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.037569, "o", "                for line in conn.iterdump():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.037769, "o", "                    f.write(f\"{line}\\n\")\r\n\u001b[?2004l\r\u001b[?2004h>             return\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.037988, "o", "        cur = conn.cursor()\r\n\u001b[?2004l\r\u001b[?2004h>         cur.execute(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.038235, "o", "            \"SELECT sql FROM sqlite_master \"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.038416, "o", "            \"WHERE type='table' AND name=? AND name NOT LIKE 'sqlite_%';\",\r\n\u001b[?2004l\r\u001b[?2004h>             (table_name,),\r\n\u001b[?2004l\r"]
[84.038757, "o", "\u001b[?2004h>         )\r\n\u001b[?2004l\r\u001b[?2004h>         result = cur.fetchone()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.039198, "o", "        if result is None:\r\n\u001b[?2004l\r\u001b[?2004h>             raise ValueError(f\"Table '{table_name}' not found.\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.039319, "o", "        table_sql = result[0].rstrip()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.039662, "o", "        quoted_table = _quote_identifier(table_name)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>         with open(output_path, \"w\") as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.039953, "o", "            f.write(\"BEGIN TRANSACTION;\\n\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.040547, "o", "            f.write(f\"{table_sql}{'' if table_sql.endswith(';') else ';'}\\n\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.040645, "o", "            cur.execute(f\"SELECT * FROM {quoted_table};\")\r\n\u001b[?2004l\r\u001b[?2004h>             for row in cur.fetchall():\r\n\u001b[?2004l\r\u001b[?2004h>                 values = \",\".join(_quote_row_values(conn, row))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.040911, "o", "                f.write(f\"INSERT INTO {quoted_table} VALUES({values});\\n\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[84.041182, "o", "\u001b[?2004h>             f.write(\"COMMIT;\\n\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.041465, "o", "    finally:\r\n\u001b[?2004l\r\u001b[?2004h>         conn.close()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.041723, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def list_tables(db_path: str) -> list:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.041996, "o", "    \"\"\"Returns list of user tables in the database.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     if not os.path.exists(db_path):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.042207, "o", "        raise FileNotFoundError(f\"Database '{db_path}' not found.\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.042412, "o", "    conn = sqlite3.connect(db_path)"]
[84.042682, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.043503, "o", "    cur = conn.cursor()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.04382, "o", "    cur.execute(\"SELECT name FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%';\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.044193, "o", "    tables = [r[0] for r in cur.fetchall()]\r\n\u001b[?2004l\r\u001b[?2004h>     conn.close()\r\n\u001b[?2004l\r\u001b[?2004h>     return tables\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def main():\r\n\u001b[?2004l\r\u001b[?2004h>     parser = argparse.ArgumentParser(description=\"SQLite Dump Utility\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.04459, "o", "    subparsers = parser.add_subparsers(dest=\"command\", required=True)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     # dump command\r\n\u001b[?2004l\r"]
[84.044639, "o", "\u001b[?2004h> "]
[84.044894, "o", "    dump_p = subparsers.add_parser(\"dump\", help=\"Dump database\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.045149, "o", "    dump_p.add_argument(\"db_path\", help=\"Path to SQLite DB\")\r\n\u001b[?2004l\r"]
[84.045505, "o", "\u001b[?2004h> "]
[84.045564, "o", "    dump_p.add_argument(\"output_path\", help=\"Output SQL dump file\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.045754, "o", "    dump_p.add_argument(\"--table\", help=\"Dump only the specified table\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[84.045816, "o", ">     # tables command\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.046109, "o", "    tables_p = subparsers.add_parser(\"tables\", help=\"List database tables\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.046583, "o", "    tables_p.add_argument(\"db_path\", help=\"Path to SQLite DB\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     args = parser.parse_args()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     if args.command == \"dump\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.046958, "o", "        dump_database(args.db_path, args.output_path, table_name=args.table)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.048874, "o", "    elif args.command == \"tables\":\r\n\u001b[?2004l\r\u001b[?2004h>         for t in list_tables(args.db_path):\r\n\u001b[?2004l\r\u001b[?2004h>             print(t)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> if __name__ == \"__main__\":\r\n\u001b[?2004l\r\u001b[?2004h>     main()\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
