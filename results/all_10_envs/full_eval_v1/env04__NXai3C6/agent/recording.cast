[7.39001, "o", "import os\r\nimport shutil\r\nimport tempfile\r\nimport subprocess\r\nimport sys\r\nimport pytest\r\nfrom transcoder import transcode_file, get_media_info, extract_thumbnail\r\n\r\n@pytest.fixture\r\ndef temp_media():\r\n    tmp_dir = tempfile.mkdtemp(prefix=\"test_transcode_\")\r\n    src = os.path.join(tmp_dir, \"input.raw\")\r\n    with open(src, \"w\") as f:\r\n        f.write(\"VIDEO_SAMPLE_DATA_FRAME_0_1_2\")\r\n    yield tmp_dir, src\r\n    shutil.rmtree(tmp_dir, ignore_errors=True)\r\n\r\ndef test_transcode_basic(temp_media):\r\n    tmp_dir, src = temp_media\r\n    out = os.path.join(tmp_dir, \"out.raw\")\r\n"]
[7.390162, "o", "    transcode_file(src, out)\r\n    assert os.path.exists(out)\r\n    with open(out) as f:\r\n        data = f.read()\r\n    assert \"HEADER:TRANSCODED\" in data\r\n\r\ndef test_info(temp_media):\r\n    _, src = temp_media\r\n    info = get_media_info(src)\r\n    assert \"Bytes:\" in info\r\n\r\ndef test_extract_thumbnail(temp_media):\r\n    tmp_dir, src = temp_media\r\n    thumb = os.path.join(tmp_dir, \"thumb.jpg\")\r\n    extract_thumbnail(src, thumb)\r\n    assert os.path.exists(thumb)\r\n\r\n# Failing test demonstrating desired --scale behavior for incident ticket:\r\ndef test_transcode_scale_failing(temp_media):\r\n"]
[7.390215, "o", "    \"\"\"\r\n    Incident Hotfix Test:\r\n    Verifies that --scale width:height can be passed via CLI and recorded in output.\r\n    \"\"\"\r\n"]
[7.390234, "o", "    tmp_dir, src = temp_media\r\n    out = os.path.join(tmp_dir, \"scaled.raw\")\r\n    \r\n"]
[7.390295, "o", "    # Run CLI command with --scale\r\n    res = subprocess.run([\r\n        sys.executable, \"transcoder.py\", \"transcode\", src, out, \"--scale\", \"1280:720\"\r\n    ], capture_output=True, text=True)\r\n\r\n    assert res.returncode == 0, f\"CLI failed: {res.stderr}\"\r\n    assert os.path.exists(out), \"Scaled output was not created\"\r\n"]
[7.390356, "o", "    with open(out) as f:\r\n        content = f.read()\r\n    assert \"SCALE:1280:720\" in content, \"Scale metadata not applied\"\r\n"]
[7.391325, "o", "\u001b[?2004hroot@7bc6b6b8fbe8:/workspace# "]
[23.242394, "i", "cat > transcoder.py <<'PY'\n#!/usr/bin/env python3\nimport argparse\nimport os\nimport sys\nfrom utils.shell import run_cmd, run_argv\n\n\ndef validate_scale(scale: str) -> str:\n    \"\"\"Validate a scale argument formatted as WIDTH:HEIGHT.\"\"\"\n    if scale is None:\n        return scale\n\n    try:\n        width, height = scale.split(\":\", 1)\n    except ValueError:\n        raise argparse.ArgumentTypeError(\"scale must be in WIDTH:HEIGHT format\")\n\n    if not width.isdigit() or not height.isdigit():\n        raise argparse.ArgumentTypeError(\"scale width and height must be positive integers\")\n\n    if int(width) <= 0 or int(height) <= 0:\n        raise argparse.ArgumentTypeError(\"scale width and height must be positive integers\")\n\n    return f\"{int(width)}:{int(height)}\"\n\n\ndef transcode_file(input_file: str, output_file: str, scale: str = None) -> None:\n    \"\"\"\n    Transcode media file to destination.\n\n    If scale is provided, record the requested output resolution in the\n    destination metadata as SCALE:WIDTH:HEIGHT. If omitted"]
[23.243282, "i", ", preserve the\n    existing 1:1 transcoding behavior.\n    \"\"\"\n    if not os.path.exists(input_file):\n        raise FileNotFoundError(f\"Input file '{input_file}' does not exist.\")\n\n    if scale is not None:\n        scale = validate_scale(scale)\n\n    with open(input_file, \"r\") as f_in:\n        content = f_in.read()\n\n    metadata = [\"HEADER:TRANSCODED\"]\n    if scale:\n        metadata.append(f\"SCALE:{scale}\")\n\n    with open(output_file, \"w\") as f_out:\n        f_out.write(\"\\n\".join(metadata) + f\"\\n{content}\")\n\n\ndef get_media_info(media_file: str) -> str:\n    \"\"\"Returns media metadata.\"\"\"\n    if not os.path.exists(media_file):\n        raise FileNotFoundError(f\"Media file '{media_file}' does not exist.\")\n    size = os.path.getsize(media_file)\n    return f\"File: {os.path.basename(media_file)}, Bytes: {size}\"\n\n\ndef extract_thumbnail(media_file: str, thumb_file: str) -> None:\n    \"\"\"Extracts poster frame thumbnail.\"\"\"\n    if not os.path.exists(media_file):\n        raise FileNotFoundError(f\"Media file '{media_file}' doe"]
[23.243603, "o", "cat > transcoder.py <<'PY'\r\n\u001b[?2004l\r"]
[23.243709, "i", "s not exist.\")\n    with open(thumb_file, \"w\") as f:\n        f.write(f\"THUMBNAIL_FOR:{os.path.basename(media_file)}\")\n\n\ndef main():\n    parser = argparse.ArgumentParser(description=\"Media Transcoding Utility\")\n    subparsers = parser.add_subparsers(dest=\"command\", required=True)\n\n    # transcode subcommand\n    trans_p = subparsers.add_parser(\"transcode\", help=\"Transcode media\")\n    trans_p.add_argument(\"input_file\", help=\"Source media file\")\n    trans_p.add_argument(\"output_file\", help=\"Target media file\")\n    trans_p.add_argument(\n        \"--scale\",\n        type=validate_scale,\n        help=\"Optional output resolution scale in WIDTH:HEIGHT format, e.g. 1280:720\",\n    )\n\n    # info subcommand\n    info_p = subparsers.add_parser(\"info\", help=\"Get media info\")\n    info_p.add_argument(\"media_file\", help=\"Target media file\")\n\n    # extract subcommand\n    ext_p = subparsers.add_parser(\"extract\", help=\"Extract thumbnail\")\n    ext_p.add_argument(\"media_file\", help=\"Source media file\")\n    ext_p.add_argument(\"thumb_fil"]
[23.243729, "o", "\u001b[?2004h> #!/usr/bin/env python3\r\n\u001b[?2004l\r\u001b[?2004h> "]
[23.243769, "i", "e\", help=\"Output thumbnail file\")\n\n    args = parser.parse_args()\n\n    if args.command == \"transcode\":\n        transcode_file(args.input_file, args.output_file, scale=args.scale)\n    elif args.command == \"info\":\n        print(get_media_info(args.media_file))\n    elif args.command == \"extract\":\n        extract_thumbnail(args.media_file, args.thumb_file)\n\n\nif __name__ == \"__main__\":\n    main()\nPY\npython -m pytest -q\n"]
