[93.590401, "o", "#!/usr/bin/env python3\r\nimport argparse\r\nimport fnmatch\r\nimport os\r\nimport sys\r\nimport tarfile\r\nfrom typing import Optional\r\nfrom utils.shell import run_cmd, run_argv\r\n\r\ndef _matches_exclude(archive_name: str, pattern: str) -> bool:\r\n    \"\"\"\r\n    Return True when an archive member name matches the exclude pattern.\r\n\r\n    Archive members are stored with names like ``./file.txt`` while users\r\n    generally provide source-relative patterns like ``*.tmp`` or ``cache/*``.\r\n    Check both forms so either style works.\r\n    \"\"\"\r\n    rel_name = archive_name[2:] if archive_name.startswith(\"./\") else archive_name\r\n    rel_pattern = pattern[2:] if pattern.startswith(\"./\") else pattern\r\n\r\n    if rel_name in (\"\", \".\"):\r\n        return False\r\n\r\n    name_candidates = {archive_name, rel_name, f\"./{rel_name}\"}\r\n    pattern_candidates = {pattern, rel_pattern, f\"./{rel_pattern}\"}\r\n\r\n    for name in name_candidates:\r\n        for pat in pattern_candidates:\r\n            if fnmatch.fnmatchcase(name, pat):\r\n                return Tru"]
[93.590901, "o", "e\r\n\r\n    # Treat directory-wide patterns such as \"cache/*\" as matching the\r\n    # directory entry itself too; this prevents tarfile from descending into it.\r\n    if rel_pattern.endswith(\"/*\") and rel_name == rel_pattern[:-2].rstrip(\"/\"):\r\n        return True\r\n\r\n    # If a plain directory name is excluded (e.g. \"cache\"), exclude its\r\n    # contents as well.\r\n    if not any(ch in rel_pattern for ch in \"*?[\"):\r\n        directory_pattern = rel_pattern.rstrip(\"/\")\r\n        if rel_name.startswith(directory_pattern + \"/\"):\r\n            return True\r\n\r\n    return False\r\n\r\n\r\ndef create_archive(source_dir: str, output_path: str, exclude: Optional[str] = None) -> None:\r\n    \"\"\"\r\n    Creates a compressed tar.gz archive from source_dir.\r\n\r\n    If exclude is provided, files/directories matching the glob-style pattern\r\n    are omitted from the archive.\r\n    \"\"\"\r\n    if not os.path.exists(source_dir):\r\n        raise FileNotFoundError(f\"Source directory '{source_dir}' does not exist.\")\r\n\r\n    if exclude:\r\n        def exclude_f"]
[93.591293, "o", "ilter(tarinfo: tarfile.TarInfo) -> Optional[tarfile.TarInfo]:\r\n            if _matches_exclude(tarinfo.name, exclude):\r\n                return None\r\n            return tarinfo\r\n\r\n        with tarfile.open(output_path, \"w:gz\") as archive:\r\n            archive.add(source_dir, arcname=\".\", filter=exclude_filter)\r\n        return\r\n\r\n    # Existing codebase pattern: uses run_cmd with string interpolation\r\n    cmd = f\"tar -czf {output_path} -C {source_dir} .\"\r\n    run_cmd(cmd)\r\ndef list_archive(archive_path: str) -> str:\r\n    \"\"\"Lists files in the archive.\"\"\"\r\n    if not os.path.exists(archive_path):\r\n        raise FileNotFoundError(f\"Archive '{archive_path}' does not exist.\")\r\n    result = run_cmd(f\"tar -ztvf {archive_path}\")\r\n    return result.stdout\r\n\r\ndef extract_archive(archive_path: str, target_dir: str) -> None:\r\n    \"\"\"Extracts files from archive into target_dir.\"\"\"\r\n    if not os.path.exists(archive_path):\r\n        raise FileNotFoundError(f\"Archive '{archive_path}' does not exist.\")\r\n    os.makedirs(target_"]
[93.59153, "o", "dir, exist_ok=True)\r\n    run_cmd(f\"tar -xzf {archive_path} -C {target_dir}\")\r\n\r\ndef main():\r\n    parser = argparse.ArgumentParser(description=\"System Archival Utility\")\r\n    subparsers = parser.add_subparsers(dest=\"command\", required=True)\r\n\r\n    # create command\r\n    create_parser = subparsers.add_parser(\"create\", help=\"Create a tar.gz archive\")\r\n    create_parser.add_argument(\"source_dir\", help=\"Directory to archive\")\r\n    create_parser.add_argument(\"output_path\", help=\"Target archive path\")\r\n    create_parser.add_argument(\"--exclude\", help=\"Glob-style pattern to exclude from the archive\")\r\n\r\n    # list command\r\n    list_parser = subparsers.add_parser(\"list\", help=\"List archive contents\")\r\n    list_parser.add_argument(\"archive_path\", help=\"Path to archive\")\r\n\r\n    # extract command\r\n    extract_parser = subparsers.add_parser(\"extract\", help=\"Extract archive\")\r\n    extract_parser.add_argument(\"archive_path\", help=\"Path to archive\")\r\n    extract_parser.add_argument(\"target_dir\", help=\"Directory to extract to\""]
[93.59167, "o", ")\r\n\r\n    args = parser.parse_args()\r\n\r\n    if args.command == \"create\":\r\n        create_archive(args.source_dir, args.output_path, exclude=args.exclude)\r\n    elif args.command == \"list\":\r\n        print(list_archive(args.archive_path))\r\n    elif args.command == \"extract\":\r\n        extract_archive(args.archive_path, args.target_dir)\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n\u001b[?2004hroot@a050998343ff:/workspace# PYTHONPATH=. pytest -q\r\n\u001b[?2004l\r"]
