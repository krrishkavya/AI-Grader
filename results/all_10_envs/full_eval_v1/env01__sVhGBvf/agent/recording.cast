[110.453495, "i", "tmpdir=$(mktemp -d)\nmkdir -p \"$tmpdir/src/cache\" \"$tmpdir/extract\"\nprintf 'keep' > \"$tmpdir/src/keep.txt\"\nprintf 'tmp' > \"$tmpdir/src/drop.tmp\"\nprintf 'log' > \"$tmpdir/src/app.log\"\nprintf 'cache' > \"$tmpdir/src/cache/data.bin\"\npython3 archiver.py create \"$tmpdir/src\" \"$tmpdir/all.tar.gz\"\npython3 archiver.py list \"$tmpdir/all.tar.gz\"\npython3 archiver.py create \"$tmpdir/src\" \"$tmpdir/no_tmp.tar.gz\" --exclude '*.tmp'\npython3 archiver.py list \"$tmpdir/no_tmp.tar.gz\"\npython3 archiver.py create \"$tmpdir/src\" \"$tmpdir/no_cache.tar.gz\" --exclude 'cache/*'\npython3 archiver.py list \"$tmpdir/no_cache.tar.gz\"\npython3 archiver.py extract \"$tmpdir/no_tmp.tar.gz\" \"$tmpdir/extract\"\nfind \"$tmpdir/extract\" -maxdepth 3 -type f -printf '%P\\n' | sort\nrm -rf \"$tmpdir\"\n"]
