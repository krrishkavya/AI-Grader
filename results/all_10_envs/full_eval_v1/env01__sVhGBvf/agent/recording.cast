[40.813855, "i", "apply_patch <<'PATCH'\n*** Begin Patch\n*** Update File: archiver.py\n@@\n import argparse\n+import fnmatch\n import os\n import sys\n+import tarfile\n+from typing import Optional\n from utils.shell import run_cmd, run_argv\n \n-def create_archive(source_dir: str, output_path: str) -> None:\n+def _matches_exclude(archive_name: str, pattern: str) -> bool:\n+    \"\"\"\n+    Return True when an archive member name matches the exclude pattern.\n+\n+    Archives created from a directory use names like ``./file.txt``.  Users,\n+    however, naturally pass patterns relative to the source directory such as\n+    ``*.tmp`` or ``cache/*``.  Check both the stored name and the same name\n+    without the leading ``./`` so either form works.\n+    \"\"\"\n+    names_to_check = [archive_name]\n+    if archive_name.startswith(\"./\"):\n+        names_to_check.append(archive_name[2:])\n+\n+    return any(fnmatch.fnmatchcase(name, pattern) for name in names_to_check)\n+\n+\n+def create_archive(source_dir: str, output_path: str, exclude: Optional[str] = None) ->"]
