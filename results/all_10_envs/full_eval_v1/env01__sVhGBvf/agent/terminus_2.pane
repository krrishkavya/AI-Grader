    for name in name_candidates:
        for pat in pattern_candidates:
            if fnmatch.fnmatchcase(name, pat):
                return True

    # Treat directory-wide patterns such as "cache/*" as matching the
    # directory entry itself too; this prevents tarfile from descending into it.
    if rel_pattern.endswith("/*") and rel_name == rel_pattern[:-2].rstrip("/"):
        return True

    # If a plain directory name is excluded (e.g. "cache"), exclude its
    # contents as well.
    if not any(ch in rel_pattern for ch in "*?["):
        directory_pattern = rel_pattern.rstrip("/")
        if rel_name.startswith(directory_pattern + "/"):
            return True

    return False


def create_archive(source_dir: str, output_path: str, exclude: Optional[str] = None) -> None:
    """
    Creates a compressed tar.gz archive from source_dir.

    If exclude is provided, files/directories matching the glob-style pattern
    are omitted from the archive.
    """
    if not os.path.exists(source_dir):
        raise FileNotFoundError(f"Source directory '{source_dir}' does not exist.")

    if exclude:
        def exclude_filter(tarinfo: tarfile.TarInfo) -> Optional[tarfile.TarInfo]:
            if _matches_exclude(tarinfo.name, exclude):
                return None
            return tarinfo

        with tarfile.open(output_path, "w:gz") as archive:
            archive.add(source_dir, arcname=".", filter=exclude_filter)
        return

    # Existing codebase pattern: uses run_cmd with string interpolation
    cmd = f"tar -czf {output_path} -C {source_dir} ."
    run_cmd(cmd)
