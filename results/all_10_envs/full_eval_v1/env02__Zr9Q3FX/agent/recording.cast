[47.265273, "i", "tmp=$(mktemp -d)\nprintf 'log1\\n' > \"$tmp/server.log\"\nprintf 'log2\\n' > \"$tmp/access.log\"\nprintf '{\"key\":\"value\"}\\n' > \"$tmp/config.json\"\npython3 compressor.py compress \"$tmp\" --ext log\nls -1 \"$tmp\" | sort\ntest -f \"$tmp/server.log.gz\" && test -f \"$tmp/access.log.gz\" && test ! -f \"$tmp/config.json.gz\"\npython3 compressor.py status \"$tmp\"\nrm -rf \"$tmp\"\n\ntmp=$(mktemp -d)\nprintf 'log1\\n' > \"$tmp/server.log\"\nprintf '{\"key\":\"value\"}\\n' > \"$tmp/config.json\"\npython3 compressor.py compress \"$tmp\"\nls -1 \"$tmp\" | sort\ntest -f \"$tmp/server.log.gz\" && test -f \"$tmp/config.json.gz\"\nrm -rf \"$tmp\"\n"]
