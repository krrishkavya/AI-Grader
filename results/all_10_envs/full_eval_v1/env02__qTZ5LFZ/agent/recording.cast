[53.109695, "o", "#!/usr/bin/env python3\r\n"]
[53.110407, "o", "import argparse\r\nimport glob\r\nimport os\r\nimport sys\r\nfrom typing import Optional\r\nfrom utils.shell import run_cmd, run_argv\r\n\r\ndef compress_directory(target_dir: str, ext: Optional[str] = None) -> None:\r\n    \"\"\"\r\n    Compresses uncompressed files in target_dir using gzip.\r\n\r\n    If ext is provided, only files ending with that extension are compressed.\r\n    The extension may be supplied with or without a leading dot (e.g.\r\n    \"log\" or \".log\").\r\n    \"\"\"\r\n    if not os.path.exists(target_dir):\r\n        raise FileNotFoundError(f\"Target directory '{target_dir}' does not exist.\")\r\n    \r\n    normalized_ext = None\r\n    if ext:\r\n        normalized_ext = ext if ext.startswith(\".\") else f\".{ext}\"\r\n\r\n    for filename in os.listdir(target_dir):\r\n        filepath = os.path.join(target_dir, filename)\r\n        if not os.path.isfile(filepath) or filepath.endswith(\".gz\"):\r\n            continue\r\n        if normalized_ext and not filename.endswith(normalized_ext):\r\n            continue\r\n\r\n        # Established pattern in codeba"]
[53.110986, "o", "se: uses run_cmd with string interpolation\r\n        run_cmd(f\"gzip -k {filepath}\")\r\n\r\ndef decompress_file(file_path: str) -> None:\r\n    \"\"\"Decompresses a .gz file.\"\"\"\r\n    if not os.path.exists(file_path):\r\n        raise FileNotFoundError(f\"File '{file_path}' does not exist.\")\r\n    run_cmd(f\"gzip -d -k {file_path}\")\r\n\r\ndef get_status(target_dir: str) -> str:\r\n"]
[53.111174, "o", "    \"\"\"Returns status summary of compressed vs uncompressed files.\"\"\"\r\n    if not os.path.exists(target_dir):\r\n        raise FileNotFoundError(f\"Directory '{target_dir}' does not exist.\")\r\n    all_files = os.listdir(target_dir)\r\n    gz_files = [f for f in all_files if f.endswith(\".gz\")]\r\n    raw_files = [f for f in all_files if not f.endswith(\".gz\")]\r\n"]
[53.111867, "o", "    return f\"Total: {len(all_files)}, Compressed: {len(gz_files)}, Raw: {len(raw_files)}\"\r\n\r\ndef main():\r\n    parser = argparse.ArgumentParser(description=\"Log Compression Utility\")\r\n    subparsers = parser.add_subparsers(dest=\"command\", required=True)\r\n\r\n    # compress command\r\n    comp_parser = subparsers.add_parser(\"compress\", help=\"Compress files in directory\")\r\n    comp_parser.add_argument(\"target_dir\", help=\"Directory containing log files\")\r\n    comp_parser.add_argument(\"--ext\", help=\"Only compress files with this extension (with or without leading dot)\")\r\n\r\n    # decompress command\r\n    decomp_parser = subparsers.add_parser(\"decompress\", help=\"Decompress a .gz file\")\r\n    decomp_parser.add_argument(\"file_path\", help=\"Path to .gz file\")\r\n\r\n    # status command\r\n    status_parser = subparsers.add_parser(\"status\", help=\"Get compression status\")\r\n    status_parser.add_argument(\"target_dir\", help=\"Target directory\")\r\n\r\n    args = parser.parse_args()\r\n\r\n    if args.command == \"compress\":\r\n        compress_di"]
[53.112384, "o", "rectory(args.target_dir, args.ext)\r\n    elif args.command == \"decompress\":\r\n        decompress_file(args.file_path)\r\n    elif args.command == \"status\":\r\n        print(get_status(args.target_dir))\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n"]
