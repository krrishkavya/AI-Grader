[40.653737, "i", "apply_patch <<'PATCH'\n*** Begin Patch\n*** Update File: db_dumper.py\n@@\n-def dump_database(db_path: str, output_path: str) -> None:\n+def _quote_identifier(identifier: str) -> str:\n+    \"\"\"Return identifier quoted for use in SQLite SQL statements.\"\"\"\n+    return '\"' + identifier.replace('\"', '\"\"') + '\"'\n+\n+\n+def _iterdump_table(conn: sqlite3.Connection, table_name: str):\n+    \"\"\"Yield SQL dump statements for a single user table.\"\"\"\n+    cur = conn.cursor()\n+\n+    cur.execute(\n+        \"\"\"\n+        SELECT name, type, sql\n+        FROM sqlite_master\n+        WHERE type = 'table'\n+          AND name = ?\n+          AND name NOT LIKE 'sqlite_%'\n+          AND sql IS NOT NULL\n+        \"\"\",\n+        (table_name,),\n+    )\n+    table = cur.fetchone()\n+    if table is None:\n+        raise ValueError(f\"Table '{table_name}' not found.\")\n+\n+    name, _, create_sql = table\n+    quoted_name = _quote_identifier(name)\n+\n+    yield \"BEGIN TRANSACTION;\"\n+\n+    if create_sql.startswith(\"CREATE VIRTUAL TABLE\"):\n+        yield \"PRAG"]
[40.65386, "i", "MA writable_schema=ON;\"\n+        yield (\n+            \"INSERT INTO sqlite_master(type,name,tbl_name,rootpage,sql)\"\n+            \"VALUES('table','{0}','{0}',0,'{1}');\"\n+        ).format(name.replace(\"'\", \"''\"), create_sql.replace(\"'\", \"''\"))\n+    else:\n+        yield f\"{create_sql};\"\n+\n+    # Build INSERT statements using SQLite's quote() so values are escaped in\n+    # the same way as sqlite3.Connection.iterdump().\n+    cur.execute(f\"PRAGMA table_info({quoted_name})\")\n+    column_names = [row[1] for row in cur.fetchall()]\n+    if column_names:\n+        quoted_columns = [_quote_identifier(col) for col in column_names]\n+        value_expr = \",\".join(f\"'||quote({col})||'\" for col in quoted_columns)\n+        insert_sql = f\"SELECT 'INSERT INTO {quoted_name} VALUES({value_expr})' FROM {quoted_name};\"\n+        for row in cur.execute(insert_sql):\n+            yield f\"{row[0]};\"\n+\n+    # Include indexes and triggers that belong to this table. Views are not\n+    # table-owned, so they are intentionally not included in "]
[40.6541, "i", "a single-table dump.\n+    cur.execute(\n+        \"\"\"\n+        SELECT sql\n+        FROM sqlite_master\n+        WHERE sql IS NOT NULL\n+          AND type IN ('index', 'trigger')\n+          AND tbl_name = ?\n+        ORDER BY type, name\n+        \"\"\",\n+        (name,),\n+    )\n+    for (sql,) in cur.fetchall():\n+        yield f\"{sql};\"\n+\n+    if create_sql.startswith(\"CREATE VIRTUAL TABLE\"):\n+        yield \"PRAGMA writable_schema=OFF;\"\n+\n+    yield \"COMMIT;\"\n+\n+\n+def dump_database(db_path: str, output_path: str, table_name: str = None) -> None:\n     \"\"\"\n-    Dumps all SQL statements and table contents to output_path.\n+    Dumps SQL statements and table contents to output_path.\n+\n+    If table_name is provided, only that table's schema and rows are dumped.\n+    Otherwise, the entire database is dumped.\n     \"\"\"\n     if not os.path.exists(db_path):\n         raise FileNotFoundError(f\"Database '{db_path}' not found.\")\n \n     conn = sqlite3.connect(db_path)\n-    with open(output_path, \"w\") as f:\n-        for line in conn"]
[40.654385, "o", "apply_patch <<'PATCH'\r\n\u001b[?2004l\r\u001b[?2004h"]
[40.654539, "i", ".iterdump():\n-            f.write(f\"{line}\\n\")\n-    conn.close()\n+    try:\n+        dump_iter = _iterdump_table(conn, table_name) if table_name else conn.iterdump()\n+        with open(output_path, \"w\") as f:\n+            for line in dump_iter:\n+                f.write(f\"{line}\\n\")\n+    finally:\n+        conn.close()\n@@\n     dump_p = subparsers.add_parser(\"dump\", help=\"Dump database\")\n     dump_p.add_argument(\"db_path\", help=\"Path to SQLite DB\")\n     dump_p.add_argument(\"output_path\", help=\"Output SQL dump file\")\n+    dump_p.add_argument(\"--table\", dest=\"table_name\", help=\"Dump only the named table\")\n@@\n     if args.command == \"dump\":\n-        dump_database(args.db_path, args.output_path)\n+        dump_database(args.db_path, args.output_path, args.table_name)\n*** End Patch\nPATCH\n"]
