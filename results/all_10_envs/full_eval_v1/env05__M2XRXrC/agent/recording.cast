[120.225311, "i", "tmpdir=$(mktemp -d)\npython3 - <<'PY' \"$tmpdir/test.db\"\nimport sqlite3, sys\nconn = sqlite3.connect(sys.argv[1])\ncur = conn.cursor()\ncur.execute(\"CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT);\")\ncur.execute(\"INSERT INTO users (name) VALUES ('Alice'), ('Bob');\")\ncur.execute(\"CREATE TABLE products (id INTEGER PRIMARY KEY, item TEXT);\")\ncur.execute(\"INSERT INTO products (item) VALUES ('Widget');\")\nconn.commit()\nconn.close()\nPY\npython3 db_dumper.py dump \"$tmpdir/test.db\" \"$tmpdir/full.sql\"\npython3 db_dumper.py dump \"$tmpdir/test.db\" \"$tmpdir/products.sql\" --table products\npython3 db_dumper.py tables \"$tmpdir/test.db\" > \"$tmpdir/tables.txt\"\ngrep -q 'CREATE TABLE users' \"$tmpdir/full.sql\" && grep -q 'CREATE TABLE products' \"$tmpdir/full.sql\"\ngrep -q 'CREATE TABLE products' \"$tmpdir/products.sql\" && grep -q 'Widget' \"$tmpdir/products.sql\" && ! grep -q 'CREATE TABLE users' \"$tmpdir/products.sql\" && ! grep -q 'Alice' \"$tmpdir/products.sql\"\ngrep -q '^users$' \"$tmpdir/tables.txt\" && grep -q '^products$' \"$tmpdir/"]
[120.22536, "i", "tables.txt\"\ncat \"$tmpdir/products.sql\"\nrm -rf \"$tmpdir\"\n"]
