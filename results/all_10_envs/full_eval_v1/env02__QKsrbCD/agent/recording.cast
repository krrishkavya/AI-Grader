[44.933029, "i", "set -e\nTMPDIR=$(mktemp -d)\nprintf 'a\\n' > \"$TMPDIR/app.log\"\nprintf 'b\\n' > \"$TMPDIR/readme.txt\"\nprintf 'c\\n' > \"$TMPDIR/config.json\"\npython3 compressor.py compress \"$TMPDIR\" --ext log\nls -1 \"$TMPDIR\" | sort\n[ -f \"$TMPDIR/app.log.gz\" ] && [ ! -f \"$TMPDIR/readme.txt.gz\" ] && [ ! -f \"$TMPDIR/config.json.gz\" ]\npython3 compressor.py status \"$TMPDIR\"\nTMPDIR2=$(mktemp -d)\nprintf 'x\\n' > \"$TMPDIR2/one.log\"\nprintf 'y\\n' > \"$TMPDIR2/two.txt\"\npython3 compressor.py compress \"$TMPDIR2\" --ext .txt\n[ ! -f \"$TMPDIR2/one.log.gz\" ] && [ -f \"$TMPDIR2/two.txt.gz\" ]\nTMPDIR3=$(mktemp -d)\nprintf 'x\\n' > \"$TMPDIR3/one.log\"\nprintf 'y\\n' > \"$TMPDIR3/two.txt\"\npython3 compressor.py compress \"$TMPDIR3\"\n[ -f \"$TMPDIR3/one.log.gz\" ] && [ -f \"$TMPDIR3/two.txt.gz\" ]\nrm \"$TMPDIR3/one.log\"\npython3 compressor.py decompress \"$TMPDIR3/one.log.gz\"\n[ -f \"$TMPDIR3/one.log\" ]\nrm -rf \"$TMPDIR\" \"$TMPDIR2\" \"$TMPDIR3\"\necho 'manual smoke tests passed'\n"]
