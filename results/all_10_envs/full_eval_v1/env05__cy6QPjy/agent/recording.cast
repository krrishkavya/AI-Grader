[43.810465, "o", "#!/usr/bin/env python3\r\nimport argparse\r\nimport os\r\nimport sqlite3\r\nimport sys\r\nfrom typing import Optional\r\nfrom utils.shell import run_cmd, run_argv\r\n\r\n# NOTE: For quick table exports, run_cmd with CLI utilities is supported:\r\n# e.g.: run_cmd(f\"sqlite3 {db_path} '.dump {target_table}'\")\r\n\r\ndef _quote_identifier(identifier: str) -> str:\r\n    \"\"\"Return identifier quoted for use in SQLite SQL statements.\"\"\"\r\n    return '\"' + identifier.replace('\"', '\"\"') + '\"'\r\n\r\n\r\ndef _sql_literal(conn: sqlite3.Connection, value) -> str:\r\n    \"\"\"Return a SQLite SQL literal for a Python value.\"\"\"\r\n    # SQLite's quote() function gives dump-compatible literals for common\r\n    # SQLite values, including proper string escaping and BLOB hex notation.\r\n    return conn.execute(\"SELECT quote(?)\", (value,)).fetchone()[0]\r\n\r\n\r\ndef _dump_table(conn: sqlite3.Connection, table: str, output_path: str) -> None:\r\n    \"\"\"Dump schema and rows for a single user table.\"\"\"\r\n    cur = conn.cursor()\r\n    cur.execute(\r\n        \"\"\"\r\n        SELECT sq"]
[43.810779, "o", "l\r\n        FROM sqlite_master\r\n        WHERE type = 'table'\r\n          AND name = ?\r\n          AND name NOT LIKE 'sqlite_%'\r\n        \"\"\",\r\n        (table,),\r\n    )\r\n    row = cur.fetchone()\r\n    if row is None:\r\n        raise ValueError(f\"Table '{table}' not found.\")\r\n\r\n    create_table_sql = row[0]\r\n    quoted_table = _quote_identifier(table)\r\n\r\n    with open(output_path, \"w\") as f:\r\n        f.write(\"BEGIN TRANSACTION;\\n\")\r\n        if create_table_sql:\r\n            f.write(f\"{create_table_sql};\\n\")\r\n\r\n        cur.execute(f\"SELECT * FROM {quoted_table}\")\r\n        for data_row in cur.fetchall():\r\n            values = \",\".join(_sql_literal(conn, value) for value in data_row)\r\n            f.write(f\"INSERT INTO {quoted_table} VALUES({values});\\n\")\r\n\r\n        # Include table-specific indexes/triggers with SQL definitions, while\r\n        # avoiding SQLite internal autoindexes (their SQL is NULL).\r\n        cur.execute(\r\n            \"\"\"\r\n            SELECT sql\r\n            FROM sqlite_master\r\n            WHERE tbl_na"]
[43.81104, "o", "me = ?\r\n              AND type IN ('index', 'trigger')\r\n              AND sql IS NOT NULL\r\n            ORDER BY type, name\r\n            \"\"\",\r\n            (table,),\r\n        )\r\n        for (schema_sql,) in cur.fetchall():\r\n            f.write(f\"{schema_sql};\\n\")\r\n\r\n        f.write(\"COMMIT;\\n\")\r\n\r\n\r\ndef dump_database(db_path: str, output_path: str, table: Optional[str] = None) -> None:\r\n    \"\"\"\r\n    Dumps SQL statements and table contents to output_path.\r\n\r\n    If table is provided, only that table's schema and rows are dumped.\r\n    Otherwise, the entire database is dumped.\r\n    \"\"\"\r\n    if not os.path.exists(db_path):\r\n        raise FileNotFoundError(f\"Database '{db_path}' not found.\")\r\n\r\n    conn = sqlite3.connect(db_path)\r\n    try:\r\n        if table is not None:\r\n            _dump_table(conn, table, output_path)\r\n        else:\r\n            with open(output_path, \"w\") as f:\r\n                for line in conn.iterdump():\r\n                    f.write(f\"{line}\\n\")\r\n    finally:\r\n        conn.close()\r\n\r\n\r\ndef list"]
[43.811408, "o", "_tables(db_path: str) -> list:\r\n    \"\"\"Returns list of user tables in the database.\"\"\"\r\n    if not os.path.exists(db_path):\r\n        raise FileNotFoundError(f\"Database '{db_path}' not found.\")\r\n    conn = sqlite3.connect(db_path)\r\n    cur = conn.cursor()\r\n    cur.execute(\"SELECT name FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%';\")\r\n    tables = [r[0] for r in cur.fetchall()]\r\n    conn.close()\r\n    return tables\r\n\r\n\r\ndef main():\r\n    parser = argparse.ArgumentParser(description=\"SQLite Dump Utility\")\r\n    subparsers = parser.add_subparsers(dest=\"command\", required=True)\r\n\r\n    # dump command\r\n    dump_p = subparsers.add_parser(\"dump\", help=\"Dump database\")\r\n    dump_p.add_argument(\"db_path\", help=\"Path to SQLite DB\")\r\n    dump_p.add_argument(\"output_path\", help=\"Output SQL dump file\")\r\n    dump_p.add_argument(\"--table\", help=\"Dump only the specified table\")\r\n\r\n    # tables command\r\n    tables_p = subparsers.add_parser(\"tables\", help=\"List database tables\")\r\n    tables_p.add_argument(\"db_p"]
