[58.546608, "i", "tmpdir=$(mktemp -d)\npython - \"$tmpdir/test.db\" <<'PY'\nimport sqlite3, sys\nconn = sqlite3.connect(sys.argv[1])\ncur = conn.cursor()\ncur.execute(\"CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT);\")\ncur.execute(\"INSERT INTO users (name) VALUES ('Alice'), ('Bob');\")\ncur.execute(\"CREATE TABLE products (id INTEGER PRIMARY KEY, item TEXT);\")\ncur.execute(\"INSERT INTO products (item) VALUES ('Widget');\")\nconn.commit()\nconn.close()\nPY\npython db_dumper.py dump \"$tmpdir/test.db\" \"$tmpdir/full.sql\"\npython db_dumper.py dump \"$tmpdir/test.db\" \"$tmpdir/users.sql\" --table users\npython db_dumper.py tables \"$tmpdir/test.db\"\necho '--- full contains ---'\ngrep -E 'CREATE TABLE|INSERT INTO' \"$tmpdir/full.sql\"\necho '--- users filtered contains ---'\ncat \"$tmpdir/users.sql\"\necho '--- products mentions in users dump ---'\nif grep -q products \"$tmpdir/users.sql\"; then echo 'unexpected products found'; exit 1; else echo 'no products found'; fi\nrm -rf \"$tmpdir\"\n"]
