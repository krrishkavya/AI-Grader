[43.500396, "i", "set -e\nrm -rf /tmp/archiver_test /tmp/archiver_extract_all /tmp/archiver_extract_exclude /tmp/archiver_all.tar.gz /tmp/archiver_exclude_tmp.tar.gz /tmp/archiver_exclude_cache.tar.gz\nmkdir -p /tmp/archiver_test/cache /tmp/archiver_test/subdir\nprintf 'keep\\n' > /tmp/archiver_test/keep.txt\nprintf 'tmp\\n' > /tmp/archiver_test/drop.tmp\nprintf 'log\\n' > /tmp/archiver_test/subdir/drop.log\nprintf 'cache\\n' > /tmp/archiver_test/cache/item.dat\npython3 archiver.py create /tmp/archiver_test /tmp/archiver_all.tar.gz\npython3 archiver.py list /tmp/archiver_all.tar.gz | tee /tmp/list_all.txt\npython3 archiver.py create /tmp/archiver_test /tmp/archiver_exclude_tmp.tar.gz --exclude '*.tmp'\npython3 archiver.py list /tmp/archiver_exclude_tmp.tar.gz | tee /tmp/list_exclude_tmp.txt\npython3 archiver.py create /tmp/archiver_test /tmp/archiver_exclude_cache.tar.gz --exclude 'cache/*'\npython3 archiver.py list /tmp/archiver_exclude_cache.tar.gz | tee /tmp/list_exclude_cache.txt\npython3 archiver.py extract /tmp/archiver_exclude_tmp.tar.g"]
