[72.678852, "i", "python -m pytest -q || true\nPYTHONPATH=. pytest -q\nTMPDIR=$(mktemp -d)\nprintf 'a\\n' > \"$TMPDIR/server.log\"\nprintf 'b\\n' > \"$TMPDIR/access.log\"\nprintf 'c\\n' > \"$TMPDIR/config.json\"\npython compressor.py compress \"$TMPDIR\" --ext log\nfind \"$TMPDIR\" -maxdepth 1 -type f -printf '%f\\n' | sort\nrm -rf \"$TMPDIR\"\nTMPDIR=$(mktemp -d)\nprintf 'a\\n' > \"$TMPDIR/server.log\"\nprintf 'b\\n' > \"$TMPDIR/config.json\"\npython compressor.py compress \"$TMPDIR\" --ext .log\nfind \"$TMPDIR\" -maxdepth 1 -type f -printf '%f\\n' | sort\nrm -rf \"$TMPDIR\"\nTMPDIR=$(mktemp -d)\nprintf 'a\\n' > \"$TMPDIR/server.log\"\nprintf 'b\\n' > \"$TMPDIR/config.json\"\npython compressor.py compress \"$TMPDIR\"\nfind \"$TMPDIR\" -maxdepth 1 -type f -printf '%f\\n' | sort\nrm -rf \"$TMPDIR\"\n"]
