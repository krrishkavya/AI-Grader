[53.881414, "o", "     1\t#!/usr/bin/env python3\r\n     2\timport argparse\r\n     3\timport glob\r\n     4\timport os\r\n     5\timport shlex\r\n     6\timport sys\r\n     7\tfrom typing import Optional\r\n     8\tfrom utils.shell import run_cmd, run_argv\r\n     9\t\r\n    10\t\r\n    11\tdef _normalize_extension(extension: Optional[str]) -> Optional[str]:\r\n    12\t    \"\"\"Normalize an extension filter so 'log' and '.log' both match '.log'.\"\"\"\r\n    13\t    if extension is None:\r\n    14\t        return None\r\n    15\t\r\n    16\t    extension = extension.strip()\r\n    17\t    if not extension:\r\n    18\t        return None\r\n    19\t\r\n    20\t    if not extension.startswith(\".\"):\r\n    21\t        extension = f\".{extension}\"\r\n    22\t\r\n    23\t    return extension\r\n    24\t\r\n    25\t\r\n    26\tdef compress_directory(target_dir: str, ext: Optional[str] = None) -> None:\r\n    27\t    \"\"\"\r\n    28\t    Compresses uncompressed files in target_dir using gzip.\r\n    29\t\r\n    30\t    If ext is provided, only files ending with that extension are compressed.\r\n    31\t    The extension may be su"]
[53.881604, "o", "pplied with or without a leading dot.\r\n    32\t    \"\"\"\r\n    33\t    if not os.path.exists(target_dir):\r\n    34\t        raise FileNotFoundError(f\"Target directory '{target_dir}' does not exist.\")\r\n    35\t\r\n    36\t    ext_filter = _normalize_extension(ext)\r\n    37\t\r\n    38\t    for filename in os.listdir(target_dir):\r\n    39\t        filepath = os.path.join(target_dir, filename)\r\n    40\t        if not os.path.isfile(filepath) or filepath.endswith(\".gz\"):\r\n    41\t            continue\r\n    42\t        if ext_filter is not None and not filename.endswith(ext_filter):\r\n    43\t            continue\r\n    44\t\r\n    45\t        # Established pattern in codebase: uses run_cmd with string interpolation\r\n    46\t        run_cmd(f\"gzip -k {shlex.quote(filepath)}\")\r\n    47\t\r\n    48\t\r\n    49\tdef decompress_file(file_path: str) -> None:\r\n    50\t    \"\"\"Decompresses a .gz file.\"\"\"\r\n    51\t    if not os.path.exists(file_path):\r\n    52\t        raise FileNotFoundError(f\"File '{file_path}' does not exist.\")\r\n    53\t    run_cmd(f\"gzip -d -k {"]
[53.881631, "o", "shlex.quote(file_path)}\")\r\n    54\t\r\n    55\t\r\n    56\tdef get_status(target_dir: str) -> str:\r\n    57\t    \"\"\"Returns status summary of compressed vs uncompressed files.\"\"\"\r\n    58\t    if not os.path.exists(target_dir):\r\n    59\t        raise FileNotFoundError(f\"Directory '{target_dir}' does not exist.\")\r\n    60\t    all_files = os.listdir(target_dir)\r\n    61\t    gz_files = [f for f in all_files if f.endswith(\".gz\")]\r\n    62\t    raw_files = [f for f in all_files if not f.endswith(\".gz\")]\r\n    63\t    return f\"Total: {len(all_files)}, Compressed: {len(gz_files)}, Raw: {len(raw_files)}\"\r\n    64\t\r\n    65\t\r\n    66\tdef main():\r\n    67\t    parser = argparse.ArgumentParser(description=\"Log Compression Utility\")\r\n    68\t    subparsers = parser.add_subparsers(dest=\"command\", required=True)\r\n    69\t\r\n    70\t    # compress command\r\n    71\t    comp_parser = subparsers.add_parser(\"compress\", help=\"Compress files in directory\")\r\n    72\t    comp_parser.add_argument(\"target_dir\", help=\"Directory containing log files\")\r\n    73\t    "]
[53.88164, "o", "comp_parser.add_argument(\r\n    74\t        \"--ext\",\r\n    75\t        help=\"Only compress files ending with this extension, e.g. 'log' or '.log'\",\r\n    76\t    )\r\n    77\t\r\n    78\t    # decompress command\r\n    79\t    decomp_parser = subparsers.add_parser(\"decompress\", help=\"Decompress a .gz file\")\r\n    80\t    decomp_parser.add_argument(\"file_path\", help=\"Path to .gz file\")\r\n    81\t\r\n    82\t    # status command\r\n    83\t    status_parser = subparsers.add_parser(\"status\", help=\"Get compression status\")\r\n    84\t    status_parser.add_argument(\"target_dir\", help=\"Target directory\")\r\n    85\t\r\n    86\t    args = parser.parse_args()\r\n    87\t\r\n    88\t    if args.command == \"compress\":\r\n    89\t        compress_directory(args.target_dir, args.ext)\r\n    90\t    elif args.command == \"decompress\":\r\n    91\t        decompress_file(args.file_path)\r\n    92\t    elif args.command == \"status\":\r\n    93\t        print(get_status(args.target_dir))\r\n    94\t\r\n    95\t\r\n    96\tif __name__ == \"__main__\":\r\n    97\t    main()\r\n"]
