[43.801679, "o", "#!/usr/bin/env python3\r\nimport argparse\r\nimport glob\r\nimport os\r\nimport shlex\r\nimport sys\r\nfrom typing import Optional\r\nfrom utils.shell import run_cmd, run_argv\r\n\r\n\r\ndef _normalize_extension(extension: Optional[str]) -> Optional[str]:\r\n    \"\"\"Normalize an extension filter so 'log' and '.log' both match '.log'.\"\"\"\r\n    if extension is None:\r\n        return None\r\n\r\n    extension = extension.strip()\r\n    if not extension:\r\n        return None\r\n\r\n    if not extension.startswith(\".\"):\r\n        extension = f\".{extension}\"\r\n\r\n    return extension\r\n\r\n\r\ndef compress_directory(target_dir: str, ext: Optional[str] = None) -> None:\r\n    \"\"\"\r\n    Compresses uncompressed files in target_dir using gzip.\r\n\r\n    If ext is provided, only files ending with that extension are compressed.\r\n    The extension may be supplied with or without a leading dot.\r\n    \"\"\"\r\n    if not os.path.exists(target_dir):\r\n        raise FileNotFoundError(f\"Target directory '{target_dir}' does not exist.\")\r\n\r\n    ext_filter = _normalize_extension(ext)"]
