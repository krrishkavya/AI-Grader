#!/usr/bin/env python3
import argparse
import glob
import os
import shlex
import sys
from typing import Optional
from utils.shell import run_cmd, run_argv


def _normalize_extension(extension: Optional[str]) -> Optional[str]:
    """Normalize an extension filter so 'log' and '.log' both match '.log'."""
    if extension is None:
        return None

    extension = extension.strip()
    if not extension:
        return None

    if not extension.startswith("."):
        extension = f".{extension}"

    return extension


def compress_directory(target_dir: str, ext: Optional[str] = None) -> None:
    """
