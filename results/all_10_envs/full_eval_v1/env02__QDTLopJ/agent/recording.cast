[44.636529, "o", "def decompress_file(file_path: str) -> None:\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"Decompresses a .gz file.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     if not os.path.exists(file_path):\r\n\u001b[?2004l\r\u001b[?2004h>         raise FileNotFoundError(f\"File '{file_path}' does not exist.\")\r\n\u001b[?2004l\r\u001b[?2004h>     run_cmd(f\"gzip -d -k {file_path}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[44.636662, "o", "\u001b[?2004h> "]
[44.63803, "o", "def get_status(target_dir: str) -> str:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.639698, "o", "    \"\"\"Returns status summary of compressed vs uncompressed files.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     if not os.path.exists(target_dir):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.641413, "o", "        raise FileNotFoundError(f\"Directory '{target_dir}' does not exist.\")\r\n\u001b[?2004l\r\u001b[?2004h>     all_files = os.listdir(target_dir)\r\n\u001b[?2004l\r\u001b[?2004h>     gz_files = [f for f in all_files if f.endswith(\".gz\")]\r\n\u001b[?2004l\r\u001b[?2004h>     raw_files = [f for f in all_files if not f.endswith(\".gz\")]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.642259, "o", "    return f\"Total: {len(all_files)}, Compressed: {len(gz_files)}, Raw: {len(raw_files)}\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.642491, "o", "def main():\r\n\u001b[?2004l\r\u001b[?2004h>     parser = argparse.ArgumentParser(description=\"Log Compression Utility\")\r\n\u001b[?2004l\r"]
[44.643667, "o", "\u001b[?2004h>     subparsers = parser.add_subparsers(dest=\"command\", required=True)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     # compress command\r\n\u001b[?2004l\r\u001b[?2004h"]
[44.644411, "o", ">     comp_parser = subparsers.add_parser(\"compress\", help=\"Compress files in directory\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.64524, "o", "    comp_parser.add_argument(\"target_dir\", help=\"Directory containing log files\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.64603, "o", "    comp_parser.add_argument(\"--ext\", help=\"Only compress files with this extension (e.g. log or .log)\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     # decompress command\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.646924, "o", "    decomp_parser = subparsers.add_parser(\"decompress\", help=\"Decompress a .gz file\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.647442, "o", "    decomp_parser.add_argument(\"file_path\", help=\"Path to .gz file\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[44.647922, "o", "\u001b[?2004h>     # status command\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.648661, "o", "    status_parser = subparsers.add_parser(\"status\", help=\"Get compression status\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.649613, "o", "    status_parser.add_argument(\"target_dir\", help=\"Target directory\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.650076, "o", "    args = parser.parse_args()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.650675, "o", "    if args.command == \"compress\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.651726, "o", "        compress_directory(args.target_dir, args.ext)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.652045, "o", "    elif args.command == \"decompress\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.65266, "o", "        decompress_file(args.file_path)\r\n\u001b[?2004l\r\u001b[?2004h>     elif args.command == \"status\":\r\n\u001b[?2004l\r\u001b[?2004h>         print(get_status(args.target_dir))\r\n\u001b[?2004l\r"]
[44.653436, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> if __name__ == \"__main__\":\r\n\u001b[?2004l\r\u001b[?2004h"]
[44.654484, "o", ">     main()\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
