[49.636583, "i", "tmpdir=$(mktemp -d)\nprintf 'logdata' > \"$tmpdir/app.log\"\nprintf 'txtdata' > \"$tmpdir/readme.txt\"\nprintf 'nodata' > \"$tmpdir/notes\"\npython3 compressor.py compress \"$tmpdir\" --ext log\nfind \"$tmpdir\" -maxdepth 1 -type f -printf '%f\\n' | sort\nrm -rf \"$tmpdir\"\n"]
