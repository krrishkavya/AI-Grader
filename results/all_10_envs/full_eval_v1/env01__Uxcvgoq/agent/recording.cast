[88.320357, "o", "python -m py_compile archiver.py && sed -n '1,220p' archiver.py\r\n\u001b[?2004l\r"]
[88.382855, "o", "#!/usr/bin/env python3\r\nimport argparse\r\nimport fnmatch\r\nimport os\r\nimport sys\r\nimport tarfile\r\nfrom typing import Optional\r\n\r\nfrom utils.shell import run_cmd, run_argv\r\n\r\n\r\ndef _matches_exclude(archive_name: str, pattern: Optional[str]) -> bool:\r\n    \"\"\"\r\n    Return True when archive_name should be excluded by pattern.\r\n\r\n    Names stored by this utility are usually prefixed with './' because the\r\n    source directory is archived as '.'.  For user-friendly CLI behavior,\r\n    match both the stored archive name (for example './cache/file.log') and\r\n    the normalized relative name (for example 'cache/file.log').  Also match\r\n    the basename so simple patterns such as 'debug.log' work at any depth.\r\n    \"\"\"\r\n    if not pattern:\r\n        return False\r\n\r\n    normalized = archive_name.replace(os.sep, \"/\")\r\n    relative = normalized\r\n    while relative.startswith(\"./\"):\r\n        relative = relative[2:]\r\n    relative = relative.rstrip(\"/\")\r\n\r\n    # Never exclude the archive root itself for broad patterns like '*'.\r"]
[88.382959, "o", "\n    if normalized == \".\" or relative == \"\":\r\n        return False\r\n\r\n    candidates = [normalized, relative]\r\n    basename = os.path.basename(relative)\r\n    if basename:\r\n        candidates.append(basename)\r\n\r\n    return any(fnmatch.fnmatchcase(candidate, pattern) for candidate in candidates)\r\n\r\n\r\ndef create_archive(\r\n    source_dir: str,\r\n    output_path: str,\r\n    exclude: Optional[str] = None,\r\n    *,\r\n    exclude_pattern: Optional[str] = None,\r\n) -> None:\r\n    \"\"\"\r\n    Creates a compressed tar.gz archive from source_dir.\r\n\r\n    If exclude (or exclude_pattern) is provided, archive entries matching the\r\n    shell-style glob pattern are omitted. Examples: '*.tmp', '*.log', 'cache/*'.\r\n    \"\"\"\r\n    if not os.path.exists(source_dir):\r\n        raise FileNotFoundError(f\"Source directory '{source_dir}' does not exist.\")\r\n\r\n    # Backward-compatible alias for callers that use a descriptive keyword.\r\n    if exclude is None:\r\n        exclude = exclude_pattern\r\n\r\n    def archive_filter(tar_info: tarfile.TarInfo) -> "]
[88.382971, "o", "Optional[tarfile.TarInfo]:\r\n        if _matches_exclude(tar_info.name, exclude):\r\n            return None\r\n        return tar_info\r\n\r\n    with tarfile.open(output_path, \"w:gz\") as archive:\r\n        archive.add(source_dir, arcname=\".\", filter=archive_filter)\r\n\r\n\r\ndef list_archive(archive_path: str) -> str:\r\n    \"\"\"Lists files in the archive.\"\"\"\r\n    if not os.path.exists(archive_path):\r\n        raise FileNotFoundError(f\"Archive '{archive_path}' does not exist.\")\r\n    result = run_cmd(f\"tar -ztvf {archive_path}\")\r\n    return result.stdout\r\n\r\n\r\ndef extract_archive(archive_path: str, target_dir: str) -> None:\r\n    \"\"\"Extracts files from archive into target_dir.\"\"\"\r\n    if not os.path.exists(archive_path):\r\n        raise FileNotFoundError(f\"Archive '{archive_path}' does not exist.\")\r\n    os.makedirs(target_dir, exist_ok=True)\r\n    run_cmd(f\"tar -xzf {archive_path} -C {target_dir}\")\r\n\r\n\r\ndef main():\r\n    parser = argparse.ArgumentParser(description=\"System Archival Utility\")\r\n    subparsers = parser.add_subparsers("]
[88.382977, "o", "dest=\"command\", required=True)\r\n\r\n    # create command\r\n    create_parser = subparsers.add_parser(\"create\", help=\"Create a tar.gz archive\")\r\n    create_parser.add_argument(\"source_dir\", help=\"Directory to archive\")\r\n    create_parser.add_argument(\"output_path\", help=\"Target archive path\")\r\n    create_parser.add_argument(\r\n        \"--exclude\",\r\n        dest=\"exclude\",\r\n        help=\"Shell-style glob pattern to exclude from the archive (e.g. '*.tmp', '*.log', 'cache/*')\",\r\n    )\r\n\r\n    # list command\r\n    list_parser = subparsers.add_parser(\"list\", help=\"List archive contents\")\r\n    list_parser.add_argument(\"archive_path\", help=\"Path to archive\")\r\n\r\n    # extract command\r\n    extract_parser = subparsers.add_parser(\"extract\", help=\"Extract archive\")\r\n    extract_parser.add_argument(\"archive_path\", help=\"Path to archive\")\r\n    extract_parser.add_argument(\"target_dir\", help=\"Directory to extract to\")\r\n\r\n    args = parser.parse_args()\r\n\r\n    if args.command == \"create\":\r\n        create_archive(args.source_dir, args"]
[88.383206, "o", ".output_path, exclude=args.exclude)\r\n    elif args.command == \"list\":\r\n        print(list_archive(args.archive_path))\r\n    elif args.command == \"extract\":\r\n        extract_archive(args.archive_path, args.target_dir)\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n\u001b[?2004hroot@da2a131cc33a:/workspace# "]
[88.774065, "i", "tmp=$(mktemp -d)\nset -e\nmkdir -p \"$tmp/src/cache\" \"$tmp/extract\"\nprintf 'keep' > \"$tmp/src/keep.txt\"\nprintf 'tmp' > \"$tmp/src/scratch.tmp\"\nprintf 'log' > \"$tmp/src/debug.log\"\nprintf 'cache' > \"$tmp/src/cache/data.bin\"\nprintf 'cache tmp' > \"$tmp/src/cache/inner.tmp\"\n\npython archiver.py create \"$tmp/src\" \"$tmp/all.tar.gz\"\npython archiver.py list \"$tmp/all.tar.gz\" | tee \"$tmp/all.list\"\ngrep -q 'keep.txt' \"$tmp/all.list\"\ngrep -q 'scratch.tmp' \"$tmp/all.list\"\ngrep -q 'debug.log' \"$tmp/all.list\"\ngrep -q 'cache/data.bin' \"$tmp/all.list\"\n\npython archiver.py create \"$tmp/src\" \"$tmp/no_tmp.tar.gz\" --exclude '*.tmp'\npython archiver.py list \"$tmp/no_tmp.tar.gz\" | tee \"$tmp/no_tmp.list\"\ngrep -q 'keep.txt' \"$tmp/no_tmp.list\"\n! grep -q 'scratch.tmp' \"$tmp/no_tmp.list\"\n! grep -q 'cache/inner.tmp' \"$tmp/no_tmp.list\"\ngrep -q 'debug.log' \"$tmp/no_tmp.list\"\n\npython archiver.py create \"$tmp/src\" \"$tmp/no_cache.tar.gz\" --exclude 'cache/*'\npython archiver.py list \"$tmp/no_cache.tar.gz\" | tee \"$tmp/no_cache.list\"\ngrep -q 'keep.txt' "]
[88.774187, "i", "\"$tmp/no_cache.list\"\n! grep -q 'cache/data.bin' \"$tmp/no_cache.list\"\n! grep -q 'cache/inner.tmp' \"$tmp/no_cache.list\"\n\npython archiver.py extract \"$tmp/no_tmp.tar.gz\" \"$tmp/extract\"\ntest -f \"$tmp/extract/keep.txt\"\ntest ! -f \"$tmp/extract/scratch.tmp\"\nrm -rf \"$tmp\"\necho 'CLI exclusion smoke tests passed'\n"]
