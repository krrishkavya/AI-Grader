[14.907089, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('inventory_cli.py')\ns = p.read_text()\ns = s.replace(\n'''    sql = \"SELECT id, sku, warehouse_id, quantity, aisle FROM inventory WHERE is_damaged = 0 AND sku = ?\"\n    params = [sku]\n\n    cursor.execute(sql, params)\n''',\n'''    sql = \"SELECT id, sku, warehouse_id, quantity, aisle FROM inventory WHERE is_damaged = 0 AND sku = ?\"\n    params = [sku]\n\n    if warehouse is not None:\n        sql += \" AND warehouse_id = ?\"\n        params.append(warehouse)\n\n    cursor.execute(sql, params)\n''')\ns = s.replace(\n'''    look_p = subparsers.add_parser(\"lookup\", help=\"Look up stock by SKU\")\n    look_p.add_argument(\"sku\", help=\"Product SKU\")\n''',\n'''    look_p = subparsers.add_parser(\"lookup\", help=\"Look up stock by SKU\")\n    look_p.add_argument(\"sku\", help=\"Product SKU\")\n    look_p.add_argument(\"--warehouse\", help=\"Filter results by warehouse facility ID\")\n''')\np.write_text(s)\nPY\n"]
