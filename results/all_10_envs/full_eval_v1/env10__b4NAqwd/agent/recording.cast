[6.919707, "o", "import os\r\nimport sys\r\nimport pytest\r\n\r\nsys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))\r\nfrom init_db import init_database\r\nfrom notify_filter import filter_messages, list_channels, channel_stats\r\n\r\n@pytest.fixture(autouse=True)\r\ndef setup_db():\r\n    init_database()\r\n\r\ndef test_filter_messages():\r\n    messages = filter_messages(\"user101\")\r\n    assert len(messages) == 3\r\n\r\ndef test_list_channels():\r\n    chans = list_channels()\r\n    assert \"email\" in chans\r\n    assert \"sms\" in chans\r\n    assert \"push\" in chans\r\n\r\ndef test_channel_stats():\r\n    stats = channel_stats()\r\n    assert stats[\"email\"] >= 2\r\n    assert stats[\"sms\"] >= 2\r\n\u001b[?2004hroot@c53d2153b21f:/workspace# "]
[14.008357, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('notify_filter.py')\ns = p.read_text()\ns = s.replace('''    sql = \"SELECT id, recipient, channel, message, created_at FROM notifications WHERE delivered = 1 AND recipient = ?\"\\n    params = [recipient]\\n\\n    cursor.execute(sql, params)''', '''    sql = \"SELECT id, recipient, channel, message, created_at FROM notifications WHERE delivered = 1 AND recipient = ?\"\\n    params = [recipient]\\n\\n    if channel is not None:\\n        sql += \" AND channel = ?\"\\n        params.append(channel)\\n\\n    cursor.execute(sql, params)''')\ns = s.replace('''    msg_p = subparsers.add_parser(\"messages\", help=\"Query messages by recipient\")\\n    msg_p.add_argument(\"recipient\", help=\"Recipient ID\")''', '''    msg_p = subparsers.add_parser(\"messages\", help=\"Query messages by recipient\")\\n    msg_p.add_argument(\"recipient\", help=\"Recipient ID\")\\n    msg_p.add_argument(\"--channel\", help=\"Filter by communication channel\")''')\np.write_text(s)\nPY\npytest -q\npython3 notify_filter.py messages"]
