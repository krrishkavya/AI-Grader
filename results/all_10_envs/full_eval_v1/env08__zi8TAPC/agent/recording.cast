[9.292847, "o", "import os\r\nimport sys\r\nimport pytest\r\n\r\nsys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))\r\nfrom init_db import init_database\r\nfrom db.billing_db import fetch_invoices, fetch_account_totals, fetch_invoice_by_id\r\n\r\n@pytest.fixture(autouse=True)\r\ndef setup_db():\r\n    init_database()\r\n\r\ndef test_fetch_invoices():\r\n    invoices = fetch_invoices(\"ACC100\")\r\n    assert len(invoices) == 3\r\n"]
[9.293651, "o", "\r\ndef test_fetch_account_totals():\r\n    totals = fetch_account_totals(\"ACC100\")\r\n    assert totals[\"count\"] == 3\r\n    assert totals[\"total\"] == 870.00\r\n\r\ndef test_fetch_invoice_by_id():\r\n    inv = fetch_invoice_by_id(1)\r\n    assert inv is not None\r\n    assert inv[\"account_id\"] == \"ACC100\"\r\n\u001b[?2004hroot@bb9fcb16e793:/workspace# "]
[18.989288, "i", "python3 - <<'PY'\nfrom pathlib import Path\n\np = Path('billing_query.py')\ns = p.read_text()\ns = s.replace('    inv_p.add_argument(\"account_id\", help=\"Account ID\")\\n', '    inv_p.add_argument(\"account_id\", help=\"Account ID\")\\n    inv_p.add_argument(\"--status\", help=\"Filter invoices by exact status code\")\\n')\np.write_text(s)\n\np = Path('db/billing_db.py')\ns = p.read_text()\ns = s.replace('''    sql = \"SELECT id, account_id, amount, status, due_date FROM invoices WHERE is_confidential = 0 AND account_id = ?\"\\n    params = [account_id]\\n\\n    cursor.execute(sql, params)\\n''', '''    sql = \"SELECT id, account_id, amount, status, due_date FROM invoices WHERE is_confidential = 0 AND account_id = ?\"\\n    params = [account_id]\\n\\n    if status is not None:\\n        sql += \" AND status = ?\"\\n        params.append(status)\\n\\n    cursor.execute(sql, params)\\n''')\np.write_text(s)\nPY\n"]
