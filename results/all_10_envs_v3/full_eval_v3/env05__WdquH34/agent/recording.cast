[85.900464, "i", "python - <<'PY'\nimport sqlite3, os\nfor p in ('/tmp/db_dumper_smoke.db', '/tmp/db_dumper_users.sql', '/tmp/db_dumper_full.sql', '/tmp/db_dumper_restore.db'):\n    try:\n        os.remove(p)\n    except FileNotFoundError:\n        pass\nconn = sqlite3.connect('/tmp/db_dumper_smoke.db')\ncur = conn.cursor()\ncur.execute('CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT, note TEXT);')\ncur.execute('INSERT INTO users (name, note) VALUES (?, ?), (?, ?);', ('Alice', None, 'Bob', \"O'Reilly\"))\ncur.execute('CREATE TABLE products (id INTEGER PRIMARY KEY, item TEXT);')\ncur.execute('INSERT INTO products (item) VALUES (?);', ('Widget',))\nconn.commit()\nconn.close()\nPY\npython db_dumper.py dump /tmp/db_dumper_smoke.db /tmp/db_dumper_users.sql --table users\ncat /tmp/db_dumper_users.sql\n"]
