[86.086393, "o", "BEGIN TRANSACTION;\r\nCREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT, note TEXT);\r\nINSERT INTO \"users\" VALUES(1,'Alice',NULL);\r\nINSERT INTO \"users\" VALUES(2,'Bob','O''Reilly');\r\nCOMMIT;\r\n"]
