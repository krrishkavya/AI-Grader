[86.520931, "i", "if grep -q 'CREATE TABLE users' /tmp/db_dumper_users.sql && grep -q 'INSERT INTO \"users\"' /tmp/db_dumper_users.sql && ! grep -q 'products' /tmp/db_dumper_users.sql; then echo 'table-only dump OK'; else echo 'table-only dump FAILED'; exit 1; fi\npython db_dumper.py dump /tmp/db_dumper_smoke.db /tmp/db_dumper_full.sql\nif grep -q 'users' /tmp/db_dumper_full.sql && grep -q 'products' /tmp/db_dumper_full.sql; then echo 'full dump OK'; else echo 'full dump FAILED'; exit 1; fi\npython db_dumper.py tables /tmp/db_dumper_smoke.db\npython - <<'PY'\nimport sqlite3\nsrc = open('/tmp/db_dumper_users.sql').read()\nconn = sqlite3.connect('/tmp/db_dumper_restore.db')\nconn.executescript(src)\ncur = conn.cursor()\ncur.execute('SELECT COUNT(*), SUM(note IS NULL) FROM users')\nprint('restored users:', cur.fetchone())\ncur.execute(\"SELECT name FROM sqlite_master WHERE type='table'\")\nprint('restored tables:', [r[0] for r in cur.fetchall()])\nconn.close()\nPY\n"]
