[68.173915, "i", "tmpdir=$(mktemp -d)\nprintf '# Heading\\nBody text\\n' > \"$tmpdir/input.md\"\npython3 report_gen.py render \"$tmpdir/input.md\" \"$tmpdir/out.html\" --title Quarterly Review\npython3 report_gen.py validate \"$tmpdir/input.md\"\ngrep -E '<title>Quarterly Review</title>|<h1>Quarterly Review</h1>' \"$tmpdir/out.html\"\nrm -rf \"$tmpdir\"\n"]
