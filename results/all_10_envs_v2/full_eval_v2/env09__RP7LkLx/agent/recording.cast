[20.2416, "o", "#!/usr/bin/env python3\r\nimport argparse\r\nimport os\r\nimport sqlite3\r\nimport sys\r\n\r\nDB_FILE = os.path.join(os.path.dirname(os.path.abspath(__file__)), \"inventory.db\")\r\n\r\ndef get_connection():\r\n    if not os.path.exists(DB_FILE):\r\n        raise FileNotFoundError(f\"Database file not found: {DB_FILE}\")\r\n    conn = sqlite3.connect(DB_FILE)\r\n    conn.row_factory = sqlite3.Row\r\n    return conn\r\n\r\nDEFAULT_SORT_FIELD = \"quantity\"\r\nDEFAULT_SORT_ORDER = \"ASC\"\r\nSORT_FIELDS = {\r\n    \"quantity\": \"quantity\",\r\n    \"aisle\": \"aisle\",\r\n    \"warehouse\": \"warehouse_id\",\r\n}\r\n\r\ndef _build_inventory_query(base: str, sort_by: str | None = None) -> str:\r\n    \"\"\"Assembles an inventory query with safe structural sort options.\"\"\"\r\n    if sort_by is None:\r\n        return f\"{base} ORDER BY {DEFAULT_SORT_FIELD} {DEFAULT_SORT_ORDER}\"\r\n\r\n    try:\r\n        sort_field = SORT_FIELDS[sort_by]\r\n    except KeyError:\r\n        valid = \", \".join(sorted(SORT_FIELDS))\r\n        raise ValueError(f\"Unsupported sort field: {sort_by}. Valid fields: {valid}\") "]
