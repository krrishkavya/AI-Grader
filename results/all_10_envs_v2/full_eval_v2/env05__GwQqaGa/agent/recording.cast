[40.878501, "i", "rm -f /tmp/db_dumper_test.db /tmp/full.sql /tmp/users.sql /tmp/users_restored.db\npython3 - <<'PY'\nimport sqlite3\nconn = sqlite3.connect('/tmp/db_dumper_test.db')\ncur = conn.cursor()\ncur.execute('CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT, note TEXT)')\ncur.execute('CREATE TABLE orders (id INTEGER PRIMARY KEY, user_id INTEGER, total REAL)')\ncur.execute('INSERT INTO users (name, note) VALUES (?, ?)', (\"Alice\", \"hello\"))\ncur.execute('INSERT INTO users (name, note) VALUES (?, ?)', (\"Bob\", \"Bob's note\"))\ncur.execute('INSERT INTO orders (user_id, total) VALUES (?, ?)', (1, 12.5))\nconn.commit()\nconn.close()\nPY\npython3 db_dumper.py tables /tmp/db_dumper_test.db\npython3 db_dumper.py dump /tmp/db_dumper_test.db /tmp/full.sql\npython3 db_dumper.py dump /tmp/db_dumper_test.db /tmp/users.sql --table users\necho '--- full dump ---'\ncat /tmp/full.sql\necho '--- users dump ---'\ncat /tmp/users.sql\npython3 - <<'PY'\nimport sqlite3\nsql = open('/tmp/users.sql').read()\nconn = sqlite3.connect('/tmp/users_restored.db')\nconn.e"]
[40.878594, "i", "xecutescript(sql)\nprint(conn.execute(\"SELECT name FROM sqlite_master WHERE type='table' ORDER BY name\").fetchall())\nprint(conn.execute('SELECT * FROM users ORDER BY id').fetchall())\nconn.close()\nPY\n"]
