[14.728819, "i", ", \"''\")\\n            expressions = \", \".join([f\"quote(c{i})\" for i in range(col_count)])\\n\\n            if col_count:\\n                for values in cur.execute(\\n                    f'SELECT {expressions} FROM \"{escaped_table_name}\" AS t('\\n                    + \", \".join([f\"c{i}\" for i in range(col_count)])\\n                    + \")\"\\n                ):\\n                    f.write(\\n                        f\"INSERT INTO '{quoted_table_name}' VALUES(\"\\n                        + \",\".join(values)\\n                        + \");\\\\n\"\\n                    )\\n\\n            f.write(\"COMMIT;\\\\n\")\\n    finally:\\n        conn.close()\\n''')\ns = s.replace('''    dump_p.add_argument(\"db_path\", help=\"Path to SQLite DB\")\\n    dump_p.add_argument(\"output_path\", help=\"Output SQL dump file\")\\n''', '''    dump_p.add_argument(\"db_path\", help=\"Path to SQLite DB\")\\n    dump_p.add_argument(\"output_path\", help=\"Output SQL dump file\")\\n    dump_p.add_argument(\"--table\", help=\"Dump only the specified table\")\\n''')\np.write_text(s)\nPY\n"]
