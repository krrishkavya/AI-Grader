ument("--ext", help="Only compress files with this extension (e.g. log or .log)")\\n\')\ntext = text.replace(\'        compress_directory(args.target_dir)\\n\', \'        compress_directory(args.target_dir, args.ext)\\n\')\npath.write_text(text)\nPY\nsed -n \'1,220p\' compressor.py\npytest -q\n'] min_timeout_sec: 3.0 max_timeout_sec: 180.0
