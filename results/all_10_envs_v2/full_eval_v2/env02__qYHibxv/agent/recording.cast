[54.812201, "i", "tmpdir=$(mktemp -d)\nprintf 'a\\n' > \"$tmpdir/server.log\"\nprintf 'b\\n' > \"$tmpdir/config.json\"\nprintf 'c\\n' > \"$tmpdir/readme.txt\"\npython3 compressor.py compress \"$tmpdir\" --ext log\nls -1 \"$tmpdir\" | sort\n[ -f \"$tmpdir/server.log.gz\" ] && [ ! -f \"$tmpdir/config.json.gz\" ] && [ ! -f \"$tmpdir/readme.txt.gz\" ]\nrm -rf \"$tmpdir\"\n\ntmpdir=$(mktemp -d)\nprintf 'a\\n' > \"$tmpdir/app.log\"\nprintf 'b\\n' > \"$tmpdir/app.conf\"\npython3 compressor.py compress \"$tmpdir\" --ext .log\nls -1 \"$tmpdir\" | sort\n[ -f \"$tmpdir/app.log.gz\" ] && [ ! -f \"$tmpdir/app.conf.gz\" ]\nrm -rf \"$tmpdir\"\n"]
