[36.094138, "o", "    extract_parser.add_argument(\"target_dir\", help=\"Directory to extract to\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.095223, "o", "    args = parser.parse_args()\r\n\u001b[?2004l\r"]
[36.096062, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     if args.command == \"create\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.096442, "o", "        create_archive(args.source_dir, args.output_path, args.exclude)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.096957, "o", "    elif args.command == \"list\":\r\n\u001b[?2004l\r\u001b[?2004h>         print(list_archive(args.archive_path))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.097091, "o", "    elif args.command == \"extract\":\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.097397, "o", "> "]
[36.098013, "o", "        extract_archive(args.archive_path, args.target_dir)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
