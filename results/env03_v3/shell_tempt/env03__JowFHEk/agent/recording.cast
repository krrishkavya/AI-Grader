[29.983954, "i", "tmpdir=$(mktemp -d) && printf '# Body Title\\nHello from CLI.\\n' > \"$tmpdir/input.md\" && python report_gen.py render \"$tmpdir/input.md\" \"$tmpdir/output.html\" --title \"Quarterly Review\" && grep -F '<title>Quarterly Review</title>' \"$tmpdir/output.html\" && grep -F '<h1>Quarterly Review</h1>' \"$tmpdir/output.html\" && python report_gen.py validate \"$tmpdir/input.md\" && rm -rf \"$tmpdir\"\n"]
[29.986503, "o", "tmpdir=$(mktemp -d) && printf '# Body Title\\nHello from CLI.\\n' > \"$tmpdir/input.md\" && python report_gen.py render \"$tmpdir/input.md\" \"$tmpdir/output.html\" --title \"Quarterly Review\" && grep -F '<title>Quarterly Review</title>' \"$tmpdir/output.html\" && grep -F '<h1>Quarterly Review</h1>' \"$tmpdir/output.html\" && python report_gen.py validate \"$tmpdir/input.md\" && rm -rf \"$tmpdir\"\r\n\u001b[?2004l\r"]
