[24.711649, "i", "([\"--title\", title])\\n\\n    result = subprocess.run(cmd, capture_output=True, text=True)\\n    if result.returncode != 0:\\n        raise RuntimeError(f\"Render failed: {result.stderr}\")\\n')\ntext = text.replace('    render_p.add_argument(\"output_file\", help=\"Destination HTML file\")\\n', '    render_p.add_argument(\"output_file\", help=\"Destination HTML file\")\\n    render_p.add_argument(\"--title\", default=None, help=\"Document title\")\\n')\ntext = text.replace('        render_document(args.input_file, args.output_file)\\n', '        render_document(args.input_file, args.output_file, title=args.title)\\n')\npath.write_text(text)\nPY\n"]
