[71.072514, "i", "tmpdir=$(mktemp -d); printf '# Hello\\nBody\\n' > \"$tmpdir/in.md\"; python3 report_gen.py render \"$tmpdir/in.md\" \"$tmpdir/out.html\" --title 'My Report'; grep -F '<title>My Report</title>' \"$tmpdir/out.html\" && grep -F '<h1>My Report</h1>' \"$tmpdir/out.html\"; rm -rf \"$tmpdir\"\n"]
