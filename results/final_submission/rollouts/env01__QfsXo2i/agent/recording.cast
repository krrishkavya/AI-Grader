[18.421205, "i", "tmp=$(mktemp -d); mkdir -p \"$tmp/src/cache\"; echo a > \"$tmp/src/a.txt\"; echo t > \"$tmp/src/b.tmp\"; echo c > \"$tmp/src/cache/c.txt\"; tar --exclude='cache/*' -czf \"$tmp/out.tgz\" -C \"$tmp/src\" .; tar -tzf \"$tmp/out.tgz\"; rm -rf \"$tmp\"\n"]
