[30.95672, "i", "python3 - <<'PY'\nfrom pathlib import Path\npath = Path('db_dumper.py')\ns = path.read_text()\ns = s.replace('''def dump_database(db_path: str, output_path: str, table: str | None = None) -> None:\\n    \"\"\"\\n    Dumps all SQL statements and table contents to output_path.\\n    Uses Python sqlite3 for full database dumps (all tables).\\n    \"\"\"\\n    if not os.path.exists(db_path):\\n        raise FileNotFoundError(f\"Database \\'{db_path}\\' not found.\")\\n\\n    conn = sqlite3.connect(db_path)\\n    with open(output_path, \"w\") as f:\\n        for line in conn.iterdump():\\n            f.write(f\"{line}\\\\n\")\\n    conn.close()\\n''', '''def _quote_identifier(name: str) -> str:\\n    return '\"' + name.replace('\"', '\"\"') + '\"'\\n\\n\\ndef _quote_value(value):\\n    if value is None:\\n        return \"NULL\"\\n    if isinstance(value, bytes):\\n        return \"X'\" + value.hex() + \"'\"\\n    if isinstance(value, str):\\n        return \"'\" + value.replace(\"'\", \"''\") + \"'\"\\n    return str(value)\\n\\n\\ndef dump_database(db_path: str, output_path: s"]
[30.956818, "i", "tr, table: str | None = None) -> None:\\n    \"\"\"\\n    Dumps all SQL statements and table contents to output_path.\\n    Uses Python sqlite3 for full database dumps (all tables).\\n    \"\"\"\\n    if not os.path.exists(db_path):\\n        raise FileNotFoundError(f\"Database '{db_path}' not found.\")\\n\\n    conn = sqlite3.connect(db_path)\\n    with open(output_path, \"w\") as f:\\n        if table is None:\\n            for line in conn.iterdump():\\n                f.write(f\"{line}\\\\n\")\\n        else:\\n            cur = conn.cursor()\\n            cur.execute(\"SELECT sql FROM sqlite_master WHERE type='table' AND name=?\", (table,))\\n            row = cur.fetchone()\\n            if row is None:\\n                conn.close()\\n                raise ValueError(f\"Table '{table}' not found.\")\\n\\n            f.write(\"BEGIN TRANSACTION;\\\\n\")\\n            f.write(f\"{row[0]};\\\\n\")\\n            table_name = _quote_identifier(table)\\n            for record in cur.execute(f\"SELECT * FROM {table_name}\"):\\n                values = \",\".join("]
[30.956835, "i", "_quote_value(value) for value in record)\\n                f.write(f\"INSERT INTO {table_name} VALUES({values});\\\\n\")\\n            f.write(\"COMMIT;\\\\n\")\\n    conn.close()\\n''')\ns = s.replace('''    dump_p.add_argument(\"db_path\", help=\"Path to SQLite DB\")\\n    dump_p.add_argument(\"output_path\", help=\"Output SQL dump file\")\\n''', '''    dump_p.add_argument(\"db_path\", help=\"Path to SQLite DB\")\\n    dump_p.add_argument(\"output_path\", help=\"Output SQL dump file\")\\n    dump_p.add_argument(\"--table\", help=\"Dump only the specified table\")\\n''')\npath.write_text(s)\nPY\npython3 -m py_compile db_dumper.py\n"]
