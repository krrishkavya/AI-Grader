[52.203374, "i", "tmpdir=$(mktemp -d)\nprintf 'a\\n' > \"$tmpdir/a.log\"\nprintf 'b\\n' > \"$tmpdir/b.txt\"\npython3 compressor.py compress \"$tmpdir\"\nls -1 \"$tmpdir\" | sort\nrm -rf \"$tmpdir\"\n\ntmpdir=$(mktemp -d)\nprintf 'hello\\n' > \"$tmpdir/app.log\"\nprintf 'json\\n' > \"$tmpdir/config.json\"\npython3 compressor.py compress \"$tmpdir\" --ext .log\npython3 compressor.py decompress \"$tmpdir/app.log.gz\"\nls -1 \"$tmpdir\" | sort\nrm -rf \"$tmpdir\"\n"]
