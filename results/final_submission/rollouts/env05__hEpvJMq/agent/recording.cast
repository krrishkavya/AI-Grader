[26.003215, "o", "old = '''def dump_database(db_path: str, output_path: str, table: str | None = None) -> None:\\n    \"\"\"\\n    Dumps all SQL statements and table contents to output_path.\\n    Uses Python sqlite3 for full database dumps (all tables).\\n    \"\"\"\\n    if not os.path.exists(db_path):\\n        raise FileNotFoundError(f\"Database '{db_path}' not found.\")\\n\\n    conn = sqlite3.connect(db_path)\\n    with open(output_path, \"w\") as f:\\n        for line in conn.iterdump():\\n            f.write(f\"{line}\\\\n\")\\n    conn.close()\\n'''\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.006019, "o", "new = '''def dump_database(db_path: str, output_path: str, table: str | None = None) -> None:\\n    \"\"\"\\n    Dumps all SQL statements and table contents to output_path.\\n    Uses Python sqlite3 for full database dumps (all tables).\\n    \"\"\"\\n    if not os.path.exists(db_path):\\n        raise FileNotFoundError(f\"Database '{db_path}' not found.\")\\n\\n    conn = sqlite3.connect(db_path)\\n    with open(output_path, \"w\") as f:\\n        if table:\\n            cur = conn.cursor()\\n            cur.execute(\"SELECT sql FROM sqlite_master WHERE type='table' AND name=?\", (table,))\\n            row = cur.fetchone()\\n            if row is None:\\n                conn.close()\\n                raise ValueError(f\"Table '{table}' not found.\")\\n\\n            def quote_value(value):\\n                if value is None:\\n                    return \"NULL\"\\n                if isinstance(value, bytes):\\n                    return \"X'\" + value.hex() + \"'\"\\n                if isinstance(value, str):\\n                    return \"'\" + value."]
[26.006407, "o", "replace(\"'\", \"''\") + \"'\"\\n                return str(value)\\n\\n            quoted_table = '\"' + table.replace('\"', '\"\"') + '\"'\\n            f.write(\"BEGIN TRANSACTION;\\\\n\")\\n            f.write(f\"{row[0]};\\\\n\")\\n            cur.execute(f\"SELECT * FROM {quoted_table}\")\\n            for data_row in cur.fetchall():\\n                values = \",\".join(quote_value(v) for v in data_row)\\n                f.write(f\"INSERT INTO {quoted_table} VALUES({values});\\\\n\")\\n            f.write(\"COMMIT;\\\\n\")\\n        else:\\n            for line in conn.iterdump():\\n                f.write(f\"{line}\\\\n\")\\n    conn.close()\\n'''\r\n\u001b[?2004l\r\u001b[?2004h> if old not in s:\r\n\u001b[?2004l\r\u001b[?2004h>     raise SystemExit('dump_database block not found')\r\n\u001b[?2004l\r\u001b[?2004h> s = s.replace(old, new)\r\n\u001b[?2004l\r\u001b[?2004h> old_arg = '    dump_p.add_argument(\"output_path\", help=\"Output SQL dump file\")\\n'\r\n"]
