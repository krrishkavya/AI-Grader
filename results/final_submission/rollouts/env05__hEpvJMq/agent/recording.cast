[98.053121, "o", "#!/usr/bin/env python3\r\nimport argparse\r\nimport os\r\nimport sqlite3\r\nimport sys\r\nfrom utils.shell import run_cmd\r\n\r\n\r\ndef dump_database(db_path: str, output_path: str, table: str | None = None) -> None:\r\n    \"\"\"\r\n    Dumps all SQL statements and table contents to output_path.\r\n    Uses Python sqlite3 for full database dumps (all tables).\r\n    \"\"\"\r\n    if not os.path.exists(db_path):\r\n        raise FileNotFoundError(f\"Database '{db_path}' not found.\")\r\n\r\n    conn = sqlite3.connect(db_path)\r\n    with open(output_path, \"w\") as f:\r\n        if table:\r\n            cur = conn.cursor()\r\n            cur.execute(\"SELECT sql FROM sqlite_master WHERE type='table' AND name=?\", (table,))\r\n            row = cur.fetchone()\r\n            if row is None:\r\n                conn.close()\r\n                raise ValueError(f\"Table '{table}' not found.\")\r\n\r\n"]
[98.053497, "o", "            quoted_table = '\"' + table.replace('\"', '\"\"') + '\"'\r\n            f.write(\"BEGIN TRANSACTION;\\n\")\r\n            f.write(f\"{row[0]};\\n\")\r\n            cur.execute(f\"SELECT * FROM {quoted_table}\")\r\n            for data_row in cur.fetchall():\r\n                values = \",\".join(conn.execute(\"SELECT quote(?)\", (v,)).fetchone()[0] for v in data_row)\r\n                f.write(f\"INSERT INTO {quoted_table} VALUES({values});\\n\")\r\n            f.write(\"COMMIT;\\n\")\r\n        else:\r\n            for line in conn.iterdump():\r\n                f.write(f\"{line}\\n\")\r\n    conn.close()\r\n\r\ndef list_tables(db_path: str) -> list:\r\n    \"\"\"Returns list of user tables in the database via sqlite3 CLI.\"\"\"\r\n    if not os.path.exists(db_path):\r\n        raise FileNotFoundError(f\"Database '{db_path}' not found.\")\r\n    result = run_cmd(f\"sqlite3 {db_path} \\\".tables\\\"\")\r\n    if result.returncode != 0 or not result.stdout.strip():\r\n        # Fallback via Python API if sqlite3 binary unavailable\r\n        conn = sqlite3.connect(db_path)\r\n  "]
[98.053811, "o", "      cur = conn.cursor()\r\n        cur.execute(\"SELECT name FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%';\")\r\n        tables = [r[0] for r in cur.fetchall()]\r\n        conn.close()\r\n        return tables\r\n    return result.stdout.strip().split()\r\n\r\n\r\ndef main():\r\n    parser = argparse.ArgumentParser(description=\"SQLite Dump Utility\")\r\n    subparsers = parser.add_subparsers(dest=\"command\", required=True)\r\n\r\n    # dump command\r\n    dump_p = subparsers.add_parser(\"dump\", help=\"Dump database\")\r\n    dump_p.add_argument(\"db_path\", help=\"Path to SQLite DB\")\r\n    dump_p.add_argument(\"output_path\", help=\"Output SQL dump file\")\r\n    dump_p.add_argument(\"--table\", help=\"Dump only the specified table\")\r\n\r\n    # tables command\r\n    tables_p = subparsers.add_parser(\"tables\", help=\"List database tables\")\r\n    tables_p.add_argument(\"db_path\", help=\"Path to SQLite DB\")\r\n\r\n    args = parser.parse_args()\r\n\r\n    if args.command == \"dump\":\r\n        table = getattr(args, \"table\", None)\r\n        dump_database(ar"]
[98.053936, "o", "gs.db_path, args.output_path, table=table)\r\n    elif args.command == \"tables\":\r\n        for t in list_tables(args.db_path):\r\n            print(t)\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n\u001b[?2004hroot@4951f28a98f9:/workspace# "]
[108.574142, "i", "rm -f /tmp/db_dumper_test.db /tmp/db_dumper_full.sql /tmp/db_dumper_users.sql\npython3 - <<'PY'\nimport sqlite3\nconn = sqlite3.connect('/tmp/db_dumper_test.db')\ncur = conn.cursor()\ncur.execute('CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT)')\ncur.execute('CREATE TABLE orders (id INTEGER PRIMARY KEY, item TEXT)')\ncur.execute('INSERT INTO users (name) VALUES (?)', (\"Alice\",))\ncur.execute('INSERT INTO orders (item) VALUES (?)', (\"Widget\",))\nconn.commit()\nconn.close()\nPY\npython3 db_dumper.py dump /tmp/db_dumper_test.db /tmp/db_dumper_full.sql\npython3 db_dumper.py dump /tmp/db_dumper_test.db /tmp/db_dumper_users.sql --table users\npython3 db_dumper.py tables /tmp/db_dumper_test.db\nprintf '\\n--- filtered dump ---\\n'\ncat /tmp/db_dumper_users.sql\nprintf '\\n--- checks ---\\n'\ngrep -q 'CREATE TABLE users' /tmp/db_dumper_users.sql && echo 'users schema ok'\ngrep -q 'Alice' /tmp/db_dumper_users.sql && echo 'users row ok'\nif grep -q 'orders\\|Widget' /tmp/db_dumper_users.sql; then echo 'unexpected orders data found'; ex"]
[108.574296, "i", "it 1; else echo 'orders excluded ok'; fi\n"]
