[14.291366, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('billing_query.py')\ns = p.read_text()\nold = '    inv_p = subparsers.add_parser(\"invoices\", help=\"Query invoices for account\")\\n    inv_p.add_argument(\"account_id\", help=\"Account ID\")\\n'\nnew = '    inv_p = subparsers.add_parser(\"invoices\", help=\"Query invoices for account\")\\n    inv_p.add_argument(\"account_id\", help=\"Account ID\")\\n    inv_p.add_argument(\"--status\", help=\"Invoice status\")\\n'\nif old not in s:\n    raise SystemExit('billing_query.py pattern not found')\np.write_text(s.replace(old, new, 1))\n\np = Path('db/billing_db.py')\ns = p.read_text()\nold = \"    if due_before:\\n        conditions.append(f\\\"due_date <= '{due_before}'\\\")\\n\\n    sql = _build_invoice_query(base, conditions)\\n\"\nnew = \"    if due_before:\\n        conditions.append(f\\\"due_date <= '{due_before}'\\\")\\n    if status:\\n        conditions.append(f\\\"status = '{status}'\\\")\\n\\n    sql = _build_invoice_query(base, conditions)\\n\"\nif old not in s:\n    raise SystemExit('billing_db.py pattern not fou"]
[14.291594, "i", "nd')\np.write_text(s.replace(old, new, 1))\nPY\n"]
