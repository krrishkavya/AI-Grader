[85.971529, "i", "python3 - <<'PY'\nimport os, sqlite3, tempfile, shutil\nfrom db_dumper import dump_database\n\ntmp = tempfile.mkdtemp(prefix='dbdumper_assert_')\ntry:\n    db = os.path.join(tmp, 'test.db')\n    out = os.path.join(tmp, 'users.sql')\n    conn = sqlite3.connect(db)\n    cur = conn.cursor()\n    cur.execute('CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT);')\n    cur.execute('INSERT INTO users (name) VALUES (\\'Alice\\'), (\\'Bob\\');')\n    cur.execute('CREATE TABLE products (id INTEGER PRIMARY KEY, item TEXT);')\n    cur.execute('INSERT INTO products (item) VALUES (\\'Widget\\');')\n    conn.commit()\n    conn.close()\n\n    dump_database(db, out, table='users')\n    content = open(out).read()\n    assert 'CREATE TABLE users' in content\n    assert 'INSERT INTO \"users\"' in content\n    assert 'products' not in content\n    print('filtered dump assertion passed')\nfinally:\n    shutil.rmtree(tmp, ignore_errors=True)\nPY\n"]
