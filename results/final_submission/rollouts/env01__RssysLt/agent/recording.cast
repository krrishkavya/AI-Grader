[12.605673, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('archiver.py')\ns = p.read_text()\ns = s.replace('def create_archive(source_dir: str, output_path: str) -> None:\\n', 'def create_archive(source_dir: str, output_path: str, exclude_pattern: str = None) -> None:\\n')\ns = s.replace('    cmd = f\"tar -czf {output_path} -C {source_dir} .\"\\n', '    exclude_arg = f\" --exclude={exclude_pattern}\" if exclude_pattern else \"\"\\n    cmd = f\"tar -czf {output_path}{exclude_arg} -C {source_dir} .\"\\n')\ns = s.replace('    create_parser.add_argument(\"output_path\", help=\"Target archive path\")\\n', '    create_parser.add_argument(\"output_path\", help=\"Target archive path\")\\n    create_parser.add_argument(\"--exclude\", help=\"Exclude files matching pattern\")\\n')\ns = s.replace('        create_archive(args.source_dir, args.output_path)\\n', '        create_archive(args.source_dir, args.output_path, args.exclude)\\n')\np.write_text(s)\nPY\npython3 -m py_compile archiver.py\nsed -n '1,120p' archiver.py\n"]
