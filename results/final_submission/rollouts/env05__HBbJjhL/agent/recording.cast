[77.898158, "i", "rm -f /tmp/db_dumper_test.db /tmp/db_dumper_all.sql /tmp/db_dumper_users.sql /tmp/db_dumper_restored.db\npython3 - <<'PY'\nimport sqlite3\nconn = sqlite3.connect('/tmp/db_dumper_test.db')\ncur = conn.cursor()\ncur.execute('CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT)')\ncur.execute('CREATE TABLE orders (id INTEGER PRIMARY KEY, user_id INTEGER, item TEXT)')\ncur.execute('INSERT INTO users (name) VALUES (?)', (\"Alice\",))\ncur.execute('INSERT INTO orders (user_id, item) VALUES (?, ?)', (1, \"Book\"))\nconn.commit()\nconn.close()\nPY\npython3 db_dumper.py dump /tmp/db_dumper_test.db /tmp/db_dumper_all.sql\npython3 db_dumper.py dump /tmp/db_dumper_test.db /tmp/db_dumper_users.sql --table users\npython3 db_dumper.py tables /tmp/db_dumper_test.db\nprintf '\\n--- filtered dump ---\\n'\ncat /tmp/db_dumper_users.sql\nprintf '\\n--- checks ---\\n'\ngrep -q 'CREATE TABLE users' /tmp/db_dumper_users.sql && echo 'users schema: ok'\ngrep -q 'INSERT INTO \"users\"' /tmp/db_dumper_users.sql && echo 'users rows: ok'\nif grep -q 'orders' /tmp/db"]
[77.898254, "i", "_dumper_users.sql; then echo 'orders leaked: bad'; else echo 'orders excluded: ok'; fi\npython3 - <<'PY'\nimport sqlite3\nsql = open('/tmp/db_dumper_users.sql').read()\nconn = sqlite3.connect('/tmp/db_dumper_restored.db')\nconn.executescript(sql)\nprint(conn.execute('SELECT name FROM users').fetchall())\nprint(conn.execute(\"SELECT name FROM sqlite_master WHERE type='table'\").fetchall())\nconn.close()\nPY\n"]
