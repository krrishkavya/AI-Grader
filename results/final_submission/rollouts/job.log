\\n")\\n            table_name = _quote_identifier(table)\\n            for record in cur.execute(f"SELECT * FROM {table_name}"):\\n                values = ",".join(_quote_value(value) for value in record)\\n                f.write(f"INSERT INTO {table_name} VALUES({values});\\\\n")\\n            f.write("COMMIT;\\\\n")\\n    conn.close()\\n\'\'\')\ns = s.replace(\'\'\'    dump_p.add_argument("db_path", help="Path to SQLite DB")\\n    dump_p.add_argument("output_path", help="Output SQL dump file")\\n\'\'\', \'\'\'    dump_p.add_argument("db_path", help="Path to SQLite DB")\\n    dump_p.add_argument("output_path", help="Output SQL dump file")\\n    dump_p.add_argument("--table", help="Dump only the specified table")\\n\'\'\')\npath.write_text(s)\nPY\npython3 -m py_compile db_dumper.py\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
