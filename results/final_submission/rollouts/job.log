}")\\n            for data_row in cur.fetchall():\\n                values = ",".join(quote_value(v) for v in data_row)\\n                f.write(f"INSERT INTO {quoted_table} VALUES({values});\\\\n")\\n            f.write("COMMIT;\\\\n")\\n        else:\\n            for line in conn.iterdump():\\n                f.write(f"{line}\\\\n")\\n    conn.close()\\n\'\'\'\nif old not in s:\n    raise SystemExit(\'dump_database block not found\')\ns = s.replace(old, new)\nold_arg = \'    dump_p.add_argument("output_path", help="Output SQL dump file")\\n\'\nnew_arg = old_arg + \'    dump_p.add_argument("--table", help="Dump only the specified table")\\n\'\nif old_arg not in s:\n    raise SystemExit(\'output_path arg not found\')\ns = s.replace(old_arg, new_arg, 1)\np.write_text(s)\nPY\nsed -n \'1,220p\' db_dumper.py\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
