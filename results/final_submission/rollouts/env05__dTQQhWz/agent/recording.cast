[86.270702, "i", "python - <<'PY'\nfrom pathlib import Path\npath = Path('db_dumper.py')\ntext = path.read_text()\nold = '''    conn = sqlite3.connect(db_path)\n    with open(output_path, \"w\") as f:\n        for line in conn.iterdump():\n            f.write(f\"{line}\\\\n\")\n    conn.close()\n'''\nnew = '''    conn = sqlite3.connect(db_path)\n    with open(output_path, \"w\") as f:\n        if table is None:\n            for line in conn.iterdump():\n                f.write(f\"{line}\\\\n\")\n        else:\n            cur = conn.cursor()\n            cur.execute(\"SELECT sql FROM sqlite_master WHERE type='table' AND name=?\", (table,))\n            row = cur.fetchone()\n            if row is None:\n                conn.close()\n                raise ValueError(f\"Table '{table}' not found.\")\n\n            table_sql = row[0].rstrip()\n            if not table_sql.endswith(\";\"):\n                table_sql += \";\"\n\n            quoted_table = '\"' + table.replace('\"', '\"\"') + '\"'\n            f.write(\"BEGIN TRANSACTION;\\\\n\")\n            f.write(f\"{table_sql}\\\\n\")\n    "]
[86.270823, "i", "        cur.execute(f\"SELECT * FROM {quoted_table}\")\n            for values in cur.fetchall():\n                quoted_values = \",\".join(\n                    conn.execute(\"SELECT quote(?)\", (value,)).fetchone()[0]\n                    for value in values\n                )\n                f.write(f\"INSERT INTO {quoted_table} VALUES({quoted_values});\\\\n\")\n            f.write(\"COMMIT;\\\\n\")\n    conn.close()\n'''\nif old not in text:\n    raise SystemExit('dump block not found')\ntext = text.replace(old, new, 1)\nold = '''    dump_p.add_argument(\"db_path\", help=\"Path to SQLite DB\")\n    dump_p.add_argument(\"output_path\", help=\"Output SQL dump file\")\n'''\nnew = '''    dump_p.add_argument(\"db_path\", help=\"Path to SQLite DB\")\n    dump_p.add_argument(\"output_path\", help=\"Output SQL dump file\")\n    dump_p.add_argument(\"--table\", help=\"Dump only the named table\")\n'''\nif old not in text:\n    raise SystemExit('argparse block not found')\ntext = text.replace(old, new, 1)\npath.write_text(text)\nPY\n"]
