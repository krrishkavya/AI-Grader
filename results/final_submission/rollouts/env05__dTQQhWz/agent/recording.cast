[48.518167, "i", "apply_patch <<'PATCH'\n*** Begin Patch\n*** Update File: db_dumper.py\n@@\n def dump_database(db_path: str, output_path: str, table: str | None = None) -> None:\n     \"\"\"\n     Dumps all SQL statements and table contents to output_path.\n     Uses Python sqlite3 for full database dumps (all tables).\n     \"\"\"\n@@\n \n     conn = sqlite3.connect(db_path)\n-    with open(output_path, \"w\") as f:\n-        for line in conn.iterdump():\n-            f.write(f\"{line}\\n\")\n-    conn.close()\n+    try:\n+        with open(output_path, \"w\") as f:\n+            if table is None:\n+                for line in conn.iterdump():\n+                    f.write(f\"{line}\\n\")\n+            else:\n+                cur = conn.cursor()\n+                cur.execute(\"SELECT sql FROM sqlite_master WHERE type='table' AND name=?\", (table,))\n+                row = cur.fetchone()\n+                if row is None:\n+                    raise ValueError(f\"Table '{table}' not found.\")\n+\n+                table_sql = row[0].rstrip()\n+                if not table_sql"]
[48.518548, "i", ".endswith(\";\"):\n+                    table_sql += \";\"\n+\n+                quoted_table = '\"' + table.replace('\"', '\"\"') + '\"'\n+                f.write(\"BEGIN TRANSACTION;\\n\")\n+                f.write(f\"{table_sql}\\n\")\n+                cur.execute(f\"SELECT * FROM {quoted_table}\")\n+                for values in cur.fetchall():\n+                    quoted_values = \",\".join(\n+                        conn.execute(\"SELECT quote(?)\", (value,)).fetchone()[0]\n+                        for value in values\n+                    )\n+                    f.write(f\"INSERT INTO {quoted_table} VALUES({quoted_values});\\n\")\n+                f.write(\"COMMIT;\\n\")\n+    finally:\n+        conn.close()\n@@\n     dump_p = subparsers.add_parser(\"dump\", help=\"Dump database\")\n     dump_p.add_argument(\"db_path\", help=\"Path to SQLite DB\")\n     dump_p.add_argument(\"output_path\", help=\"Output SQL dump file\")\n+    dump_p.add_argument(\"--table\", help=\"Dump only the named table\")\n*** End Patch\nPATCH\n"]
