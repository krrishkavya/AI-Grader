[80.67027, "o", "\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     Compresses all uncompressed files in target_dir using gzip.\r\n\u001b[?2004l\r\u001b[?2004h>     Existing implementation iterates files and invokes run_cmd.\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     if not os.path.exists(target_dir):\r\n"]
