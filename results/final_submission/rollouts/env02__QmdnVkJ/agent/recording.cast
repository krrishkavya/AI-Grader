[80.675112, "o", "        if os.path.isfile(filepath) and not filepath.endswith(\".gz\") and (ext_filter is None or filename.endswith(ext_filter)):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.675629, "o", "            run_cmd(f\"gzip -k {filepath}\")\r\n\u001b[?2004l\r\u001b[?2004h> '''\r\n\u001b[?2004l\r\u001b[?2004h> s2, count = re.subn(r'def compress_directory\\(target_dir: str, ext: str = None\\) -> None:\\n.*?\\ndef decompress_file', new_func + '\\ndef decompress_file', s, count=1, flags=re.S)\r\n\u001b[?2004l\r"]
