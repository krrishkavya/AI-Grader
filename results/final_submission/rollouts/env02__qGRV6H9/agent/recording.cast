[69.789649, "i", "python3 - <<'PY'\nfrom pathlib import Path\npath = Path('compressor.py')\nlines = path.read_text().splitlines()\nif not any('if ext and not ext.startswith' in line for line in lines):\n    for i, line in enumerate(lines):\n        if line == '    for filename in os.listdir(target_dir):':\n            lines[i:i] = [\n                '    if ext and not ext.startswith(\".\"):',\n                '        ext = f\".{ext}\"',\n                ''\n            ]\n            break\n    else:\n        raise SystemExit('for loop insertion point not found')\npath.write_text('\\n'.join(lines) + '\\n')\nPY\n"]
