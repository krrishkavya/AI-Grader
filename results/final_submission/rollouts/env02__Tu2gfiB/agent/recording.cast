[53.109399, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('compressor.py')\ns = p.read_text()\nif 'if ext and not ext.startswith(\".\"):' not in s:\n    marker = '    for filename in os.listdir(target_dir):\\n'\n    idx = s.find(marker)\n    if idx == -1:\n        raise SystemExit('compression loop not found')\n    block = '    if ext and not ext.startswith(\".\"):\\n        ext = f\".{ext}\"\\n\\n'\n    s = s[:idx] + block + s[idx:]\n    p.write_text(s)\nPY\nsed -n '1,90p' compressor.py\npython3 -m py_compile compressor.py\n"]
