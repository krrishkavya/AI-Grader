[20.029618, "i", "tmp=$(mktemp -d)\nprintf 'log data\\n' > \"$tmp/app.log\"\nprintf 'text data\\n' > \"$tmp/readme.txt\"\nprintf 'other data\\n' > \"$tmp/other\"\npython3 compressor.py compress \"$tmp\" --ext log\nls -1 \"$tmp\" | sort\ntest -f \"$tmp/app.log.gz\" && test ! -f \"$tmp/readme.txt.gz\" && test ! -f \"$tmp/other.gz\"\nrm -rf \"$tmp\"\n"]
