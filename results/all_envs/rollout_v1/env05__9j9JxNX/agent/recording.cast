[70.763838, "o", "    cur.execute(\"SELECT name FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%';\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.764345, "o", "    tables = [r[0] for r in cur.fetchall()]\r\n\u001b[?2004l\r\u001b[?2004h>     conn.close()\r\n\u001b[?2004l\r\u001b[?2004h>     return tables\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def main():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.764677, "o", "    parser = argparse.ArgumentParser(description=\"SQLite Dump Utility\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.764978, "o", "    subparsers = parser.add_subparsers(dest=\"command\", required=True)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     # dump command\r\n\u001b[?2004l\r\u001b[?2004h>     dump_p = subparsers.add_parser(\"dump\", help=\"Dump database\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
