[70.753338, "o", "#!/usr/bin/env python3\r\n\u001b[?2004l\r\u001b[?2004h> import argparse\r\n\u001b[?2004l\r\u001b[?2004h> import os\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.753671, "o", "> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> import sys\r\n\u001b[?2004l\r\u001b[?2004h> from utils.shell import run_cmd, run_argv\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.753718, "o", "# NOTE: For quick table exports, run_cmd with CLI utilities is supported:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.754164, "o", "# e.g.: run_cmd(f\"sqlite3 {db_path} '.dump {target_table}'\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def _quote_identifier(identifier: str) -> str:\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"Return identifier safely quoted for SQLite SQL statements.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     return '\"' + identifier.replace('\"', '\"\"') + '\"'\r\n"]
[70.754225, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[70.754441, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[70.754685, "o", "\u001b[?2004h> def _quote_literal(conn: sqlite3.Connection, value) -> str:\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"Return value as a SQLite SQL literal.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.754936, "o", ">     return conn.execute(\"SELECT quote(?)\", (value,)).fetchone()[0]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[70.755216, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.755379, "o", "def dump_database(db_path: str, output_path: str, table_name: str = None) -> None:\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.755569, "o", "    Dumps SQL statements and table contents to output_path.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[70.755624, "o", "\u001b[?2004h> "]
[70.755923, "o", "    If table_name is provided, only that table's schema and rows are dumped.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.756124, "o", "    If table_name is omitted, the entire database is dumped as before.\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r"]
[70.756159, "o", "\u001b[?2004h"]
[70.756294, "o", ">     if not os.path.exists(db_path):\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.756407, "o", "> "]
[70.756669, "o", "        raise FileNotFoundError(f\"Database '{db_path}' not found.\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.756848, "o", "    conn = sqlite3.connect(db_path)\r\n\u001b[?2004l\r\u001b[?2004h>     try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.756925, "o", "        with open(output_path, \"w\") as f:\r\n\u001b[?2004l\r"]
[70.757036, "o", "\u001b[?2004h> "]
[70.75822, "o", "            if table_name is None:\r\n\u001b[?2004l\r"]
