[76.666086, "i", "python3 - <<'PY'\nimport os, sqlite3, tempfile, subprocess, sys\nwith tempfile.TemporaryDirectory() as d:\n    db = os.path.join(d, 'test.db')\n    conn = sqlite3.connect(db)\n    cur = conn.cursor()\n    cur.execute('CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT);')\n    cur.execute(\"INSERT INTO users (name) VALUES ('Alice'), ('Bob');\")\n    cur.execute('CREATE TABLE products (id INTEGER PRIMARY KEY, item TEXT);')\n    cur.execute(\"INSERT INTO products (item) VALUES ('Widget');\")\n    conn.commit(); conn.close()\n    full = os.path.join(d, 'full.sql')\n    users = os.path.join(d, 'users.sql')\n    subprocess.run([sys.executable, 'db_dumper.py', 'dump', db, full], check=True)\n    subprocess.run([sys.executable, 'db_dumper.py', 'dump', db, users, '--table', 'users'], check=True)\n    full_s = open(full).read()\n    users_s = open(users).read()\n    assert 'users' in full_s and 'products' in full_s\n    assert 'CREATE TABLE users' in users_s and 'Alice' in users_s and 'Bob' in users_s\n    assert 'products' not in users_"]
[76.666373, "i", "s and 'Widget' not in users_s\nprint('manual filtered dump check passed')\nPY\n"]
