[70.760446, "o", "            table_sql = row[0]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.761111, "o", "            quoted_table = _quote_identifier(table_name)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>             f.write(\"BEGIN TRANSACTION;\\n\")\r\n\u001b[?2004l\r\u001b[?2004h>             f.write(f\"{table_sql};\\n\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.761543, "o", "            for data_row in conn.execute(f\"SELECT * FROM {quoted_table}\"):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.76169, "o", "                values = \",\".join(_quote_literal(conn, value) for value in data_row)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.762258, "o", "                f.write(f\"INSERT INTO {quoted_table} VALUES({values});\\n\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>             f.write(\"COMMIT;\\n\")\r\n\u001b[?2004l\r\u001b[?2004h>     finally:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.762483, "o", "        conn.close()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.762687, "o", "def list_tables(db_path: str) -> list:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.763026, "o", "    \"\"\"Returns list of user tables in the database.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.763148, "o", "    if not os.path.exists(db_path):\r\n\u001b[?2004l\r\u001b[?2004h>         raise FileNotFoundError(f\"Database '{db_path}' not found.\")\r\n\u001b[?2004l\r"]
[70.763162, "o", "\u001b[?2004h> "]
