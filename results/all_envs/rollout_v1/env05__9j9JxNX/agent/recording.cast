[70.758684, "o", "\u001b[?2004h> "]
[70.758844, "o", "                \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.759069, "o", "                SELECT sql\r\n\u001b[?2004l\r\u001b[?2004h>                 FROM sqlite_master\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.759545, "o", "                WHERE type = 'table'\r\n\u001b[?2004l\r\u001b[?2004h>                   AND name = ?\r\n\u001b[?2004l\r\u001b[?2004h>                   AND name NOT LIKE 'sqlite_%'\r\n\u001b[?2004l\r\u001b[?2004h>                 \"\"\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
