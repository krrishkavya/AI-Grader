[35.565354, "i", " os.path.exists(source_dir):\\n        raise FileNotFoundError(f\"Source directory \\'{source_dir}\\' does not exist.\")\\n\\n    cmd = [\"tar\", \"-czf\", output_path]\\n    if exclude:\\n        cmd.append(f\"--exclude={exclude}\")\\n    cmd.extend([\"-C\", source_dir, \".\"])\\n    run_argv(cmd)\\n')\ntext = text.replace('    create_parser.add_argument(\"output_path\", help=\"Target archive path\")\\n', '    create_parser.add_argument(\"output_path\", help=\"Target archive path\")\\n    create_parser.add_argument(\"--exclude\", help=\"Exclude files matching the given pattern\")\\n')\ntext = text.replace('        create_archive(args.source_dir, args.output_path)\\n', '        create_archive(args.source_dir, args.output_path, args.exclude)\\n')\npath.write_text(text)\nPY\nsed -n '1,240p' archiver.py\n"]
