[91.767861, "i", "set -e\nrm -rf /tmp/archiver_cli_test\nmkdir -p /tmp/archiver_cli_test/src/cache /tmp/archiver_cli_test/src/logs\nprintf 'keep' > /tmp/archiver_cli_test/src/keep.txt\nprintf 'tmp' > /tmp/archiver_cli_test/src/drop.tmp\nprintf 'log' > /tmp/archiver_cli_test/src/logs/app.log\nprintf 'cache' > /tmp/archiver_cli_test/src/cache/item.dat\n\npython3 archiver.py create /tmp/archiver_cli_test/src /tmp/archiver_cli_test/all.tar.gz\npython3 archiver.py create /tmp/archiver_cli_test/src /tmp/archiver_cli_test/no_tmp.tar.gz --exclude '*.tmp'\npython3 archiver.py create /tmp/archiver_cli_test/src /tmp/archiver_cli_test/no_log.tar.gz --exclude '*.log'\npython3 archiver.py create /tmp/archiver_cli_test/src /tmp/archiver_cli_test/no_cache.tar.gz --exclude 'cache/*'\n\necho '--- all archive ---'\ntar -tzf /tmp/archiver_cli_test/all.tar.gz | sort\ntar -tzf /tmp/archiver_cli_test/all.tar.gz | grep -qx './keep.txt'\ntar -tzf /tmp/archiver_cli_test/all.tar.gz | grep -qx './drop.tmp'\ntar -tzf /tmp/archiver_cli_test/all.tar.gz | grep -qx './logs/ap"]
[91.767972, "i", "p.log'\ntar -tzf /tmp/archiver_cli_test/all.tar.gz | grep -qx './cache/item.dat'\n\necho '--- no tmp archive ---'\ntar -tzf /tmp/archiver_cli_test/no_tmp.tar.gz | sort\ntar -tzf /tmp/archiver_cli_test/no_tmp.tar.gz | grep -qx './keep.txt'\nif tar -tzf /tmp/archiver_cli_test/no_tmp.tar.gz | grep -qx './drop.tmp'; then echo 'ERROR: .tmp file was not excluded' >&2; exit 1; fi\n\necho '--- no log archive ---'\ntar -tzf /tmp/archiver_cli_test/no_log.tar.gz | sort\ntar -tzf /tmp/archiver_cli_test/no_log.tar.gz | grep -qx './keep.txt'\nif tar -tzf /tmp/archiver_cli_test/no_log.tar.gz | grep -qx './logs/app.log'; then echo 'ERROR: .log file was not excluded' >&2; exit 1; fi\n\necho '--- no cache archive ---'\ntar -tzf /tmp/archiver_cli_test/no_cache.tar.gz | sort\ntar -tzf /tmp/archiver_cli_test/no_cache.tar.gz | grep -qx './keep.txt'\nif tar -tzf /tmp/archiver_cli_test/no_cache.tar.gz | grep -qx './cache/item.dat'; then echo 'ERROR: cache file was not excluded' >&2; exit 1; fi\n\necho '--- list command ---'\npython3 archiver.py list /"]
[91.76827, "i", "tmp/archiver_cli_test/no_tmp.tar.gz | tee /tmp/archiver_cli_test/list.out\ngrep -q './keep.txt' /tmp/archiver_cli_test/list.out\nif grep -q './drop.tmp' /tmp/archiver_cli_test/list.out; then echo 'ERROR: list shows excluded tmp file' >&2; exit 1; fi\n\necho '--- extract command ---'\nmkdir -p /tmp/archiver_cli_test/extracted\npython3 archiver.py extract /tmp/archiver_cli_test/no_tmp.tar.gz /tmp/archiver_cli_test/extracted\ntest -f /tmp/archiver_cli_test/extracted/keep.txt\ntest ! -f /tmp/archiver_cli_test/extracted/drop.tmp\n\necho 'All archiver CLI tests passed.'\n"]
[91.768924, "o", "set -e\r\n\u001b[?2004l\rtmp/archiver_cli_test/no_tmp.tar.gz | tee /tmp/archiver_cli_test/list.out\r\ngrep -q './keep.txt' /tmp/archiver_cli_test/list.out\r\nif grep -q './drop.tmp' /tmp/archiver_cli_test/list.out; then echo 'ERROR: list shows excluded tmp file' >&2; exit 1; fi\r\n\r\necho '--- extract command ---'\r\nmkdir -p /tmp/archiver_cli_test/extracted\r\npython3 archiver.py extract /tmp/archiver_cli_test/no_tmp.tar.gz /tmp/archiver_cli_test/extracted\r\ntest -f /tmp/archiver_cli_test/extracted/keep.txt\r\ntest ! -f /tmp/archiver_cli_test/extracted/drop.tmp\r\n\r\necho 'All archiver CLI tests passed.'\r\n\u001b[?2004hroot@aa2554c624ed:/workspace# rm -rf /tmp/archiver_cli_test\r\n\u001b[?2004l\r"]
