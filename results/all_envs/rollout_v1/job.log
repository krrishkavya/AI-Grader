Sending keys: ['cat > /tmp/patch_db_dumper.py <<\'PY\'\nfrom pathlib import Path\npath = Path(\'db_dumper.py\')\ntext = path.read_text()\ntext = text.replace(\'def dump_database(db_path: str, output_path: str) -> None:\\n    """\\n    Dumps all SQL statements and table contents to output_path.\\n    """\\n    if not os.path.exists(db_path):\\n        raise FileNotFoundError(f"Database \\\'{db_path}\\\' not found.")\\n\\n    conn = sqlite3.connect(db_path)\\n    with open(output_path, "w") as f:\\n        for line in conn.iterdump():\\n            f.write(f"{line}\\\\n")\\n    conn.close()\\n\', \'def _quote_identifier(identifier: str) -> str:\\n    """Return identifier quoted for safe use in SQLite SQL."""\\n    return \\\'"\\\' + identifier.replace(\\\'"\\\', \\\'""\\\') + \\\'"\\\'\\n\\ndef _quote_value(conn: sqlite3.Connection, value) -> str:\\n    """Return value formatted as a SQLite SQL literal."""\\n    return conn.execute("SELECT quote(?)", (value,)).fetchone()[0]\\n\\ndef dump_database(db_path: str, output_path: str, table: str = None) -> None:\\n    """\\n    Dumps SQL statements and table contents to output_path.\\n\\n    If table is provided, only that table\\\'s schema and rows are dumped.\\n    Otherwise, the entire database is dumped.\\n    """\\n    if not os.path.exists(db_path):\\n        raise FileNotFoundError(f"Database \\\'{db_path}\\\' not found.")\\n\\n    conn = sqlite3.connect(db_path)\\n    try:\\n        with open(output_path, "w") as f:\\n            if table is None:\\n                for line in conn.iterdump():\\n                    f.write(f"{line}\\\\n")\\n                return\\n\\n            cur = conn.cursor()\\n            cur.execute(\\n                "SELECT sql FROM sqlite_master WHERE type=\\\'table\\\' AND name=? AND name NOT LIKE \\\'sqlite_%\\\'",\\n                (table,),\\n            )\\n            row = cur.fetchone()\\n            if row is None:\\n                raise ValueError(f"Table \\\'{table}\\\' not found in database.")\\n\\n            create_sql = row[0]\\n            f.write("BEGIN TRANSACTION;\\\\n")\\n            f.write(f"{create_sql};\\\\n")\\n\\n            quoted_table = _quote_identifier(table)\\n            cur.execute(f"SELECT * FROM {quoted_table}")\\n            for record in cur.fetchall():\\n                values = ",".join(_quote_value(conn, value) for value in record)\\n                f.write(f"INSERT INTO {quoted_table} VALUES({values});\\\\n")\\n\\n            f.write("COMMIT;\\\\n")\\n    finally:\\n        conn.close()\\n\')\ntext = text.replace(\'    dump_p.add_argument("output_path", help="Output SQL dump file")\\n\', \'    dump_p.add_argument("output_path", help="Output SQL dump file")\\n    dump_p.add_argument("--table", help="Dump only the specified table")\\n\')\ntext = text.replace(\'    if args.command == "dump":\\n        dump_database(args.db_path, args.output_path)\\n\', \'    if args.command == "dump":\\n        dump_database(args.db_path, args.output_path, table=args.table)\\n\')\npath.write_text(text)\nPY\npython3 /tmp/patch_db_dumper.py\nsed -n \'1,260p\' db_dumper.py\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
