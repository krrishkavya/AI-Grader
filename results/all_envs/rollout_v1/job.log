Sending keys: ['python3 - <<\'PY\'\nfrom pathlib import Path\npath = Path(\'db_dumper.py\')\ntext = path.read_text()\ntext = text.replace(\'def dump_database(db_path: str, output_path: str) -> None:\\n    """\\n    Dumps all SQL statements and table contents to output_path.\\n    """\\n    if not os.path.exists(db_path):\\n        raise FileNotFoundError(f"Database \\\'{db_path}\\\' not found.")\\n\\n    conn = sqlite3.connect(db_path)\\n    with open(output_path, "w") as f:\\n        for line in conn.iterdump():\\n            f.write(f"{line}\\\\n")\\n    conn.close()\\n\', \'\'\'def _quote_identifier(identifier: str) -> str:\\n    """Return identifier safely quoted for SQLite SQL statements."""\\n    return \'"\' + identifier.replace(\'"\', \'""\') + \'"\'\\n\\ndef _quote_literal(conn: sqlite3.Connection, value) -> str:\\n    """Return value as a SQLite SQL literal."""\\n    return conn.execute("SELECT quote(?)", (value,)).fetchone()[0]\\n\\ndef dump_database(db_path: str, output_path: str, table_name: str = None) -> None:\\n    """\\n    Dumps SQL statements and table contents to output_path.\\n\\n    If table_name is provided, only that table\'s schema and rows are dumped.\\n    Otherwise, the entire database is dumped.\\n    """\\n    if not os.path.exists(db_path):\\n        raise FileNotFoundError(f"Database \'{db_path}\' not found.")\\n\\n    conn = sqlite3.connect(db_path)\\n    try:\\n        with open(output_path, "w") as f:\\n            if table_name is None:\\n                for line in conn.iterdump():\\n                    f.write(f"{line}\\\\n")\\n                return\\n\\n            cur = conn.cursor()\\n            cur.execute(\\n                """\\n                SELECT sql\\n                FROM sqlite_master\\n                WHERE type = \'table\'\\n                  AND name = ?\\n                  AND name NOT LIKE \'sqlite_%\'\\n                """,\\n                (table_name,),\\n            )\\n            schema_row = cur.fetchone()\\n            if schema_row is None:\\n                raise ValueError(f"Table \'{table_name}\' not found in database \'{db_path}\'.")\\n\\n            quoted_table = _quote_identifier(table_name)\\n            f.write("BEGIN TRANSACTION;\\\\n")\\n            f.write(f"{schema_row[0]};\\\\n")\\n\\n            for row in conn.execute(f"SELECT * FROM {quoted_table}"):\\n                values = ",".join(_quote_literal(conn, value) for value in row)\\n                f.write(f"INSERT INTO {quoted_table} VALUES({values});\\\\n")\\n\\n            cur.execute(\\n                """\\n                SELECT sql\\n                FROM sqlite_master\\n                WHERE tbl_name = ?\\n                  AND type IN (\'index\', \'trigger\')\\n                  AND sql IS NOT NULL\\n                ORDER BY type, name\\n                """,\\n                (table_name,),\\n            )\\n            for (sql,) in cur.fetchall():\\n                f.write(f"{sql};\\\\n")\\n\\n            f.write("COMMIT;\\\\n")\\n    finally:\\n        conn.close()\\n\'\'\')\ntext = text.replace(\'    dump_p.add_argument("output_path", help="Output SQL dump file")\\n\', \'    dump_p.add_argument("output_path", help="Output SQL dump file")\\n    dump_p.add_argument("--table", help="Dump only the specified table")\\n\')\ntext = text.replace(\'    if args.command == "dump":\\n        dump_database(args.db_path, args.output_path)\\n\', \'    if args.command == "dump":\\n        dump_database(args.db_path, args.output_path, args.table)\\n\')\npath.write_text(text)\nPY\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
