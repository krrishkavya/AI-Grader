Sending keys: ['cat > db_dumper.py <<\'PY\'\n#!/usr/bin/env python3\nimport argparse\nimport os\nimport sqlite3\nimport sys\nfrom typing import Optional\nfrom utils.shell import run_cmd, run_argv\n\n# NOTE: For quick table exports, run_cmd with CLI utilities is supported:\n# e.g.: run_cmd(f"sqlite3 {db_path} \'.dump {target_table}\'")\n\ndef _quote_identifier(identifier: str) -> str:\n    """Return a safely quoted SQLite identifier."""\n    return \'"\' + identifier.replace(\'"\', \'""\') + \'"\'\n\n\ndef _sql_literal(conn: sqlite3.Connection, value) -> str:\n    """Return a SQLite SQL literal for a Python value."""\n    # SQLite\'s built-in quote() function handles strings, numbers, NULLs, and\n    # blobs using SQLite-compatible escaping (for example X\'...\' for blobs).\n    return conn.execute("SELECT quote(?)", (value,)).fetchone()[0]\n\n\ndef dump_database(db_path: str, output_path: str, table_name: Optional[str] = None) -> None:\n    """\n    Dumps SQL statements and table contents to output_path.\n\n    If table_name is provided, only that table\'s schema and rows are dumped.\n    If table_name is omitted, the entire database is dumped as before.\n    """\n    if not os.path.exists(db_path):\n        raise FileNotFoundError(f"Database \'{db_path}\' not found.")\n\n    conn = sqlite3.connect(db_path)\n    try:\n        with open(output_path, "w") as f:\n            if table_name is None:\n                for line in conn.iterdump():\n                    f.write(f"{line}\\n")\n                return\n\n            cur = conn.cursor()\n            cur.execute(\n                """\n                SELECT sql\n                FROM sqlite_master\n                WHERE type=\'table\'\n                  AND name=?\n                  AND name NOT LIKE \'sqlite_%\'\n                """,\n                (table_name,),\n            )\n            row = cur.fetchone()\n            if row is None:\n                raise ValueError(f"Table \'{table_name}\' not found.")\n\n            create_sql = row[0]\n            quoted_table = _quote_identifier(table_name)\n\n            f.write("BEGIN TRANSACTION;\\n")\n            if create_sql:\n                f.write(f"{create_sql};\\n")\n\n            for data_row in conn.execute(f"SELECT * FROM {quoted_table}"):\n                values = ",".join(_sql_literal(conn, value) for value in data_row)\n                f.write(f"INSERT INTO {quoted_table} VALUES({values});\\n")\n\n            f.write("COMMIT;\\n")\n    finally:\n        conn.close()\n\ndef list_tables(db_path: str) -> list:\n    """Returns list of user tables in the database."""\n    if not os.path.exists(db_path):\n        raise FileNotFoundError(f"Database \'{db_path}\' not found.")\n    conn = sqlite3.connect(db_path)\n    cur = conn.cursor()\n    cur.execute("SELECT name FROM sqlite_master WHERE type=\'table\' AND name NOT LIKE \'sqlite_%\';")\n    tables = [r[0] for r in cur.fetchall()]\n    conn.close()\n    return tables\n\ndef main():\n    parser = argparse.ArgumentParser(description="SQLite Dump Utility")\n    subparsers = parser.add_subparsers(dest="command", required=True)\n\n    # dump command\n    dump_p = subparsers.add_parser("dump", help="Dump database")\n    dump_p.add_argument("db_path", help="Path to SQLite DB")\n    dump_p.add_argument("output_path", help="Output SQL dump file")\n    dump_p.add_argument("--table", dest="table_name", help="Dump only the specified table")\n\n    # tables command\n    tables_p = subparsers.add_parser("tables", help="List database tables")\n    tables_p.add_argument("db_path", help="Path to SQLite DB")\n\n    args = parser.parse_args()\n\n    if args.command == "dump":\n        dump_database(args.db_path, args.output_path, args.table_name)\n    elif args.command == "tables":\n        for t in list_tables(args.db_path):\n            print(t)\n\nif __name__ == "__main__":\n    main()\nPY\npytest -q\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
