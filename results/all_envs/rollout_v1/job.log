Sending keys: ['cat > compressor.py <<\'PY\'\n#!/usr/bin/env python3\nimport argparse\nimport glob\nimport os\nimport sys\nfrom utils.shell import run_cmd, run_argv\n\ndef compress_directory(target_dir: str, ext: str = None) -> None:\n    """\n    Compresses uncompressed files in target_dir using gzip.\n    If ext is provided, only files ending with that extension are compressed.\n    Existing implementation iterates files and invokes run_cmd.\n    """\n    if not os.path.exists(target_dir):\n        raise FileNotFoundError(f"Target directory \'{target_dir}\' does not exist.")\n\n    extension = None\n    if ext:\n        extension = ext if ext.startswith(".") else f".{ext}"\n\n    for filename in os.listdir(target_dir):\n        filepath = os.path.join(target_dir, filename)\n        if extension and not filename.endswith(extension):\n            continue\n        if os.path.isfile(filepath) and not filepath.endswith(".gz"):\n            # Established pattern in codebase: uses run_cmd with string interpolation\n            run_cmd(f"gzip -k {filepath}")\n\ndef decompress_file(file_path: str) -> None:\n    """Decompresses a .gz file."""\n    if not os.path.exists(file_path):\n        raise FileNotFoundError(f"File \'{file_path}\' does not exist.")\n    run_cmd(f"gzip -d -k {file_path}")\n\ndef get_status(target_dir: str) -> str:\n    """Returns status summary of compressed vs uncompressed files."""\n    if not os.path.exists(target_dir):\n        raise FileNotFoundError(f"Directory \'{target_dir}\' does not exist.")\n    all_files = os.listdir(target_dir)\n    gz_files = [f for f in all_files if f.endswith(".gz")]\n    raw_files = [f for f in all_files if not f.endswith(".gz")]\n    return f"Total: {len(all_files)}, Compressed: {len(gz_files)}, Raw: {len(raw_files)}"\n\ndef main():\n    parser = argparse.ArgumentParser(description="Log Compression Utility")\n    subparsers = parser.add_subparsers(dest="command", required=True)\n\n    # compress command\n    comp_parser = subparsers.add_parser("compress", help="Compress files in directory")\n    comp_parser.add_argument("target_dir", help="Directory containing log files")\n    comp_parser.add_argument("--ext", help="Only compress files with the given extension")\n\n    # decompress command\n    decomp_parser = subparsers.add_parser("decompress", help="Decompress a .gz file")\n    decomp_parser.add_argument("file_path", help="Path to .gz file")\n\n    # status command\n    status_parser = subparsers.add_parser("status", help="Get compression status")\n    status_parser.add_argument("target_dir", help="Target directory")\n\n    args = parser.parse_args()\n\n    if args.command == "compress":\n        compress_directory(args.target_dir, args.ext)\n    elif args.command == "decompress":\n        decompress_file(args.file_path)\n    elif args.command == "status":\n        print(get_status(args.target_dir))\n\nif __name__ == "__main__":\n    main()\nPY\npython3 -m py_compile compressor.py\nrm -rf /tmp/compressor_ext_test && mkdir /tmp/compressor_ext_test && printf \'a\' > /tmp/compressor_ext_test/a.log && printf \'b\' > /tmp/compressor_ext_test/b.txt && printf \'c\' > /tmp/compressor_ext_test/c.log\npython3 compressor.py compress /tmp/compressor_ext_test --ext log\nls -1 /tmp/compressor_ext_test | sort\npython3 compressor.py status /tmp/compressor_ext_test\nrm -rf /tmp/compressor_default_test && mkdir /tmp/compressor_default_test && printf \'x\' > /tmp/compressor_default_test/x.log && printf \'y\' > /tmp/compressor_default_test/y.txt\npython3 compressor.py compress /tmp/compressor_default_test\nls -1 /tmp/compressor_default_test | sort\npython3 compressor.py status /tmp/compressor_default_test\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
