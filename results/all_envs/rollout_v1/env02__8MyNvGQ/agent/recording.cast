[57.209706, "o", "new_func = '''def compress_directory(target_dir: str, ext: str = None) -> None:\\n    \"\"\"\\n    Compresses uncompressed files in target_dir using gzip.\\n\\n    If ext is provided, only files ending with that extension are compressed.\\n    The extension may be supplied with or without a leading dot (e.g. \"log\"\\n    and \".log\" both match files ending in \".log\").\\n    \"\"\"\\n    if not os.path.exists(target_dir):\\n        raise FileNotFoundError(f\"Target directory '{target_dir}' does not exist.\")\\n\\n    extension = None\\n    if ext is not None:\\n        ext = ext.strip()\\n        if ext:\\n            extension = ext if ext.startswith(\".\") else f\".{ext}\"\\n\\n    for filename in os.listdir(target_dir):\\n        filepath = os.path.join(target_dir, filename)\\n        if not os.path.isfile(filepath) or filepath.endswith(\".gz\"):\\n            continue\\n        if extension is not None and not filename.endswith(extension):\\n            continue\\n        # Established pattern in codebase: uses run_cmd with string interpolation"]
[57.209866, "o", "\\n        run_cmd(f\"gzip -k {filepath}\")\\n\\n'''\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
