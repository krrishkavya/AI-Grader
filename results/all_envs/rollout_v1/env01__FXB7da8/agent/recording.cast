[26.974085, "o", "new = '''def create_archive(source_dir: str, output_path: str, exclude_pattern: str = None) -> None:\\n    \"\"\"\\n    Creates a compressed tar.gz archive from source_dir.\\n\\n    If exclude_pattern is provided, files matching that tar-style pattern\\n    are omitted from the archive.\\n    \"\"\"\\n    if not os.path.exists(source_dir):\\n        raise FileNotFoundError(f\"Source directory '{source_dir}' does not exist.\")\\n\\n    args = [\"tar\"]\\n    if exclude_pattern:\\n        # Archive entries are created relative to source_dir via `-C source .`,\\n        # which commonly gives them a leading `./`. Add both forms for\\n        # intuitive CLI patterns like `*.tmp`, `*.log`, and `cache/*`.\\n        args.append(f\"--exclude={exclude_pattern}\")\\n        if not exclude_pattern.startswith((\"./\", \"/\")):\\n            args.append(f\"--exclude=./{exclude_pattern}\")\\n\\n    args.extend([\"-czf\", output_path, \"-C\", source_dir, \".\"])\\n    run_argv(args)\\n'''\r\n\u001b[?2004l\r\u001b[?2004h> if old not in text:\r\n\u001b[?2004l\r\u001b[?2004h> "]
