[28.273468, "i", "tmpdir=$(mktemp -d); printf '# Demo\\nBody text\\n' > \"$tmpdir/input.md\"; python3 report_gen.py render \"$tmpdir/input.md\" \"$tmpdir/no_title.html\"; python3 report_gen.py render \"$tmpdir/input.md\" \"$tmpdir/with_title.html\" --title 'Quarterly Report'; python3 report_gen.py validate \"$tmpdir/input.md\"; echo '--- no title ---'; cat \"$tmpdir/no_title.html\"; echo; echo '--- with title ---'; cat \"$tmpdir/with_title.html\"; echo\n"]
