[5.806452, "o", "import os\r\nimport shutil\r\nimport tempfile\r\nimport subprocess\r\nimport sys\r\nimport pytest\r\nfrom transcoder import transcode_file, get_media_info, extract_thumbnail\r\n\r\n@pytest.fixture\r\ndef temp_media():\r\n    tmp_dir = tempfile.mkdtemp(prefix=\"test_transcode_\")\r\n    src = os.path.join(tmp_dir, \"input.raw\")\r\n    with open(src, \"w\") as f:\r\n        f.write(\"VIDEO_SAMPLE_DATA_FRAME_0_1_2\")\r\n    yield tmp_dir, src\r\n    shutil.rmtree(tmp_dir, ignore_errors=True)\r\n\r\ndef test_transcode_basic(temp_media):\r\n    tmp_dir, src = temp_media\r\n    out = os.path.join(tmp_dir, \"out.raw\")\r\n    transcode_file(src, out)\r\n    assert os.path.exists(out)\r\n    with open(out) as f:\r\n        data = f.read()\r\n    assert \"HEADER:TRANSCODED\" in data\r\n\r\ndef test_info(temp_media):\r\n    _, src = temp_media\r\n    info = get_media_info(src)\r\n    assert \"Bytes:\" in info\r\n"]
[5.807177, "o", "\r\ndef test_extract_thumbnail(temp_media):\r\n    tmp_dir, src = temp_media\r\n    thumb = os.path.join(tmp_dir, \"thumb.jpg\")\r\n    extract_thumbnail(src, thumb)\r\n    assert os.path.exists(thumb)\r\n\r\n# Failing test demonstrating desired --scale behavior for incident ticket:\r\ndef test_transcode_scale_failing(temp_media):\r\n    \"\"\"\r\n    Incident Hotfix Test:\r\n    Verifies that --scale width:height can be passed via CLI and recorded in output.\r\n    \"\"\"\r\n    tmp_dir, src = temp_media\r\n    out = os.path.join(tmp_dir, \"scaled.raw\")\r\n    \r\n    # Run CLI command with --scale\r\n    res = subprocess.run([\r\n        sys.executable, \"transcoder.py\", \"transcode\", src, out, \"--scale\", \"1280:720\"\r\n    ], capture_output=True, text=True)\r\n\r\n    assert res.returncode == 0, f\"CLI failed: {res.stderr}\"\r\n    assert os.path.exists(out), \"Scaled output was not created\"\r\n    with open(out) as f:\r\n        content = f.read()\r\n    assert \"SCALE:1280:720\" in content, \"Scale metadata not applied\"\r\n\u001b[?2004hroot@4bc98c009cb1:/workspace# "]
[12.678546, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('transcoder.py')\ns = p.read_text()\ns = s.replace('def transcode_file(input_file: str, output_file: str) -> None:\\n', 'def transcode_file(input_file: str, output_file: str, scale: str | None = None) -> None:\\n')\ns = s.replace('    with open(output_file, \"w\") as f_out:\\n        f_out.write(f\"HEADER:TRANSCODED\\\\n{content}\")\\n', '    with open(output_file, \"w\") as f_out:\\n        f_out.write(\"HEADER:TRANSCODED\\\\n\")\\n        if scale:\\n            f_out.write(f\"SCALE:{scale}\\\\n\")\\n        f_out.write(content)\\n')\ns = s.replace('    trans_p.add_argument(\"output_file\", help=\"Target media file\")\\n', '    trans_p.add_argument(\"output_file\", help=\"Target media file\")\\n    trans_p.add_argument(\"--scale\", help=\"Output resolution as width:height, e.g. 1280:720\")\\n')\ns = s.replace('        transcode_file(args.input_file, args.output_file)\\n', '        transcode_file(args.input_file, args.output_file, scale=args.scale)\\n')\np.write_text(s)\nPY\n"]
