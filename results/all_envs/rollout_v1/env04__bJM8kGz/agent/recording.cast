[45.303314, "i", "tmpdir=$(mktemp -d); echo 'VIDEO_SAMPLE_DATA' > \"$tmpdir/in.raw\"; python3 transcoder.py transcode \"$tmpdir/in.raw\" \"$tmpdir/out.raw\" --scale 640:480; cat \"$tmpdir/out.raw\"; python3 transcoder.py info \"$tmpdir/out.raw\"; python3 transcoder.py extract \"$tmpdir/out.raw\" \"$tmpdir/thumb.jpg\"; cat \"$tmpdir/thumb.jpg\"; rm -rf \"$tmpdir\"\n"]
