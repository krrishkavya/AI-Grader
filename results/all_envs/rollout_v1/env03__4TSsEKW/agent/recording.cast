[19.496797, "i", "tmpdir=$(mktemp -d); printf '# Demo\\nBody\\n' > \"$tmpdir/input.md\"; python3 report_gen.py render \"$tmpdir/input.md\" \"$tmpdir/no_title.html\"; python3 report_gen.py render \"$tmpdir/input.md\" \"$tmpdir/with_title.html\" --title 'Quarterly Report'; echo '--- no title ---'; cat \"$tmpdir/no_title.html\"; echo; echo '--- with title ---'; cat \"$tmpdir/with_title.html\"; echo; python3 report_gen.py validate \"$tmpdir/input.md\"; rm -rf \"$tmpdir\"\n"]
