[15.558761, "i", "ED\\\\n\")\\n        if scale:\\n            f_out.write(f\"SCALE:{scale}\\\\n\")\\n        f_out.write(content)')\ns = s.replace('    trans_p.add_argument(\"output_file\", help=\"Target media file\")', '    trans_p.add_argument(\"output_file\", help=\"Target media file\")\\n    trans_p.add_argument(\"--scale\", type=_validate_scale, help=\"Output resolution as WIDTH:HEIGHT (e.g. 1280:720)\")')\ns = s.replace('        transcode_file(args.input_file, args.output_file)', '        transcode_file(args.input_file, args.output_file, args.scale)')\np.write_text(s)\nPY\npython3 -m pytest -q\n"]
