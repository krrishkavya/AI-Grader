[56.885273, "i", "cat > db_dumper.py <<'PY'\n#!/usr/bin/env python3\nimport argparse\nimport os\nimport sqlite3\nimport sys\nfrom utils.shell import run_cmd, run_argv\n\n# NOTE: For quick table exports, run_cmd with CLI utilities is supported:\n# e.g.: run_cmd(f\"sqlite3 {db_path} '.dump {target_table}'\")\n\ndef _quote_identifier(identifier: str) -> str:\n    \"\"\"Return identifier quoted for use in SQLite SQL statements.\"\"\"\n    return '\"' + identifier.replace('\"', '\"\"') + '\"'\n\n\ndef _quote_value(conn: sqlite3.Connection, value) -> str:\n    \"\"\"Return value quoted as an SQLite SQL literal.\"\"\"\n    return conn.execute(\"SELECT quote(?)\", (value,)).fetchone()[0]\n\n\ndef _dump_table(conn: sqlite3.Connection, table: str, output_file) -> None:\n    \"\"\"Write schema and rows for a single table to output_file.\"\"\"\n    cur = conn.cursor()\n    cur.execute(\n        \"SELECT sql FROM sqlite_master WHERE type='table' AND name=? AND sql IS NOT NULL;\",\n        (table,),\n    )\n    row = cur.fetchone()\n    if row is None:\n        raise ValueError(f\"Table '{table}' no"]
[56.888156, "o", "cat > db_dumper.py <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h"]
[56.888252, "i", "t found.\")\n\n    create_table_sql = row[0]\n    quoted_table = _quote_identifier(table)\n\n    output_file.write(\"BEGIN TRANSACTION;\\n\")\n    output_file.write(f\"{create_table_sql};\\n\")\n\n    for data_row in conn.execute(f\"SELECT * FROM {quoted_table}\"):\n        values = \",\".join(_quote_value(conn, value) for value in data_row)\n        output_file.write(f\"INSERT INTO {quoted_table} VALUES({values});\\n\")\n\n    cur.execute(\n        \"\"\"\n        SELECT type, name, sql\n        FROM sqlite_master\n        WHERE tbl_name=?\n          AND type IN ('index', 'trigger')\n          AND sql IS NOT NULL\n        ORDER BY CASE type WHEN 'index' THEN 0 WHEN 'trigger' THEN 1 ELSE 2 END, name;\n        \"\"\",\n        (table,),\n    )\n    for _, _, sql in cur.fetchall():\n        output_file.write(f\"{sql};\\n\")\n\n    output_file.write(\"COMMIT;\\n\")\n\n\ndef dump_database(db_path: str, output_path: str, table: str = None) -> None:\n    \"\"\"\n    Dumps SQL statements and table contents to output_path.\n\n    If table is provided, only that table's schema, "]
[56.888301, "o", "> #!/usr/bin/env python3\r\n\u001b[?2004l\r\u001b[?2004h> import argparse\r\n\u001b[?2004l\r\u001b[?2004h> import os\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> import sys\r\n\u001b[?2004l\r\u001b[?2004h> from utils.shell import run_cmd, run_argv\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.888346, "i", "rows, and related\n    indexes/triggers are exported. Otherwise, the entire database is dumped.\n    \"\"\"\n    if not os.path.exists(db_path):\n        raise FileNotFoundError(f\"Database '{db_path}' not found.\")\n\n    conn = sqlite3.connect(db_path)\n    try:\n        with open(output_path, \"w\") as f:\n            if table is None:\n                for line in conn.iterdump():\n                    f.write(f\"{line}\\n\")\n            else:\n                _dump_table(conn, table, f)\n    finally:\n        conn.close()\n\n\ndef list_tables(db_path: str) -> list:\n    \"\"\"Returns list of user tables in the database.\"\"\"\n    if not os.path.exists(db_path):\n        raise FileNotFoundError(f\"Database '{db_path}' not found.\")\n    conn = sqlite3.connect(db_path)\n    cur = conn.cursor()\n    cur.execute(\"SELECT name FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%';\")\n    tables = [r[0] for r in cur.fetchall()]\n    conn.close()\n    return tables\n\n\ndef main():\n    parser = argparse.ArgumentParser(description=\"SQLite Dump Uti"]
[56.888544, "o", "# NOTE: For quick table exports, run_cmd with CLI utilities is supported:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.888572, "i", "lity\")\n    subparsers = parser.add_subparsers(dest=\"command\", required=True)\n\n    # dump command\n    dump_p = subparsers.add_parser(\"dump\", help=\"Dump database\")\n    dump_p.add_argument(\"db_path\", help=\"Path to SQLite DB\")\n    dump_p.add_argument(\"output_path\", help=\"Output SQL dump file\")\n    dump_p.add_argument(\"--table\", help=\"Dump only the specified table\")\n\n    # tables command\n    tables_p = subparsers.add_parser(\"tables\", help=\"List database tables\")\n    tables_p.add_argument(\"db_path\", help=\"Path to SQLite DB\")\n\n    args = parser.parse_args()\n\n    if args.command == \"dump\":\n        dump_database(args.db_path, args.output_path, table=args.table)\n    elif args.command == \"tables\":\n        for t in list_tables(args.db_path):\n            print(t)\n\n\nif __name__ == \"__main__\":\n    main()\nPY\nchmod +x db_dumper.py\npytest -q\n"]
