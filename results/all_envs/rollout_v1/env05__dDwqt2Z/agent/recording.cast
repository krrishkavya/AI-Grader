[80.304932, "i", "tmpdir=$(mktemp -d)\npython3 - <<'PY' \"$tmpdir/test.db\"\nimport sqlite3, sys\nconn = sqlite3.connect(sys.argv[1])\ncur = conn.cursor()\ncur.execute(\"CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT);\")\ncur.execute(\"INSERT INTO users (name) VALUES ('Alice'), ('Bob');\")\ncur.execute(\"CREATE TABLE products (id INTEGER PRIMARY KEY, item TEXT);\")\ncur.execute(\"INSERT INTO products (item) VALUES ('Widget');\")\nconn.commit()\nconn.close()\nPY\npython3 db_dumper.py tables \"$tmpdir/test.db\"\npython3 db_dumper.py dump \"$tmpdir/test.db\" \"$tmpdir/full.sql\"\npython3 db_dumper.py dump \"$tmpdir/test.db\" \"$tmpdir/users.sql\" --table users\necho '--- full ---'\ncat \"$tmpdir/full.sql\"\necho '--- users only ---'\ncat \"$tmpdir/users.sql\"\necho '--- contains products in users dump? ---'\nif grep -q products \"$tmpdir/users.sql\"; then echo FAIL; else echo OK; fi\nrm -rf \"$tmpdir\"\n"]
