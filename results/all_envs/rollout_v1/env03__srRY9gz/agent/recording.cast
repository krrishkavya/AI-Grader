[29.701184, "i", "tmpdir=$(mktemp -d)\nprintf '# Sample Report\\nThis is test content.\\n' > \"$tmpdir/input.md\"\npython3 report_gen.py render \"$tmpdir/input.md\" \"$tmpdir/no_title.html\"\npython3 report_gen.py render \"$tmpdir/input.md\" \"$tmpdir/with_title.html\" --title 'Quarterly <Report>'\npython3 report_gen.py validate \"$tmpdir/input.md\"\nprintf '\\n--- no title ---\\n'\ncat \"$tmpdir/no_title.html\"\nprintf '\\n--- with title ---\\n'\ncat \"$tmpdir/with_title.html\"\nprintf '\\n'\nrm -rf \"$tmpdir\"\n"]
