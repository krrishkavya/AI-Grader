[81.219521, "i", "tmp=$(mktemp -d); mkdir -p \"$tmp/src/cache\"; echo keep > \"$tmp/src/keep.txt\"; echo tmp > \"$tmp/src/drop.tmp\"; echo log > \"$tmp/src/app.log\"; echo cache > \"$tmp/src/cache/item.dat\"; python3 archiver.py create \"$tmp/src\" \"$tmp/all.tar.gz\"; echo '--- all'; tar -tzf \"$tmp/all.tar.gz\"; python3 archiver.py create \"$tmp/src\" \"$tmp/no-tmp.tar.gz\" --exclude '*.tmp'; echo '--- no tmp'; tar -tzf \"$tmp/no-tmp.tar.gz\"; python3 archiver.py create \"$tmp/src\" \"$tmp/no-cache.tar.gz\" --exclude 'cache/*'; echo '--- no cache files'; tar -tzf \"$tmp/no-cache.tar.gz\"; rm -rf \"$tmp\"\n"]
[81.222147, "o", "tmp=$(mktemp -d); mkdir -p \"$tmp/src/cache\"; echo keep > \"$tmp/src/keep.txt\"; echo tmp > \"$tmp/src/drop.tmp\"; echo log > \"$tmp/src/app.log\"; echo cache > \"$tmp/src/cache/item.dat\"; python3 archiver.py create \"$tmp/src\" \"$tmp/all.tar.gz\"; echo '--- all'; tar -tzf \"$tmp/all.tar.gz\"; python3 archiver.py create \"$tmp/src\" \"$tmp/no-tmp.tar.gz\" --exclude '*.tmp'; echo '--- no tmp'; tar -tzf \"$tmp/no-tmp.tar.gz\"; python3 archiver.py create \"$tmp/src\" \"$tmp/no-cache.tar.gz\" --exclude 'cache/*'; echo '--- no cache files'; tar -tzf \"$tmp/no-cache.tar.gz\"; rm -rf \"$tmp\"\r\n\u001b[?2004l\r"]
[81.289706, "o", "--- all\r\n"]
[81.294938, "o", "./\r\n./cache/\r\n./cache/item.dat\r\n./app.log\r\n./drop.tmp\r\n./keep.txt\r\n"]
[81.44859, "o", "--- no tmp\r\n"]
[81.454259, "o", "./\r\n./cache/\r\n./cache/item.dat\r\n./app.log\r\n./keep.txt\r\n"]
[81.520783, "o", "--- no cache files\r\n"]
[81.526333, "o", "./\r\n./cache/\r\n./app.log\r\n./drop.tmp\r\n./keep.txt\r\n"]
