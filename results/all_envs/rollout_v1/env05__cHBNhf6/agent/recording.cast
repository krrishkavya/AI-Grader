[54.62578, "o", "    finally:\r\n\u001b[?2004l\r\u001b[?2004h>         conn.close()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def list_tables(db_path: str) -> list:\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"Returns list of user tables in the database.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     if not os.path.exists(db_path):\r\n\u001b[?2004l\r\u001b[?2004h>         raise FileNotFoundError(f\"Database '{db_path}' not found.\")\r\n\u001b[?2004l\r\u001b[?2004h>     conn = sqlite3.connect(db_path)\r\n\u001b[?2004l\r\u001b[?2004h>     cur = conn.cursor()\r\n\u001b[?2004l\r\u001b[?2004h>     cur.execute(\"SELECT name FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%';\")\r\n\u001b[?2004l\r\u001b[?2004h>     tables = [r[0] for r in cur.fetchall()]\r\n\u001b[?2004l\r\u001b[?2004h>     conn.close()\r\n\u001b[?2004l\r\u001b[?2004h>     return tables\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def main():\r\n\u001b[?2004l\r\u001b[?2004h> "]
