[56.710442, "i", "tmpdir=$(mktemp -d)\npython - <<'PY' \"$tmpdir/test.db\"\nimport sqlite3, sys\nconn = sqlite3.connect(sys.argv[1])\ncur = conn.cursor()\ncur.execute(\"CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT);\")\ncur.execute(\"INSERT INTO users (name) VALUES ('Alice'), ('Bob');\")\ncur.execute(\"CREATE TABLE products (id INTEGER PRIMARY KEY, item TEXT);\")\ncur.execute(\"INSERT INTO products (item) VALUES ('Widget');\")\nconn.commit()\nconn.close()\nPY\npython db_dumper.py dump \"$tmpdir/test.db\" \"$tmpdir/users.sql\" --table users\ncat \"$tmpdir/users.sql\"\n! grep -q products \"$tmpdir/users.sql\"\npython db_dumper.py dump \"$tmpdir/test.db\" \"$tmpdir/full.sql\"\ngrep -q products \"$tmpdir/full.sql\"\nrm -rf \"$tmpdir\"\n"]
