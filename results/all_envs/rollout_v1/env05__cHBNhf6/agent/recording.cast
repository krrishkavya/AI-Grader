[34.965605, "i", " f:\n-        for line in conn.iterdump():\n-            f.write(f\"{line}\\n\")\n-    conn.close()\n+    try:\n+        with open(output_path, \"w\") as f:\n+            if table is None:\n+                for line in conn.iterdump():\n+                    f.write(f\"{line}\\n\")\n+                return\n+\n+            cur = conn.cursor()\n+            cur.execute(\n+                \"\"\"\n+                SELECT name, sql\n+                FROM sqlite_master\n+                WHERE type='table'\n+                  AND name NOT LIKE 'sqlite_%'\n+                  AND name=?\n+                \"\"\",\n+                (table,),\n+            )\n+            table_info = cur.fetchone()\n+            if table_info is None:\n+                raise ValueError(f\"Table '{table}' not found in database '{db_path}'.\")\n+\n+            table_name, create_sql = table_info\n+            quoted_table = _quote_identifier(table_name)\n+\n+            f.write(\"BEGIN TRANSACTION;\\n\")\n+            if create_sql:\n+                f.write(f\"{create_sql};\\n\")\n+\n+      "]
[34.965849, "o", "apply_patch <<'PATCH'\r\n\u001b[?2004l\r\u001b[?2004h> *** Begin Patch"]
[34.9659, "i", "      for row in conn.execute(f\"SELECT * FROM {quoted_table}\"):\n+                values = \",\".join(_quote_sql_value(conn, value) for value in row)\n+                f.write(f\"INSERT INTO {quoted_table} VALUES({values});\\n\")\n+\n+            cur.execute(\n+                \"\"\"\n+                SELECT sql\n+                FROM sqlite_master\n+                WHERE tbl_name=?\n+                  AND type IN ('index', 'trigger')\n+                  AND sql IS NOT NULL\n+                ORDER BY type, name\n+                \"\"\",\n+                (table_name,),\n+            )\n+            for (schema_sql,) in cur.fetchall():\n+                f.write(f\"{schema_sql};\\n\")\n+\n+            f.write(\"COMMIT;\\n\")\n+    finally:\n+        conn.close()\n@@\n     dump_p = subparsers.add_parser(\"dump\", help=\"Dump database\")\n     dump_p.add_argument(\"db_path\", help=\"Path to SQLite DB\")\n     dump_p.add_argument(\"output_path\", help=\"Output SQL dump file\")\n+    dump_p.add_argument(\"--table\", help=\"Dump only the specified table\")\n@@\n     if args."]
