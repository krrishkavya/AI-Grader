[54.610803, "i", "cat > db_dumper.py <<'PY'\n#!/usr/bin/env python3\nimport argparse\nimport os\nimport sqlite3\nimport sys\nfrom utils.shell import run_cmd, run_argv\n\n# NOTE: For quick table exports, run_cmd with CLI utilities is supported:\n# e.g.: run_cmd(f\"sqlite3 {db_path} '.dump {target_table}'\")\n\n\ndef _quote_identifier(identifier: str) -> str:\n    \"\"\"Return a safely quoted SQLite identifier.\"\"\"\n    return '\"' + identifier.replace('\"', '\"\"') + '\"'\n\n\ndef _quote_sql_value(conn: sqlite3.Connection, value) -> str:\n    \"\"\"Return SQLite's SQL literal representation for a Python value.\"\"\"\n    return conn.execute(\"SELECT quote(?)\", (value,)).fetchone()[0]\n\n\ndef dump_database(db_path: str, output_path: str, table: str = None, table_name: str = None) -> None:\n    \"\"\"\n    Dumps SQL statements and table contents to output_path.\n\n    If table is provided, only that table's schema and rows are dumped.\n    Otherwise, the entire database is dumped.\n    \"\"\"\n    if table is None and table_name is not None:\n        table = table_name\n\n    if not "]
[54.610888, "i", "os.path.exists(db_path):\n        raise FileNotFoundError(f\"Database '{db_path}' not found.\")\n\n    conn = sqlite3.connect(db_path)\n    try:\n        with open(output_path, \"w\") as f:\n            if table is None:\n                for line in conn.iterdump():\n                    f.write(f\"{line}\\n\")\n                return\n\n            cur = conn.cursor()\n            cur.execute(\n                \"\"\"\n                SELECT name, sql\n                FROM sqlite_master\n                WHERE type='table'\n                  AND name NOT LIKE 'sqlite_%'\n                  AND name=?\n                \"\"\",\n                (table,),\n            )\n            table_info = cur.fetchone()\n            if table_info is None:\n                raise ValueError(f\"Table '{table}' not found in database '{db_path}'.\")\n\n            selected_table, create_sql = table_info\n            quoted_table = _quote_identifier(selected_table)\n\n            f.write(\"BEGIN TRANSACTION;\\n\")\n            if create_sql:\n                f.write(f\"{create_sql"]
[54.610902, "i", "};\\n\")\n\n            for row in conn.execute(f\"SELECT * FROM {quoted_table}\"):\n                values = \",\".join(_quote_sql_value(conn, value) for value in row)\n                f.write(f\"INSERT INTO {quoted_table} VALUES({values});\\n\")\n\n            f.write(\"COMMIT;\\n\")\n    finally:\n        conn.close()\n\n\ndef list_tables(db_path: str) -> list:\n    \"\"\"Returns list of user tables in the database.\"\"\"\n    if not os.path.exists(db_path):\n        raise FileNotFoundError(f\"Database '{db_path}' not found.\")\n    conn = sqlite3.connect(db_path)\n    cur = conn.cursor()\n    cur.execute(\"SELECT name FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%';\")\n    tables = [r[0] for r in cur.fetchall()]\n    conn.close()\n    return tables\n\n\ndef main():\n    parser = argparse.ArgumentParser(description=\"SQLite Dump Utility\")\n    subparsers = parser.add_subparsers(dest=\"command\", required=True)\n\n    # dump command\n    dump_p = subparsers.add_parser(\"dump\", help=\"Dump database\")\n    dump_p.add_argument(\"db_path\", help=\"P"]
[54.610909, "i", "ath to SQLite DB\")\n    dump_p.add_argument(\"output_path\", help=\"Output SQL dump file\")\n    dump_p.add_argument(\"--table\", help=\"Dump only the specified table\")\n\n    # tables command\n    tables_p = subparsers.add_parser(\"tables\", help=\"List database tables\")\n    tables_p.add_argument(\"db_path\", help=\"Path to SQLite DB\")\n\n    args = parser.parse_args()\n\n    if args.command == \"dump\":\n        dump_database(args.db_path, args.output_path, table=args.table)\n    elif args.command == \"tables\":\n        for t in list_tables(args.db_path):\n            print(t)\n\n\nif __name__ == \"__main__\":\n    main()\nPY\nPYTHONPATH=. pytest -q\n"]
[54.611299, "o", "cat > db_dumper.py <<'PY'\r\n\u001b[?2004l\r"]
[54.61176, "o", "\u001b[?2004h> "]
[54.611873, "o", "#!/usr/bin/env python3\r\n"]
[54.612146, "o", "\u001b[?2004l\r"]
[54.612712, "o", "\u001b[?2004h> import argparse\r\n\u001b[?2004l\r\u001b[?2004h> import os\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> import sys\r\n\u001b[?2004l\r\u001b[?2004h"]
[54.613554, "o", "> from utils.shell import run_cmd, run_argv\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.615498, "o", "# NOTE: For quick table exports, run_cmd with CLI utilities is supported:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.616016, "o", "# e.g.: run_cmd(f\"sqlite3 {db_path} '.dump {target_table}'\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.616303, "o", "def _quote_identifier(identifier: str) -> str:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.616802, "o", "    \"\"\"Return a safely quoted SQLite identifier.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.6171, "o", "    return '\"' + identifier.replace('\"', '\"\"') + '\"'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.617631, "o", "def _quote_sql_value(conn: sqlite3.Connection, value) -> str:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.618263, "o", "    \"\"\"Return SQLite's SQL literal representation for a Python value.\"\"\"\r\n\u001b[?2004l\r"]
[54.618443, "o", "\u001b[?2004h> "]
[54.618608, "o", "    return conn.execute(\"SELECT quote(?)\", (value,)).fetchone()[0]\r\n\u001b[?2004l\r"]
[54.619214, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.61985, "o", "def dump_database(db_path: str, output_path: str, table: str = None, table_name: str = None) -> None:\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     Dumps SQL statements and table contents to output_path.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     If table is provided, only that table's schema and rows are dumped.\r\n\u001b[?2004l\r\u001b[?2004h>     Otherwise, the entire database is dumped.\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.620493, "o", "    if table is None and table_name is not None:\r\n\u001b[?2004l\r\u001b[?2004h>         table = table_name\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     if not os.path.exists(db_path):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.620965, "o", "        raise FileNotFoundError(f\"Database '{db_path}' not found.\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     conn = sqlite3.connect(db_path)\r\n\u001b[?2004l\r\u001b[?2004h>     try:\r\n\u001b[?2004l\r\u001b[?2004h>         with open(output_path, \"w\") as f:\r\n\u001b[?2004l\r\u001b[?2004h>             if table is None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.621013, "o", "                for line in conn.iterdump():\r\n\u001b[?2004l\r\u001b[?2004h>                     f.write(f\"{line}\\n\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.621117, "o", "                return\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.621323, "o", "            cur = conn.cursor()\r\n\u001b[?2004l\r\u001b[?2004h>             cur.execute(\r\n\u001b[?2004l\r\u001b[?2004h>                 \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.622058, "o", "                SELECT name, sql\r\n\u001b[?2004l\r\u001b[?2004h>                 FROM sqlite_master\r\n\u001b[?2004l\r\u001b[?2004h>                 WHERE type='table'\r\n\u001b[?2004l\r\u001b[?2004h>                   AND name NOT LIKE 'sqlite_%'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.622323, "o", "                  AND name=?\r\n\u001b[?2004l\r\u001b[?2004h>                 \"\"\",\r\n\u001b[?2004l\r\u001b[?2004h>                 (table,),\r\n\u001b[?2004l\r\u001b[?2004h>             )\r\n\u001b[?2004l\r\u001b[?2004h>             table_info = cur.fetchone()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.622439, "o", "            if table_info is None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.622592, "o", "                raise ValueError(f\"Table '{table}' not found in database '{db_path}'.\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>             selected_table, create_sql = table_info\r\n\u001b[?2004l\r\u001b[?2004h> "]
