[126.575922, "i", "tmp=$(mktemp -d)\nmkdir -p \"$tmp/src/cache\" \"$tmp/src/docs\"\nprintf 'keep' > \"$tmp/src/keep.txt\"\nprintf 'tmp' > \"$tmp/src/drop.tmp\"\nprintf 'log' > \"$tmp/src/app.log\"\nprintf 'cache' > \"$tmp/src/cache/data.bin\"\nprintf 'doc' > \"$tmp/src/docs/readme.md\"\npython3 archiver.py create \"$tmp/src\" \"$tmp/all.tar.gz\"\npython3 archiver.py create \"$tmp/src\" \"$tmp/no_tmp.tar.gz\" --exclude '*.tmp'\npython3 archiver.py create \"$tmp/src\" \"$tmp/no_cache.tar.gz\" --exclude 'cache/*'\necho '--- all ---'\ntar -tzf \"$tmp/all.tar.gz\" | sort\necho '--- no tmp ---'\ntar -tzf \"$tmp/no_tmp.tar.gz\" | sort\necho '--- no cache ---'\ntar -tzf \"$tmp/no_cache.tar.gz\" | sort\nmkdir \"$tmp/extract\"\npython3 archiver.py extract \"$tmp/no_tmp.tar.gz\" \"$tmp/extract\"\ntest -f \"$tmp/extract/keep.txt\"\ntest ! -f \"$tmp/extract/drop.tmp\"\nrm -rf \"$tmp\"\n"]
