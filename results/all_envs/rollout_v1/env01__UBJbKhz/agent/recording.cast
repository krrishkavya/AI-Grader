[107.712328, "i", "cat > archiver.py <<'PY'\n#!/usr/bin/env python3\nimport argparse\nimport fnmatch\nimport os\nimport sys\nimport tarfile\nfrom utils.shell import run_cmd, run_argv\n\n\ndef _matches_exclude(path: str, pattern: str) -> bool:\n    \"\"\"Return True if an archive-relative path matches an exclude pattern.\"\"\"\n    if not pattern:\n        return False\n\n    normalized_path = path.replace(os.sep, \"/\")\n    normalized_pattern = pattern.replace(os.sep, \"/\")\n\n    # Entries created with arcname=\".\" are named like \"./file.txt\".\n    # Users generally provide patterns without that leading \"./\", so check\n    # both forms to make patterns such as \"*.tmp\" and \"cache/*\" intuitive.\n    without_dot_prefix = (\n        normalized_path[2:]\n        if normalized_path.startswith(\"./\")\n        else normalized_path\n    )\n    candidates = {\n        normalized_path,\n        without_dot_prefix,\n        f\"./{without_dot_prefix}\",\n    }\n\n    return any(fnmatch.fnmatchcase(candidate, normalized_pattern) for candidate in candidates)\n\n\ndef create_archive(\n    "]
[107.712628, "i", "source_dir: str,\n    output_path: str,\n    exclude: str = None,\n    exclude_pattern: str = None,\n) -> None:\n    \"\"\"\n    Creates a compressed tar.gz archive from source_dir.\n\n    When exclude is provided, archive-relative paths matching the glob-style\n    pattern (for example, \"*.tmp\", \"*.log\", or \"cache/*\") are omitted.\n    The exclude_pattern alias is accepted for callers that use a more explicit\n    keyword name.\n    \"\"\"\n    if not os.path.exists(source_dir):\n        raise FileNotFoundError(f\"Source directory '{source_dir}' does not exist.\")\n\n    if exclude is None:\n        exclude = exclude_pattern\n\n    def exclude_filter(tarinfo: tarfile.TarInfo):\n        if _matches_exclude(tarinfo.name, exclude):\n            return None\n        return tarinfo\n\n    with tarfile.open(output_path, \"w:gz\") as archive:\n        archive.add(source_dir, arcname=\".\", filter=exclude_filter)\n\n\ndef list_archive(archive_path: str) -> str:\n    \"\"\"Lists files in the archive.\"\"\"\n    if not os.path.exists(archive_path):\n        raise Fi"]
[107.712714, "o", "cat > archiver.py <<'PY'\r\n\u001b[?2004l\r"]
[107.71273, "i", "leNotFoundError(f\"Archive '{archive_path}' does not exist.\")\n    result = run_cmd(f\"tar -ztvf {archive_path}\")\n    return result.stdout\n\n\ndef extract_archive(archive_path: str, target_dir: str) -> None:\n    \"\"\"Extracts files from archive into target_dir.\"\"\"\n    if not os.path.exists(archive_path):\n        raise FileNotFoundError(f\"Archive '{archive_path}' does not exist.\")\n    os.makedirs(target_dir, exist_ok=True)\n    run_cmd(f\"tar -xzf {archive_path} -C {target_dir}\")\n\n\ndef main():\n    parser = argparse.ArgumentParser(description=\"System Archival Utility\")\n    subparsers = parser.add_subparsers(dest=\"command\", required=True)\n\n    # create command\n    create_parser = subparsers.add_parser(\"create\", help=\"Create a tar.gz archive\")\n    create_parser.add_argument(\"source_dir\", help=\"Directory to archive\")\n    create_parser.add_argument(\"output_path\", help=\"Target archive path\")\n    create_parser.add_argument(\n        \"--exclude\",\n        help=\"Glob-style pattern to omit from the archive (e.g. '*.tmp' or 'cache/"]
[107.713644, "o", "\u001b[?2004h> #!/usr/bin/env python3\r\n\u001b[?2004l\r\u001b[?2004h> import argparse\r\n\u001b[?2004l\r\u001b[?2004h> import fnmatch\r\n\u001b[?2004l\r\u001b[?2004h> import os\r\n\u001b[?2004l\r\u001b[?2004h> import sys\r\n\u001b[?2004l\r\u001b[?2004h> import tarfile\r\n\u001b[?2004l\r\u001b[?2004h> from utils.shell import run_cmd, run_argv\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.713735, "i", "*')\",\n    )\n\n    # list command\n    list_parser = subparsers.add_parser(\"list\", help=\"List archive contents\")\n    list_parser.add_argument(\"archive_path\", help=\"Path to archive\")\n\n    # extract command\n    extract_parser = subparsers.add_parser(\"extract\", help=\"Extract archive\")\n    extract_parser.add_argument(\"archive_path\", help=\"Path to archive\")\n    extract_parser.add_argument(\"target_dir\", help=\"Directory to extract to\")\n\n    args = parser.parse_args()\n\n    if args.command == \"create\":\n        create_archive(args.source_dir, args.output_path, exclude=args.exclude)\n    elif args.command == \"list\":\n        print(list_archive(args.archive_path))\n    elif args.command == \"extract\":\n        extract_archive(args.archive_path, args.target_dir)\n\n\nif __name__ == \"__main__\":\n    main()\nPY\npython3 -m py_compile archiver.py\nPYTHONPATH=/workspace pytest -q\n"]
[107.718694, "o", "def _matches_exclude(path: str, pattern: str) -> bool:\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"Return True if an archive-relative path matches an exclude pattern.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     if not pattern:\r\n\u001b[?2004l\r\u001b[?2004h>         return False\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     normalized_path = path.replace(os.sep, \"/\")\r\n\u001b[?2004l\r\u001b[?2004h>     normalized_pattern = pattern.replace(os.sep, \"/\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     # Entries created with arcname=\".\" are named like \"./file.txt\".\r\n\u001b[?2004l\r\u001b[?2004h>     # Users generally provide patterns without that leading \"./\", so check\r\n\u001b[?2004l\r\u001b[?2004h>     # both forms to make patterns such as \"*.tmp\" and \"cache/*\" intuitive.\r\n\u001b[?2004l\r\u001b[?2004h>     without_dot_prefix = (\r\n\u001b[?2004l\r\u001b[?2004h>         normalized_path[2:]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.719409, "o", "        if normalized_path.startswith(\"./\")\r\n\u001b[?2004l\r\u001b[?2004h>         else normalized_path\r\n\u001b[?2004l\r\u001b[?2004h>     )\r\n\u001b[?2004l\r\u001b[?2004h>     candidates = {\r\n\u001b[?2004l\r\u001b[?2004h>         normalized_path,\r\n\u001b[?2004l\r\u001b[?2004h>         without_dot_prefix,\r\n\u001b[?2004l\r\u001b[?2004h>         f\"./{without_dot_prefix}\",\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[107.719675, "o", "> "]
[107.719895, "o", "    return any(fnmatch.fnmatchcase(candidate, normalized_pattern) for candidate in candidates)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.720109, "o", "def create_archive(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.72041, "o", "    source_dir: str,\r\n\u001b[?2004l\r\u001b[?2004h>     output_path: str,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.720592, "o", "    exclude: str = None,\r\n\u001b[?2004l\r\u001b[?2004h>     exclude_pattern: str = None,\r\n\u001b[?2004l\r\u001b[?2004h> ) -> None:\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.720762, "o", "    Creates a compressed tar.gz archive from source_dir.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.720994, "o", "    When exclude is provided, archive-relative paths matching the glob-style\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.721053, "o", "    pattern (for example, \"*.tmp\", \"*.log\", or \"cache/*\") are omitted.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.721291, "o", "    The exclude_pattern alias is accepted for callers that use a more explicit\r\n\u001b[?2004l\r\u001b[?2004h"]
[107.721656, "o", ">     keyword name.\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.7219, "o", "    if not os.path.exists(source_dir):\r\n\u001b[?2004l\r\u001b[?2004h>         raise FileNotFoundError(f\"Source directory '{source_dir}' does not exist.\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[107.722093, "o", ">     if exclude is None:\r\n\u001b[?2004l\r\u001b[?2004h>         exclude = exclude_pattern\r\n\u001b[?2004l\r"]
[107.722168, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.722378, "o", "    def exclude_filter(tarinfo: tarfile.TarInfo):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.722473, "o", "        if _matches_exclude(tarinfo.name, exclude):\r\n\u001b[?2004l\r\u001b[?2004h>             return None\r\n\u001b[?2004l\r"]
[107.722759, "o", "\u001b[?2004h"]
[107.722907, "o", ">         return tarinfo\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     with tarfile.open(output_path, \"w:gz\") as archive:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.723151, "o", "        archive.add(source_dir, arcname=\".\", filter=exclude_filter)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.723278, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> def list_archive(archive_path: str) -> str:\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"Lists files in the archive.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.723345, "o", "    if not os.path.exists(archive_path):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.723513, "o", "        raise FileNotFoundError(f\"Archive '{archive_path}' does not exist.\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.723734, "o", "    result = run_cmd(f\"tar -ztvf {archive_path}\")\r\n\u001b[?2004l\r\u001b[?2004h>     return result.stdout\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[107.723798, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.723993, "o", "def extract_archive(archive_path: str, target_dir: str) -> None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.724195, "o", "    \"\"\"Extracts files from archive into target_dir.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.724233, "o", "    if not os.path.exists(archive_path):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.72431, "o", "        raise FileNotFoundError(f\"Archive '{archive_path}' does not exist.\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.72434, "o", "    os.makedirs(target_dir, exist_ok=True)\r\n\u001b[?2004l\r"]
[107.724466, "o", "\u001b[?2004h> "]
[107.724538, "o", "    run_cmd(f\"tar -xzf {archive_path} -C {target_dir}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.724655, "o", "def main():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.724787, "o", "    parser = argparse.ArgumentParser(description=\"System Archival Utility\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.724952, "o", "    subparsers = parser.add_subparsers(dest=\"command\", required=True)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     # create command\r\n\u001b[?2004l\r\u001b[?2004h"]
[107.72499, "o", "> "]
[107.725205, "o", "    create_parser = subparsers.add_parser(\"create\", help=\"Create a tar.gz archive\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.725393, "o", "    create_parser.add_argument(\"source_dir\", help=\"Directory to archive\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.725571, "o", "    create_parser.add_argument(\"output_path\", help=\"Target archive path\")\r\n\u001b[?2004l\r\u001b[?2004h>     create_parser.add_argument(\r\n\u001b[?2004l\r"]
[107.725768, "o", "\u001b[?2004h>         \"--exclude\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.72614, "o", "        help=\"Glob-style pattern to omit from the archive (e.g. '*.tmp' or 'cache/*')\",\r\n\u001b[?2004l\r\u001b[?2004h>     )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.726177, "o", "    # list command\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.726367, "o", "    list_parser = subparsers.add_parser(\"list\", help=\"List archive contents\")\r\n\u001b[?2004l\r\u001b[?2004h>     list_parser.add_argument(\"archive_path\", help=\"Path to archive\")\r\n\u001b[?2004l\r"]
[107.726605, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.726825, "o", "    # extract command\r\n\u001b[?2004l\r\u001b[?2004h>     extract_parser = subparsers.add_parser(\"extract\", help=\"Extract archive\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.72704, "o", "    extract_parser.add_argument(\"archive_path\", help=\"Path to archive\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.727255, "o", "    extract_parser.add_argument(\"target_dir\", help=\"Directory to extract to\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     args = parser.parse_args()\r\n\u001b[?2004l\r"]
[107.727463, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     if args.command == \"create\":\r\n\u001b[?2004l\r\u001b[?2004h>         create_archive(args.source_dir, args.output_path, exclude=args.exclude)\r\n\u001b[?2004l\r"]
[107.727623, "o", "\u001b[?2004h> "]
[107.727742, "o", "    elif args.command == \"list\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.727829, "o", "        print(list_archive(args.archive_path))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.728055, "o", "    elif args.command == \"extract\":\r\n\u001b[?2004l\r\u001b[?2004h>         extract_archive(args.archive_path, args.target_dir)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[107.728248, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.728504, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r\u001b[?2004h>     main()\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[107.73068, "o", "\u001b[?2004hroot@2aa312b28f7f:/workspace# "]
