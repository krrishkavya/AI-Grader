[95.040886, "i", "python - <<'PY'\nimport os\nimport sqlite3\nimport subprocess\nimport tempfile\n\nwith tempfile.TemporaryDirectory() as d:\n    db = os.path.join(d, 'test.db')\n    out = os.path.join(d, 'users.sql')\n    restored = os.path.join(d, 'restored.db')\n\n    conn = sqlite3.connect(db)\n    cur = conn.cursor()\n    cur.execute('CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT);')\n    cur.execute(\"INSERT INTO users (name) VALUES ('Alice'), ('Bob');\")\n    cur.execute('CREATE TABLE products (id INTEGER PRIMARY KEY, item TEXT);')\n    cur.execute(\"INSERT INTO products (item) VALUES ('Widget');\")\n    conn.commit()\n    conn.close()\n\n    subprocess.run(['python', 'db_dumper.py', 'dump', db, out, '--table', 'users'], check=True)\n    content = open(out).read()\n    print(content)\n    assert 'CREATE TABLE users' in content\n    assert 'Alice' in content and 'Bob' in content\n    assert 'products' not in content and 'Widget' not in content\n\n    restore_conn = sqlite3.connect(restored)\n    restore_conn.executescript(content)\n    tables = "]
[95.040974, "i", "[r[0] for r in restore_conn.execute(\"SELECT name FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%'\")]\n    rows = list(restore_conn.execute('SELECT id, name FROM users ORDER BY id'))\n    restore_conn.close()\n    assert tables == ['users'], tables\n    assert rows == [(1, 'Alice'), (2, 'Bob')], rows\n    print('table-filter smoke test passed')\nPY\n"]
