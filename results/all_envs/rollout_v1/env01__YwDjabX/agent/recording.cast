[66.029577, "o", "def create_archive(source_dir: str, output_path: str, exclude: Optional[str] = None) -> None:\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     Creates a compressed tar.gz archive from source_dir.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     If exclude is provided, files matching that pattern (for example,\r\n\u001b[?2004l\r\u001b[?2004h>     \"*.tmp\", \"*.log\", or \"cache/*\") are omitted from the archive.\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     if not os.path.exists(source_dir):\r\n\u001b[?2004l\r\u001b[?2004h>         raise FileNotFoundError(f\"Source directory '{source_dir}' does not exist.\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     source_dir = os.path.abspath(source_dir)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     def should_exclude(tarinfo: tarfile.TarInfo) -> bool:\r\n\u001b[?2004l\r\u001b[?2004h>         if not exclude:\r\n\u001b[?2004l\r\u001b[?2004h>             return False\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>         # Entries are archived under \".\".  Match both that archive name and a\r\n\u001b[?2004l\r\u001b[?2004h>         # normalized rel"]
[66.0301, "o", "ative name so user-facing patterns like \"cache/*\" work.\r\n\u001b[?2004l\r\u001b[?2004h>         archive_name = tarinfo.name\r\n\u001b[?2004l\r\u001b[?2004h>         relative_name = archive_name[2:] if archive_name.startswith(\"./\") else archive_name\r\n\u001b[?2004l\r\u001b[?2004h>         if relative_name == \".\":\r\n\u001b[?2004l\r\u001b[?2004h>             relative_name = \"\""]
[66.030552, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>         names_to_match = [archive_name, relative_name, os.path.basename(relative_name)]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[66.030622, "o", "        if any(fnmatch.fnmatch(name, exclude) for name in names_to_match if name):\r\n\u001b[?2004l\r\u001b[?2004h>             return True\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[66.030909, "o", "        # A pattern such as \"cache/*\" excludes everything below cache/.  Also\r\n\u001b[?2004l\r\u001b[?2004h> "]
[66.031055, "o", "        # omit the directory entry itself so the archive does not contain an\r\n\u001b[?2004l\r\u001b[?2004h"]
[66.031605, "o", ">         # empty cache directory.\r\n\u001b[?2004l\r\u001b[?2004h>         if exclude.endswith(\"/*\"):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[66.031747, "o", "            excluded_dir = exclude[:-2].rstrip(\"/\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[66.031833, "o", "            if excluded_dir and relative_name == excluded_dir:\r\n\u001b[?2004l\r"]
[66.032149, "o", "\u001b[?2004h>                 return True\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>         return False\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[66.032327, "o", "\u001b[?2004h> "]
[66.032578, "o", "    with tarfile.open(output_path, \"w:gz\") as archive:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[66.032661, "o", "        archive.add(source_dir, arcname=\".\", filter=lambda info: None if should_exclude(info) else info)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[66.032853, "o", "\u001b[?2004h> "]
