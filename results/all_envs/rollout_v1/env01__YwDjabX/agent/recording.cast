[66.025307, "i", "cat > archiver.py <<'PY'\n#!/usr/bin/env python3\nimport argparse\nimport fnmatch\nimport os\nimport sys\nimport tarfile\nfrom typing import Optional\nfrom utils.shell import run_cmd, run_argv\n\n\ndef create_archive(source_dir: str, output_path: str, exclude: Optional[str] = None) -> None:\n    \"\"\"\n    Creates a compressed tar.gz archive from source_dir.\n\n    If exclude is provided, files matching that pattern (for example,\n    \"*.tmp\", \"*.log\", or \"cache/*\") are omitted from the archive.\n    \"\"\"\n    if not os.path.exists(source_dir):\n        raise FileNotFoundError(f\"Source directory '{source_dir}' does not exist.\")\n\n    source_dir = os.path.abspath(source_dir)\n\n    def should_exclude(tarinfo: tarfile.TarInfo) -> bool:\n        if not exclude:\n            return False\n\n        # Entries are archived under \".\".  Match both that archive name and a\n        # normalized relative name so user-facing patterns like \"cache/*\" work.\n        archive_name = tarinfo.name\n        relative_name = archive_name[2:] if archive_name.star"]
[66.025884, "i", "tswith(\"./\") else archive_name\n        if relative_name == \".\":\n            relative_name = \"\"\n\n        names_to_match = [archive_name, relative_name, os.path.basename(relative_name)]\n        if any(fnmatch.fnmatch(name, exclude) for name in names_to_match if name):\n            return True\n\n        # A pattern such as \"cache/*\" excludes everything below cache/.  Also\n        # omit the directory entry itself so the archive does not contain an\n        # empty cache directory.\n        if exclude.endswith(\"/*\"):\n            excluded_dir = exclude[:-2].rstrip(\"/\")\n            if excluded_dir and relative_name == excluded_dir:\n                return True\n\n        return False\n\n    with tarfile.open(output_path, \"w:gz\") as archive:\n        archive.add(source_dir, arcname=\".\", filter=lambda info: None if should_exclude(info) else info)\n\n\ndef list_archive(archive_path: str) -> str:\n    \"\"\"Lists files in the archive.\"\"\"\n    if not os.path.exists(archive_path):\n        raise FileNotFoundError(f\"Archive '{archive_path}'"]
