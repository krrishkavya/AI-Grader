[35.65275, "o", "\u001b[?2004hroot@a59c1c4c332e:/workspace# "]
[35.653085, "o", "test -f \"$tmp/server.log\" && echo decompress-ok\r\n\u001b[?2004l\r"]
[35.653399, "o", "decompress-ok\r\n\u001b[?2004hroot@a59c1c4c332e:/workspace# rm -rf \"$tmp\"\r\n\u001b[?2004l\r"]
