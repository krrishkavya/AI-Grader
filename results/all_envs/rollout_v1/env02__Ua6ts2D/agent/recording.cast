[11.772416, "o", "#!/usr/bin/env python3\r\nimport argparse\r\nimport glob\r\nimport os\r\nimport sys\r\nfrom utils.shell import run_cmd, run_argv\r\n\r\ndef compress_directory(target_dir: str, ext: str | None = None) -> None:\r\n    \"\"\"\r\n    Compresses uncompressed files in target_dir using gzip.\r\n    If ext is provided, only files ending with that extension are compressed.\r\n    \"\"\"\r\n    if not os.path.exists(target_dir):\r\n        raise FileNotFoundError(f\"Target directory '{target_dir}' does not exist.\")\r\n    \r\n    normalized_ext = None\r\n    if ext:\r\n        normalized_ext = ext if ext.startswith(\".\") else f\".{ext}\"\r\n\r\n    for filename in os.listdir(target_dir):\r\n        filepath = os.path.join(target_dir, filename)\r\n        if not os.path.isfile(filepath) or filepath.endswith(\".gz\"):\r\n            continue\r\n        if normalized_ext and not filename.endswith(normalized_ext):\r\n            continue\r\n        # Established pattern in codebase: uses run_cmd with string interpolation\r\n        run_cmd(f\"gzip -k {filepath}\")\r\n\r\ndef decompress_file("]
