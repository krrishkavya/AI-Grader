[80.587867, "i", "rm -f /tmp/db_dumper_smoke.db /tmp/db_dumper_full.sql /tmp/db_dumper_users.sql\npython - <<'PY'\nimport sqlite3\nconn = sqlite3.connect('/tmp/db_dumper_smoke.db')\ncur = conn.cursor()\ncur.execute('CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT);')\ncur.execute(\"INSERT INTO users (name) VALUES ('Alice'), ('Bob');\")\ncur.execute('CREATE TABLE products (id INTEGER PRIMARY KEY, item TEXT);')\ncur.execute(\"INSERT INTO products (item) VALUES ('Widget');\")\nconn.commit()\nconn.close()\nPY\npython db_dumper.py tables /tmp/db_dumper_smoke.db\npython db_dumper.py dump /tmp/db_dumper_smoke.db /tmp/db_dumper_full.sql\npython db_dumper.py dump /tmp/db_dumper_smoke.db /tmp/db_dumper_users.sql --table users\ncat /tmp/db_dumper_users.sql\npython - <<'PY'\nfrom pathlib import Path\nfull = Path('/tmp/db_dumper_full.sql').read_text()\nusers = Path('/tmp/db_dumper_users.sql').read_text()\nassert 'users' in full and 'products' in full\nassert 'CREATE TABLE users' in users\nassert 'Alice' in users and 'Bob' in users\nassert 'products' not in use"]
[80.588443, "i", "rs\nassert 'Widget' not in users\nprint('smoke tests passed')\nPY\npython -m pytest -q\n"]
