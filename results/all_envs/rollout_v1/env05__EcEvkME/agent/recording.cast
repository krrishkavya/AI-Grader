[80.997283, "o", "users = Path('/tmp/db_dumper_users.sql').read_text()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.997535, "o", "assert 'users' in full and 'products' in full\r\n\u001b[?2004l\r\u001b[?2004h> "]
