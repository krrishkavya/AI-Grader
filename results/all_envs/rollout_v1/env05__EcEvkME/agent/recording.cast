[54.691457, "i", "cat > db_dumper.py <<'PY'\n#!/usr/bin/env python3\nimport argparse\nimport os\nimport sqlite3\nimport sys\nfrom utils.shell import run_cmd, run_argv\n\n# NOTE: For quick table exports, run_cmd with CLI utilities is supported:\n# e.g.: run_cmd(f\"sqlite3 {db_path} '.dump {target_table}'\")\n\ndef _quote_identifier(identifier: str) -> str:\n    \"\"\"Return a safely quoted SQLite identifier.\"\"\"\n    return '\"' + identifier.replace('\"', '\"\"') + '\"'\n\n\ndef _quote_sql_value(conn: sqlite3.Connection, value) -> str:\n    \"\"\"Return value formatted as a SQL literal using SQLite's quote() function.\"\"\"\n    return conn.execute(\"SELECT quote(?)\", (value,)).fetchone()[0]\n\n\ndef dump_database(db_path: str, output_path: str, table_name: str = None) -> None:\n    \"\"\"\n    Dumps SQL statements and table contents to output_path.\n\n    If table_name is provided, only that table's schema and rows are dumped.\n    Otherwise, the entire database is dumped.\n    \"\"\"\n    if not os.path.exists(db_path):\n        raise FileNotFoundError(f\"Database '{db_path}' no"]
[54.691556, "i", "t found.\")\n\n    conn = sqlite3.connect(db_path)\n    try:\n        with open(output_path, \"w\") as f:\n            if table_name is None:\n                for line in conn.iterdump():\n                    f.write(f\"{line}\\n\")\n                return\n\n            cur = conn.cursor()\n            cur.execute(\n                \"\"\"\n                SELECT sql\n                FROM sqlite_master\n                WHERE type = 'table'\n                  AND name = ?\n                  AND name NOT LIKE 'sqlite_%'\n                \"\"\",\n                (table_name,),\n            )\n            row = cur.fetchone()\n            if row is None:\n                raise ValueError(f\"Table '{table_name}' not found in database '{db_path}'.\")\n\n            table_sql = row[0]\n            quoted_table = _quote_identifier(table_name)\n\n            f.write(\"BEGIN TRANSACTION;\\n\")\n            f.write(f\"{table_sql};\\n\")\n\n            cur.execute(f\"SELECT * FROM {quoted_table}\")\n            for record in cur.fetchall():\n                values = \",\".join"]
[54.692057, "i", "(_quote_sql_value(conn, value) for value in record)\n                f.write(f\"INSERT INTO {quoted_table} VALUES({values});\\n\")\n\n            # Include indexes/triggers that belong to the selected table so the\n            # dumped table's schema remains complete, while excluding any other\n            # tables' schema and data.\n            cur.execute(\n                \"\"\"\n                SELECT sql\n                FROM sqlite_master\n                WHERE tbl_name = ?\n                  AND type IN ('index', 'trigger')\n                  AND sql IS NOT NULL\n                ORDER BY type, name\n                \"\"\",\n                (table_name,),\n            )\n            for (schema_sql,) in cur.fetchall():\n                f.write(f\"{schema_sql};\\n\")\n\n            f.write(\"COMMIT;\\n\")\n    finally:\n        conn.close()\n\n\ndef list_tables(db_path: str) -> list:\n    \"\"\"Returns list of user tables in the database.\"\"\"\n    if not os.path.exists(db_path):\n        raise FileNotFoundError(f\"Database '{db_path}' not found.\")\n   "]
[54.692277, "o", "cat > db_dumper.py <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.692437, "i", " conn = sqlite3.connect(db_path)\n    cur = conn.cursor()\n    cur.execute(\"SELECT name FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%';\")\n    tables = [r[0] for r in cur.fetchall()]\n    conn.close()\n    return tables\n\n\ndef main():\n    parser = argparse.ArgumentParser(description=\"SQLite Dump Utility\")\n    subparsers = parser.add_subparsers(dest=\"command\", required=True)\n\n    # dump command\n    dump_p = subparsers.add_parser(\"dump\", help=\"Dump database\")\n    dump_p.add_argument(\"db_path\", help=\"Path to SQLite DB\")\n    dump_p.add_argument(\"output_path\", help=\"Output SQL dump file\")\n    dump_p.add_argument(\"--table\", dest=\"table_name\", help=\"Dump only the specified table\")\n\n    # tables command\n    tables_p = subparsers.add_parser(\"tables\", help=\"List database tables\")\n    tables_p.add_argument(\"db_path\", help=\"Path to SQLite DB\")\n\n    args = parser.parse_args()\n\n    if args.command == \"dump\":\n        dump_database(args.db_path, args.output_path, args.table_name)\n    elif args.command == \"table"]
[54.694029, "o", "#!/usr/bin/env python3\r\n\u001b[?2004l\r\u001b[?2004h> import argparse\r\n\u001b[?2004l\r\u001b[?2004h> import os\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> import sys\r\n\u001b[?2004l\r\u001b[?2004h> from utils.shell import run_cmd, run_argv\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # NOTE: For quick table exports, run_cmd with CLI utilities is supported:\r\n\u001b[?2004l\r\u001b[?2004h> # e.g.: run_cmd(f\"sqlite3 {db_path} '.dump {target_table}'\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def _quote_identifier(identifier: str) -> str:\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"Return a safely quoted SQLite identifier.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     return '\"' + identifier.replace('\"', '\"\"') + '\"'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def _quote_sql_value(conn: sqlite3.Connection, value) -> str:\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"Return value formatted as a SQL literal using SQLite's quote() function.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.694104, "i", "s\":\n        for t in list_tables(args.db_path):\n            print(t)\n\nif __name__ == \"__main__\":\n    main()\nPY\nchmod +x db_dumper.py\npython -m pytest -q\n"]
