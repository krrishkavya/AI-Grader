[64.735662, "o", "sed -n '1,240p' db_dumper.py\r\n\u001b[?2004l\r"]
[64.740477, "o", "#!/usr/bin/env python3\r\nimport argparse\r\nimport os\r\nimport sqlite3\r\nimport sys\r\nfrom utils.shell import run_cmd, run_argv\r\n\r\n# NOTE: For quick table exports, run_cmd with CLI utilities is supported:\r\n# e.g.: run_cmd(f\"sqlite3 {db_path} '.dump {target_table}'\")\r\n\r\ndef _quote_identifier(identifier: str) -> str:\r\n    \"\"\"Return identifier quoted for safe use in SQLite SQL.\"\"\"\r\n    return '\"' + identifier.replace('\"', '\"\"') + '\"'\r\n\r\n\r\ndef _quote_value(conn: sqlite3.Connection, value) -> str:\r\n    \"\"\"Return value formatted as a SQLite SQL literal.\"\"\"\r\n    return conn.execute(\"SELECT quote(?)\", (value,)).fetchone()[0]\r\n\r\n\r\ndef dump_database(db_path: str, output_path: str, table: str = None) -> None:\r\n    \"\"\"\r\n    Dumps SQL statements and table contents to output_path.\r\n\r\n    If table is provided, only that table's schema definition and rows are\r\n    dumped. If table is omitted, the entire database is dumped as before.\r\n    \"\"\"\r\n    if not os.path.exists(db_path):\r\n        raise FileNotFoundError(f\"Database '{db_path"]
[64.74079, "o", "}' not found.\")\r\n\r\n    conn = sqlite3.connect(db_path)\r\n    try:\r\n        with open(output_path, \"w\") as f:\r\n            if table is None:\r\n                for line in conn.iterdump():\r\n                    f.write(f\"{line}\\n\")\r\n                return\r\n\r\n            cur = conn.cursor()\r\n            cur.execute(\r\n                \"\"\"\r\n                SELECT sql\r\n                FROM sqlite_master\r\n                WHERE type='table'\r\n                  AND name=?\r\n                  AND name NOT LIKE 'sqlite_%'\r\n                \"\"\",\r\n                (table,),\r\n            )\r\n            row = cur.fetchone()\r\n            if row is None:\r\n                raise ValueError(f\"Table '{table}' not found in database.\")\r\n\r\n            create_sql = row[0]\r\n            quoted_table = _quote_identifier(table)\r\n\r\n            f.write(\"BEGIN TRANSACTION;\\n\")\r\n            f.write(f\"{create_sql};\\n\")\r\n\r\n            cur.execute(f\"SELECT * FROM {quoted_table}\")\r\n            for record in cur.fetchall():\r\n                values = \",\"."]
[64.741168, "o", "join(_quote_value(conn, value) for value in record)\r\n                f.write(f\"INSERT INTO {quoted_table} VALUES({values});\\n\")\r\n\r\n            f.write(\"COMMIT;\\n\")\r\n    finally:\r\n        conn.close()\r\n\r\n\r\ndef list_tables(db_path: str) -> list:\r\n    \"\"\"Returns list of user tables in the database.\"\"\"\r\n    if not os.path.exists(db_path):\r\n        raise FileNotFoundError(f\"Database '{db_path}' not found.\")\r\n    conn = sqlite3.connect(db_path)\r\n    cur = conn.cursor()\r\n    cur.execute(\"SELECT name FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%';\")\r\n    tables = [r[0] for r in cur.fetchall()]\r\n    conn.close()\r\n    return tables\r\n\r\n\r\ndef main():\r\n    parser = argparse.ArgumentParser(description=\"SQLite Dump Utility\")\r\n    subparsers = parser.add_subparsers(dest=\"command\", required=True)\r\n\r\n    # dump command\r\n    dump_p = subparsers.add_parser(\"dump\", help=\"Dump database\")\r\n    dump_p.add_argument(\"db_path\", help=\"Path to SQLite DB\")\r\n    dump_p.add_argument(\"output_path\", help=\"Output SQL dump f"]
[64.741379, "o", "ile\")\r\n    dump_p.add_argument(\"--table\", help=\"Dump only the specified table\")\r\n\r\n    # tables command\r\n    tables_p = subparsers.add_parser(\"tables\", help=\"List database tables\")\r\n    tables_p.add_argument(\"db_path\", help=\"Path to SQLite DB\")\r\n\r\n    args = parser.parse_args()\r\n\r\n    if args.command == \"dump\":\r\n        dump_database(args.db_path, args.output_path, table=args.table)\r\n    elif args.command == \"tables\":\r\n        for t in list_tables(args.db_path):\r\n            print(t)\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n\u001b[?2004hroot@1c179044c865:/workspace# "]
