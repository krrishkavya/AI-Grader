[23.977443, "i", " statements and table contents to output_path.\\n\\n    If table is provided, only that table\\'s schema and rows are dumped.\\n    Otherwise, the entire database is dumped.\\n    \"\"\"\\n    if not os.path.exists(db_path):\\n        raise FileNotFoundError(f\"Database \\'{db_path}\\' not found.\")\\n\\n    conn = sqlite3.connect(db_path)\\n    try:\\n        with open(output_path, \"w\") as f:\\n            if table is None:\\n                for line in conn.iterdump():\\n                    f.write(f\"{line}\\\\n\")\\n                return\\n\\n            cur = conn.cursor()\\n            cur.execute(\\n                \"SELECT sql FROM sqlite_master WHERE type=\\'table\\' AND name=? AND name NOT LIKE \\'sqlite_%\\'\",\\n                (table,),\\n            )\\n            row = cur.fetchone()\\n            if row is None:\\n                raise ValueError(f\"Table \\'{table}\\' not found in database.\")\\n\\n            create_sql = row[0]\\n            f.write(\"BEGIN TRANSACTION;\\\\n\")\\n            f.write(f\"{create_sql};\\\\n\")\\n\\n            quote"]
