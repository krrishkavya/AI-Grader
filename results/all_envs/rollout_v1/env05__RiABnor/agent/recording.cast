[79.293196, "i", "tmpdir=$(mktemp -d)\npython3 - \"$tmpdir/test.db\" <<'PY'\nimport sqlite3, sys\nconn = sqlite3.connect(sys.argv[1])\ncur = conn.cursor()\ncur.execute(\"CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT);\")\ncur.execute(\"INSERT INTO users (name) VALUES ('Alice'), ('Bob');\")\ncur.execute(\"CREATE TABLE products (id INTEGER PRIMARY KEY, item TEXT);\")\ncur.execute(\"INSERT INTO products (item) VALUES ('Widget');\")\nconn.commit()\nconn.close()\nPY\npython3 db_dumper.py dump \"$tmpdir/test.db\" \"$tmpdir/users.sql\" --table users\ncat \"$tmpdir/users.sql\"\n! grep -q products \"$tmpdir/users.sql\"\npython3 db_dumper.py dump \"$tmpdir/test.db\" \"$tmpdir/full.sql\"\ngrep -q users \"$tmpdir/full.sql\" && grep -q products \"$tmpdir/full.sql\"\npython3 - \"$tmpdir/users.sql\" \"$tmpdir/restored.db\" <<'PY'\nimport sqlite3, sys\nsql_path, db_path = sys.argv[1], sys.argv[2]\nconn = sqlite3.connect(db_path)\nconn.executescript(open(sql_path).read())\ncur = conn.cursor()\ncur.execute(\"SELECT name FROM sqlite_master WHERE type='table' ORDER BY name\")\nprint(cur.fetcha"]
[79.293264, "i", "ll())\ncur.execute(\"SELECT name FROM users ORDER BY id\")\nprint(cur.fetchall())\nconn.close()\nPY\nrm -rf \"$tmpdir\"\npython3 -m pytest -q\n"]
