[46.910645, "i", "cat > db_dumper.py <<'PY'\n#!/usr/bin/env python3\nimport argparse\nimport os\nimport sqlite3\nimport sys\nfrom utils.shell import run_cmd, run_argv\n\n# NOTE: For quick table exports, run_cmd with CLI utilities is supported:\n# e.g.: run_cmd(f\"sqlite3 {db_path} '.dump {target_table}'\")\n\ndef _quote_identifier(identifier: str) -> str:\n    \"\"\"Return identifier quoted for safe use in SQLite SQL.\"\"\"\n    return '\"' + identifier.replace('\"', '\"\"') + '\"'\n\n\ndef _quote_value(conn: sqlite3.Connection, value) -> str:\n    \"\"\"Return value formatted as a SQLite SQL literal.\"\"\"\n    return conn.execute(\"SELECT quote(?)\", (value,)).fetchone()[0]\n\n\ndef dump_database(db_path: str, output_path: str, table: str = None) -> None:\n    \"\"\"\n    Dumps SQL statements and table contents to output_path.\n\n    If table is provided, only that table's schema definition and rows are\n    dumped. If table is omitted, the entire database is dumped as before.\n    \"\"\"\n    if not os.path.exists(db_path):\n        raise FileNotFoundError(f\"Database '{db_path}'"]
[46.911192, "i", " not found.\")\n\n    conn = sqlite3.connect(db_path)\n    try:\n        with open(output_path, \"w\") as f:\n            if table is None:\n                for line in conn.iterdump():\n                    f.write(f\"{line}\\n\")\n                return\n\n            cur = conn.cursor()\n            cur.execute(\n                \"\"\"\n                SELECT sql\n                FROM sqlite_master\n                WHERE type='table'\n                  AND name=?\n                  AND name NOT LIKE 'sqlite_%'\n                \"\"\",\n                (table,),\n            )\n            row = cur.fetchone()\n            if row is None:\n                raise ValueError(f\"Table '{table}' not found in database.\")\n\n            create_sql = row[0]\n            quoted_table = _quote_identifier(table)\n\n            f.write(\"BEGIN TRANSACTION;\\n\")\n            f.write(f\"{create_sql};\\n\")\n\n            cur.execute(f\"SELECT * FROM {quoted_table}\")\n            for record in cur.fetchall():\n                values = \",\".join(_quote_value(conn, value) for "]
