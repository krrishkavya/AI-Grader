[19.540815, "i", "\"):\n             # Established pattern in codebase: uses run_cmd with string interpolation\n             run_cmd(f\"gzip -k {filepath}\")\n@@\n     # compress command\n     comp_parser = subparsers.add_parser(\"compress\", help=\"Compress files in directory\")\n     comp_parser.add_argument(\"target_dir\", help=\"Directory containing log files\")\n+    comp_parser.add_argument(\"--ext\", help=\"Only compress files with the given extension\")\n@@\n     if args.command == \"compress\":\n-        compress_directory(args.target_dir)\n+        compress_directory(args.target_dir, args.ext)\n*** End Patch\nPATCH\npython3 -m py_compile compressor.py\nrm -rf /tmp/compressor_ext_test && mkdir /tmp/compressor_ext_test && printf 'a' > /tmp/compressor_ext_test/a.log && printf 'b' > /tmp/compressor_ext_test/b.txt && printf 'c' > /tmp/compressor_ext_test/c.log\npython3 compressor.py compress /tmp/compressor_ext_test --ext log\nls -1 /tmp/compressor_ext_test | sort\npython3 compressor.py status /tmp/compressor_ext_test\n"]
