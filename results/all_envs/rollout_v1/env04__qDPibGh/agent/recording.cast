[19.228534, "i", "{content}\")', '    metadata = \"HEADER:TRANSCODED\\\\n\"\\n    if scale:\\n        metadata += f\"SCALE:{scale}\\\\n\"\\n\\n    with open(output_file, \"w\") as f_out:\\n        f_out.write(f\"{metadata}{content}\")')\ns = s.replace('    trans_p.add_argument(\"output_file\", help=\"Target media file\")', '    trans_p.add_argument(\"output_file\", help=\"Target media file\")\\n    trans_p.add_argument(\"--scale\", type=validate_scale, help=\"Scale output resolution as WIDTH:HEIGHT\")')\ns = s.replace('        transcode_file(args.input_file, args.output_file)', '        transcode_file(args.input_file, args.output_file, args.scale)')\np.write_text(s)\nPY\nsed -n '1,260p' transcoder.py\npytest -q\n"]
