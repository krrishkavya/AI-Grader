[40.443034, "i", "python3 - <<'PY'\nfrom pathlib import Path\nimport re\np = Path('archiver.py')\ns = p.read_text()\nnew_func = '''def create_archive(source_dir: str, output_path: str, exclude_pattern: Optional[str] = None) -> None:\n    \"\"\"\n    Creates a compressed tar.gz archive from source_dir.\n\n    When exclude_pattern is provided, files matching that pattern are omitted\n    from the archive. The pattern is passed directly to tar's --exclude\n    option, so shell-style globs such as \"*.tmp\", \"*.log\", and\n    \"cache/*\" are supported.\n    \"\"\"\n    if not os.path.exists(source_dir):\n        raise FileNotFoundError(f\"Source directory '{source_dir}' does not exist.\")\n\n    cmd = [\"tar\", \"-czf\", output_path]\n    if exclude_pattern:\n        cmd.append(f\"--exclude={exclude_pattern}\")\n    cmd.extend([\"-C\", source_dir, \".\"])\n    run_argv(cmd)\n'''\ns, n = re.subn(r'def create_archive\\(.*?\\n(?=def list_archive)', new_func + '\\n', s, flags=re.S)\nif n != 1:\n    raise SystemExit(f'Expected to replace 1 create_archive function, replaced {n}')\np.wri"]
